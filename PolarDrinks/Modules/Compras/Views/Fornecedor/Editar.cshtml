@model FornecedorModel
@{
    ViewData["Title"] = "Editar Fornecedor";
}

<div class="tema-dark">
    <div class="container-fluid px-3 px-lg-4 py-4" style="max-width:1400px;">

        <div class="bg-shadow text-light p-4 rounded-4 mb-3 d-flex align-items-center gap-3">
            <div class="sf-icon-badge" style="background:linear-gradient(135deg,#f59e0b,#d97706); box-shadow:0 8px 20px -8px rgba(245,158,11,.8);">
                <i class="bi bi-pencil-square fs-4 text-white"></i>
            </div>
            <div>
                <h1 class="m-0 fs-3 fw-bold">Editar Fornecedor</h1>
            </div>
        </div>

        <div class="bg-shadow text-light p-4 rounded-4">
            @if (TempData["MensagemSucesso"] != null)
            {
                <div class="bg-shadow text-light p-3 rounded-4 mb-3" style="background:rgba(16,185,129,.15) !important; border-left:3px solid #10b981 !important;">
                    <i class="bi bi-check-circle-fill me-2" style="color:#34d399;"></i>
                    @TempData["MensagemSucesso"]
                </div>
            }
            else if (TempData["MensagemErro"] != null)
            {
                <div class="bg-shadow text-light p-3 rounded-4 mb-3" style="background:rgba(239,68,68,.15) !important; border-left:3px solid #ef4444 !important;">
                    <i class="bi bi-exclamation-circle-fill me-2" style="color:#f87171;"></i>
                    @TempData["MensagemErro"]
                </div>
            }

            <form method="post" asp-action="Editar">
                <input type="hidden" asp-for="FornecedorID" />

                <div class="mb-4">
                    <label class="form-label text-light">Nome</label>
                    <input type="text" class="form-control bg-shadow text-light" asp-for="FornecedorNome" maxlength="50">
                    <span asp-validation-for="FornecedorNome" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label class="form-label text-light">CNPJ</label>
                    <input type="text" id="FornecedorCNPJ" class="form-control bg-shadow text-light" asp-for="FornecedorCNPJ" maxlength="18">
                    <span asp-validation-for="FornecedorCNPJ" class="text-danger"></span>
                </div>

                <div class="row mb-4">
                    <div class="col-md-6">
                        <label class="form-label text-light">Telefone</label>
                        <input type="text" id="FornecedorTelefone" class="form-control bg-shadow text-light" asp-for="FornecedorTelefone" maxlength="15">
                        <span asp-validation-for="FornecedorTelefone" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-light">E-mail</label>
                        <input type="email" class="form-control bg-shadow text-light" asp-for="FornecedorEmail" maxlength="50">
                        <span asp-validation-for="FornecedorEmail" class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-4">
                        <label class="form-label text-light">CEP</label>
                        <div class="input-group">
                            <input type="text" id="FornecedorCEP" class="form-control bg-shadow text-light" asp-for="FornecedorCEP" maxlength="9">
                            <button type="button" id="btnBuscarCEP" class="btn btn-secondary" title="Buscar CEP">Buscar</button>
                        </div>
                        <span asp-validation-for="FornecedorCEP" class="text-danger"></span>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label text-light">Estado</label>
                        <input type="text" id="FornecedorEstado" class="form-control bg-shadowi text-white" readonly asp-for="FornecedorEstado">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-light">Cidade</label>
                        <input type="text" id="FornecedorCidade" class="form-control bg-shadowi text-white" readonly asp-for="FornecedorCidade">
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-6">
                        <label class="form-label text-light">Logradouro</label>
                        <input type="text" id="FornecedorLogradouro" class="form-control bg-shadowi text-white" asp-for="FornecedorLogradouro" readonly>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label text-light">Bairro</label>
                        <input type="text" id="FornecedorBairro" class="form-control bg-shadowi text-white" readonly asp-for="FornecedorBairro">
                    </div>
                    <div class="col-md-2">
                        <label class="form-label text-light">Número</label>
                        <input type="text" class="form-control bg-shadow text-light" asp-for="FornecedorNum" maxlength="10">
                        <span asp-validation-for="FornecedorNum" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" asp-for="FornecedorAtivo">
                        <label class="form-check-label text-light">Fornecedor disponível</label>
                    </div>
                </div>

                <div class="d-flex gap-3 mt-4">
                    <a class="btn btn-outline-light w-50" asp-action="Index" title="Voltar">
                        <i class="bi bi-arrow-left me-1"></i>Voltar
                    </a>
                    <button type="submit" class="btn btn-success w-50" title="Salvar">
                        <i class="bi bi-check-lg me-1"></i>Salvar
                    </button>
                </div>
            </form>
        </div>

    </div>
</div>

@section Scripts {
<script>
    $("#btnBuscarCEP").click(function(){
        var cep = $("#FornecedorCEP").val().replace(/\D/g, '');

        if(cep.length !== 8){
            alert("CEP inválido!");
            return;
        }

        $.getJSON(`https://viacep.com.br/ws/${cep}/json/`, function(dados){
            if(!("erro" in dados)){
                $("#FornecedorLogradouro").val(dados.logradouro);
                $("#FornecedorBairro").val(dados.bairro);
                $("#FornecedorCidade").val(dados.localidade);
                $("#FornecedorEstado").val(dados.uf);
            } else {
                alert("CEP não encontrado.");
            }
        });
    });
</script>
}

