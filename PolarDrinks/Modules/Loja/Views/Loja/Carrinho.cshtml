
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Polar Drinks - Meu Carrinho</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/loja.css" />
</head>
<body>

    @Html.Partial("_HeaderLoja")

    <main class="carrinho-container">

        <div class="carrinho-topo">
            <h1><i class="bi bi-cart3"></i> Meu Carrinho</h1>
            <p>Revise seus produtos antes de finalizar o pedido.</p>
        </div>

        <div id="mensagemAviso" style="display:none;"></div>

        <div id="carrinhoVazio" style="display:none;">
            <div class="icone-vazio">
                <i class="bi bi-cart-x"></i>
            </div>

            <h3>Seu carrinho está vazio</h3>
            <p>Adicione alguns produtos para começar seu pedido.</p>

            <a href="/loja/catalogo">
                <i class="bi bi-bag"></i> Ver produtos
            </a>
        </div>

        <div id="carrinhoConteudo" style="display:none;">

            <div id="listaItensCarrinho" class="lista-carrinho-box">
                <!-- preenchido via JavaScript -->
            </div>

            <div class="resumo-carrinho">

                <h3>
                    <i class="bi bi-receipt"></i> Resumo do pedido
                </h3>

                <div class="resumo-total">
                    <span>Total</span>
                    <strong id="totalCarrinho">R$ 0,00</strong>
                </div>

                <div class="titulo-pagamento">
                    Forma de pagamento
                </div>

                <div class="pagamentos">
                    <button class="btn-pagamento" data-tipo="Cartao">
                        <i class="bi bi-credit-card"></i> Cartão
                    </button>

                    <button class="btn-pagamento" data-tipo="Pix">
                        <i class="bi bi-qr-code"></i> Pix
                    </button>
                </div>

                <button id="btnFinalizarCompra" disabled>
                    Finalizar Compra <i class="bi bi-arrow-right"></i>
                </button>

                <button id="btnLimparCarrinho" class="mt-2">
                    <i class="bi bi-trash3"></i> Excluir Carrinho
                </button>

            </div>
        </div>
    </main>

    <script src="~/js/loja/loja-api.js"></script>
    <script src="~/js/loja/loja-header.js"></script>
    <script src="~/js/loja/loja-carrinho.js"></script>

</body>
</html>

