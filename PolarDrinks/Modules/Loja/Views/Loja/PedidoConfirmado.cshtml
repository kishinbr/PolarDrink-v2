@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Polar Drinks - Pedido Confirmado</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="stylesheet" href="~/css/loja.css" />
</head>
<body>

    @Html.Partial("_HeaderLoja")

    <main class="pedido-container">
        <div class="pedido-card">

            <div class="pedido-sucesso">
                <div class="icone-sucesso">
                    <i class="bi bi-check-lg"></i>
                </div>

                <h1>Pedido Confirmado!</h1>
                <p>Seu pedido foi realizado com sucesso.</p>
            </div>

            <div id="conteudoPedido">
                <div class="text-center py-4">
                    <div class="spinner-border" style="color:var(--azul);"></div>
                    <p class="mt-3" style="color:var(--texto-fraco);">
                        Carregando os detalhes do pedido...
                    </p>
                </div>
            </div>

        </div>
    </main>

    <script src="~/js/loja/loja-api.js"></script>
    <script src="~/js/loja/loja-header.js"></script>
    <script src="~/js/loja/loja-pedido-confirmado.js"></script>

</body>
</html>