@*
    Layout único da loja online: cabeçalho, rodapé, fontes e scripts compartilhados.
    Cada página define ViewData["Title"] e coloca o próprio script na seção "Scripts".
*@
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} | Polar Drinks" : "Polar Drinks")</title>
    <link rel="icon" type="image/png" href="~/img/polaria.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@800;900&family=Poppins:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/loja.css" asp-append-version="true" />
</head>
<body>

    @await Html.PartialAsync("_HeaderLoja")

    <main>
        @RenderBody()
    </main>

    @await Html.PartialAsync("_FooterLoja")

    <script src="~/js/loja/loja-api.js" asp-append-version="true"></script>
    <script src="~/js/loja/loja-header.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
