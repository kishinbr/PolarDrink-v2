@* Rodapé da loja *@

<footer class="loja-rodape">
    <div class="container-loja">
        <div class="rodape-grade">

            <div class="rodape-marca">
                <a href="/loja/catalogo" class="logo-loja">
                    <img src="~/img/polaria.png" alt="" />
                    <span>polar<strong>drinks</strong></span>
                </a>
                <p>Bebidas para deixar sua festa completa e gelada. Peça online e retire na loja com o seu código.</p>
            </div>

            <div>
                <p class="rodape-titulo">Formas de pagamento</p>
                <div class="formas-pagamento">
                    <span><i class="bi bi-qr-code"></i> Pix</span>
                    <span><i class="bi bi-credit-card"></i> Cartão</span>
                </div>
            </div>

            <div>
                <p class="rodape-titulo">Sua conta</p>
                <ul class="rodape-links">
                    <li><a href="/loja/catalogo">Produtos</a></li>
                    <li><a href="/loja/carrinho">Meu carrinho</a></li>
                    <li><a href="/loja/perfil">Meus pedidos</a></li>
                </ul>
            </div>

        </div>

        <div class="rodape-base">
            © @DateTime.Now.Year Polar Drinks · Todos os direitos reservados
        </div>
    </div>
</footer>
