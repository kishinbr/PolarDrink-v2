@*
    Mensagens de sucesso e de erro das telas da equipe.
    Lê TempData["MensagemSucesso"], TempData["MensagemErro"] e ViewBag.Erro.
    A de sucesso some sozinha depois de alguns segundos (classe msg-auto, tratada no site.js).
*@
@{
    var sucesso = TempData["MensagemSucesso"] as string;
    var erro = TempData["MensagemErro"] as string ?? ViewBag.Erro as string;
}

@if (!string.IsNullOrEmpty(sucesso))
{
    <div class="aviso aviso-sucesso msg-auto" role="alert">
        <i class="bi bi-check-circle-fill"></i>
        <span>@sucesso</span>
    </div>
}

@if (!string.IsNullOrEmpty(erro))
{
    <div class="aviso aviso-erro" role="alert">
        <i class="bi bi-exclamation-circle-fill"></i>
        <span>@erro</span>
    </div>
}
