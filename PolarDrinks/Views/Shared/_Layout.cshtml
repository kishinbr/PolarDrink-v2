@*
    Layout único das telas da equipe (Admin e Funcionário).
    O menu mostra a cada perfil só o que ele pode acessar; quem garante a permissão de verdade
    continua sendo o servidor ([AuthFilter] e [AdminFilter] nos controllers).
    Visual: wwwroot/css/admin.css. Menu no celular: wwwroot/js/admin.js.
*@
@{
    var ehAdmin = Context.Session.GetString("Perfil") == "Admin";
    var nome = Context.Session.GetString("Nome") ?? "";
    var partesNome = nome.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var iniciais = string.Concat(partesNome.Take(2).Select(p => char.ToUpper(p[0])));
    var titulo = ViewData["Title"]?.ToString() ?? "Polar Drinks";

    var controllerAtual = ViewContext.RouteData.Values["controller"]?.ToString();
    var acaoAtual = ViewContext.RouteData.Values["action"]?.ToString();

    // Marca o item do menu da tela aberta. Sem ações: vale qualquer ação daquele controller.
    string Ativo(string controller, params string[] acoes)
    {
        var mesmoController = string.Equals(controllerAtual, controller, StringComparison.OrdinalIgnoreCase);
        var mesmaAcao = acoes.Length == 0 || acoes.Any(a => string.Equals(acaoAtual, a, StringComparison.OrdinalIgnoreCase));
        return mesmoController && mesmaAcao ? "item-menu ativo" : "item-menu";
    }
}
<!DOCTYPE html>
<html lang="pt-br" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@titulo | Polar Drinks</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link href="https://cdn.datatables.net/v/dt/dt-2.3.7/datatables.min.css" rel="stylesheet">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@800;900&family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <link rel="icon" href="~/img/icon.png" type="image/x-icon" />
    <link rel="stylesheet" href="~/css/dash1.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="text-light">

    <aside class="admin-menu" aria-label="Menu">
        <a asp-controller="Home" asp-action="Index" class="admin-logo">
            <img src="~/img/polaria.png" alt="" />
            <span>Polar <strong>Drinks</strong></span>
        </a>

        <div class="admin-usuario">
            <div class="admin-avatar">@iniciais</div>
            <div>
                <b>@nome</b>
                <small>@(ehAdmin ? "Administrador" : "Funcionário")</small>
            </div>
        </div>

        <nav>
            <div class="secao-menu">Gestão</div>
            <a asp-controller="Home" asp-action="Index" class="@(Ativo("Home"))">
                <i class="bi bi-house"></i> Início
            </a>
            @if (ehAdmin)
            {
                <a asp-controller="Dashboard" asp-action="Index" class="@(Ativo("Dashboard"))">
                    <i class="bi bi-graph-up"></i> Dashboard
                </a>
            }

            <div class="secao-menu">Estoque</div>
            <a asp-controller="Estoque" asp-action="Index" class="@(Ativo("Estoque", "Index", "Cadastrar", "Editar"))">
                <i class="bi bi-box-seam"></i> Produtos
            </a>
            @if (ehAdmin)
            {
                <a asp-controller="Categoria" asp-action="Index" class="@(Ativo("Categoria"))">
                    <i class="bi bi-tags"></i> Categorias
                </a>
                <a asp-controller="Estoque" asp-action="Movimentacoes" class="@(Ativo("Estoque", "Movimentacoes"))">
                    <i class="bi bi-arrow-left-right"></i> Movimentações
                </a>
            }

            <div class="secao-menu">Vendas</div>
            <a asp-controller="Venda" asp-action="Cadastrar" class="@(Ativo("Venda", "Cadastrar", "FinalizarVenda"))">
                <i class="bi bi-cart-check"></i> Nova venda
            </a>
            <a asp-controller="PedidoOnline" asp-action="Index" class="@(Ativo("PedidoOnline"))">
                <i class="bi bi-bag-check"></i> Pedidos online
                <span id="contadorPedidos" class="contador-menu" hidden></span>
            </a>
            @if (ehAdmin)
            {
                <a asp-controller="Venda" asp-action="Index" class="@(Ativo("Venda", "Index", "Detalhes", "Cancelar"))">
                    <i class="bi bi-receipt"></i> Histórico
                </a>
            }

            <div class="secao-menu">Fornecedores</div>
            <a asp-controller="Fornecedor" asp-action="Index" class="@(Ativo("Fornecedor"))">
                <i class="bi bi-truck"></i> Fornecedores
            </a>
            @if (ehAdmin)
            {
                <a asp-controller="CompraEstoque" asp-action="Index" class="@(Ativo("CompraEstoque"))">
                    <i class="bi bi-box-arrow-in-down"></i> Reabastecer
                </a>
            }

            <div class="secao-menu">Acessibilidade</div>
            <a href="javascript:void(0)" onclick="toggleLibras()" id="btnLibras" class="item-menu">
                <i class="bi bi-universal-access"></i> Ativar LIBRAS
            </a>

            <div class="secao-menu">Acesso</div>
            <a asp-controller="Loja" asp-action="Catalogo" target="_blank" rel="noopener" class="item-menu">
                <i class="bi bi-shop"></i> Ver loja online
                <i class="bi bi-box-arrow-up-right ms-auto small"></i>
            </a>
            @if (ehAdmin)
            {
                <a asp-controller="Usuario" asp-action="Index" class="@(Ativo("Usuario"))">
                    <i class="bi bi-people"></i> Usuários
                </a>
            }
            <a asp-controller="Auth" asp-action="Deslogar" class="item-menu">
                <i class="bi bi-box-arrow-right"></i> Sair
            </a>
        </nav>
    </aside>

    <div id="fundoMenu" class="admin-fundo-menu"></div>

    <div class="admin-principal">
        <header class="admin-topo">
            <button type="button" id="btnAbrirMenu" class="admin-icone admin-botao-menu" aria-label="Abrir menu">
                <i class="bi bi-list"></i>
            </button>

            <span class="admin-topo-titulo">@titulo</span>

            <a asp-controller="Home" asp-action="Index" class="admin-logo admin-logo-topo">
                <img src="~/img/polaria.png" alt="" />
                <span>Polar <strong>Drinks</strong></span>
            </a>
        </header>

        <!-- onde as views são renderizadas -->
        <main class="admin-conteudo">
            @RenderBody()
        </main>
    </div>

    <partial name="_VLibras" />

    <!-- SCRIPTS -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/admin.js" asp-append-version="true"></script>
    <script src="https://cdn.datatables.net/v/dt/dt-2.3.7/datatables.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
