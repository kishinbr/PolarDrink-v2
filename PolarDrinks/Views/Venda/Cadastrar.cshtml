@model PolarDrinks.Models.VendaModel
@{
    ViewData["Title"] = "Vendas";
}

<div class="container bg-shadow p-4 rounded-4 mt-4 mb-4 shadow-lg">

    @if (TempData["MensagemSucesso"] != null)
    {
        <div class="alert bg-success text-light">
            @TempData["MensagemSucesso"]
        </div>
    }
    else if (TempData["MensagemErro"] != null)
    {
        <div class="alert bg-danger text-light">
            @TempData["MensagemErro"]
        </div>
    }

    <h2 class="text-light text-center mb-3">Vendas</h2>

    <form asp-action="FinalizarVenda" method="post" id="formVenda" class="row g-3">

        <!-- BUSCA -->
        <div class="col-12">
            <label class="form-label text-light">Buscar Produto</label>
            <div class="position-relative">
                <input type="text" id="buscaProduto" class="form-control bg-shadow text-light" placeholder="Código ou nome" autocomplete="off">
                <div id="listaSugestoes" class="list-group position-absolute w-100" style="z-index:1000;"></div>
            </div>
        </div>

        <!-- LADO ESQUERDO -->
        <div class="col-lg-4 d-flex flex-column">

            <div class="bg-shadow p-3 rounded-3 mb-3">

                <div class="mb-2">
                    <label class="form-label text-light">Quantidade</label>
                    <input type="text" id="quantidade" class="form-control bg-shadow text-light" value="0" maxlength="4">
                </div>

                <div class="mb-2">
                    <label class="form-label text-light">Valor Unitário</label>
                    <input type="text" id="valorUnitario" class="form-control bg-shadowi text-light" readonly>
                </div>

                <div class="mb-2">
                    <label class="form-label text-light">Total</label>
                    <input type="text" id="valorTotal" class="form-control bg-shadowi text-light" readonly>
                </div>

                <button type="button" id="btnAdicionar"
                        class="btn btn-success w-100 mt-2 "
                        style="height:60px; font-size:18px; " title="Adicionar Produto" >
                    Adicionar Produto
                </button>

                <hr class="text-light">

                <!-- PAGAMENTO -->
                <label class="form-label text-light fw-bold">Tipo de Pagamento</label>

                <div class="form-check">
                    <input class="form-check-input" type="radio" name="VendaTipoPagamento" id="pagDinheiro" value="Dinheiro">
                    <label class="form-check-label text-light" for="pagDinheiro">Dinheiro</label>
                </div>

                <div class="form-check">
                    <input class="form-check-input" type="radio" name="VendaTipoPagamento" id="pagPix" value="Pix">
                    <label class="form-check-label text-light" for="pagPix">Pix</label>
                </div>

                <div class="form-check">
                    <input class="form-check-input" type="radio" name="VendaTipoPagamento" id="pagCartao" value="Cartão">
                    <label class="form-check-label text-light" for="pagCartao">Cartão</label>
                </div>

            </div>

            <!-- TOTAL FIXO -->
            <div class="bg-shadowi p-3 rounded-3 text-center mt-auto">
                <h3 class="text-light m-0">
                   Valor Total: <span id="totalVenda">R$ 0.00</span>
                </h3>
            </div>

        </div>

        <!-- LADO DIREITO -->
        <div class="col-lg-8 d-flex flex-column ">

            <!-- TABELA COM SCROLL -->
            <div class="bg-shadow rounded-3 p-2 flex-grow-1 overflow-auto" style="min-height:300px; max-height:60vh;">
                <table class="table bg-secondary table-hover mb-0">
                    <thead class="bg-tpreto">
                        <tr>
                            <th>Produto</th>
                            <th class="text-end">Qtd</th>
                            <th class="text-end">Unitário</th>
                            <th class="text-end">Total</th>
                            <th class="text-center">Ações</th>
                        </tr>
                    </thead>
                    <tbody id="tabelaItens"></tbody>
                </table>
            </div>

            <!-- BOTÃO CONFIRMAR -->
            <div class="mt-3">
                <button id="btnConfirmar" type="submit" class="btn btn-success w-100" disabled title="Confirmar Venda">
                    Confirmar Venda
                </button>
            </div>

        </div>

        <div id="itensHidden"></div>

    </form>
</div>

@section Scripts {
    <script>
        const produtos = @Html.Raw(Json.Serialize(ViewBag.Produtos));
    </script>

    <script src="~/js/vendas.js"></script>
}
