@model PolarDrinks.Models.VendaModel
@{
    ViewData["Title"] = "Cancelar Venda";
}

<div class="tema-dark">
    <div class="container-fluid px-3 px-lg-4 py-4" style="max-width: 1400px;">

        <div class="bg-shadow text-light p-4 rounded-4 mb-3 d-flex align-items-center gap-3">
            <div class="sf-icon-badge" style="background: linear-gradient(135deg,#ef4444,#dc2626); box-shadow: 0 8px 20px -8px rgba(239,68,68,.8);">
                <i class="bi bi-x-circle-fill fs-4 text-white"></i>
            </div>
            <div>
                <h1 class="m-0 fs-3 fw-bold">Cancelar Venda #@Model.VendaID</h1>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-12 col-lg-4">
                <div class="bg-shadow text-light p-4 rounded-4 h-100">
                    <h5 class="fw-bold mb-3">
                        <i class="bi bi-info-circle me-2"></i>Informações da Venda
                    </h5>

                    <div class="mb-2">
                        <span class="text-secondary">Cadastrado por</span><br />
                        <strong>@Model.Usuario?.UsuarioNome</strong>
                    </div>

                    <div class="mb-2">
                        <span class="text-secondary">Data</span><br />
                        <strong>@Model.VendaData.ToString("dd/MM/yyyy")</strong>
                    </div>

                    <div class="mb-2">
                        <span class="text-secondary">Hora</span><br />
                        <strong>@Model.VendaData.ToString("HH:mm")</strong>
                    </div>

                    <div>
                        <span class="text-secondary">Pagamento</span><br />
                        <strong>@Model.VendaTipoPagamento</strong>
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-8">
                <div class="bg-shadow text-light p-3 rounded-4 h-100">
                    <h5 class="fw-bold px-2 pt-2 mb-3">
                        <i class="bi bi-cart-check me-2"></i>Produtos da Venda
                    </h5>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 text-light">
                            <thead class="bg-tpreto text-secondary sf-thead">
                                <tr>
                                    <th>Produto</th>
                                    <th>Qtd</th>
                                    <th class="text-end">Unitário</th>
                                    <th class="text-end">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Itens)
                                {
                                    <tr>
                                        <td>@item.Produto?.ProdutoNome</td>
                                        <td>@item.ItemVendaQtd</td>
                                        <td class="text-end">@("R" + item.ItemVendaPreco.ToString("C"))</td>
                                        <td class="text-end">@("R" + item.ItemVendaTotal.ToString("C"))</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="text-end text-light border-top border-secondary mt-3 pt-3">
                        <span class="text-secondary">Total da venda</span>
                        <h4 class="fw-bold sf-num mb-0">@("R" + Model.VendaValorTotal.ToString("C"))</h4>
                    </div>
                </div>
            </div>
        </div>

        @if (!Model.VendaCancelada)
        {
            <form asp-action="CancelarVenda" asp-route-id="@Model.VendaID" method="post" class="bg-shadow text-light p-4 rounded-4 mt-3" autocomplete="off">
                <h5 class="fw-bold mb-3">
                    <i class="bi bi-exclamation-triangle me-2" style="color:#fbbf24;"></i>Motivo do Cancelamento
                </h5>

                <div class="mb-3">
                    <label class="form-label text-light">Motivo do cancelamento</label>
                    <input type="text" name="descricao" class="form-control bg-shadow text-light" maxlength="50" placeholder="Ex: Devolução, erro na venda..." required />
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-light">
                        <i class="bi bi-arrow-left me-1"></i>Voltar
                    </a>
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-x-circle me-1"></i>Cancelar Venda
                    </button>
                </div>
            </form>
        }
        else
        {
            <div class="bg-shadow text-light p-3 rounded-4 mt-3" style="border-left: 3px solid #ef4444 !important;">
                <div class="fw-bold" style="color:#f87171;">
                    <i class="bi bi-x-circle-fill me-1"></i> Esta venda já está cancelada.
                </div>
                <div class="mt-3">
                    <a asp-action="Index" class="btn btn-outline-light">
                        <i class="bi bi-arrow-left me-1"></i>Voltar
                    </a>
                </div>
            </div>
        }

    </div>
</div>

