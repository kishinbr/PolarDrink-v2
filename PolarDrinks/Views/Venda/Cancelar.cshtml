@model PolarDrinks.Models.VendaModel
@{
    ViewData["Title"] = "Cancelar Venda";
}

<div class="container bg-shadow p-4 rounded-4 p-5 mt-5">

    <h2 class="text-danger mb-4">
        Cancelar Venda #@Model.VendaID
    </h2>

    <div class="text-light mb-3">
        <strong>Cadastrado por:</strong> @Model.Usuario?.UsuarioNome <br />
        <strong>Data:</strong> @Model.VendaData.ToString("dd/MM/yyyy") <br />
        <strong>Hora:</strong> @Model.VendaData.ToString("HH:mm") <br />
        <strong>Pagamento:</strong> @Model.VendaTipoPagamento <br />
    </div>

    <table class="table bg-shadowt table-hover">
        <thead class="bg-tpreto">
            <tr>
                <th>Produto</th>
                <th>Qtd</th>
                <th class="text-end">Unitário</th>
                <th class="text-end">Total</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model.Itens)
            {
                <tr>
                    <td>@item.Produto?.ProdutoNome</td>
                    <td>@item.ItemVendaQtd</td>
                    <td class="text-end">@("R" + item.ItemVendaPreco.ToString("C"))</td>
                    <td class="text-end">@("R" + item.ItemVendaTotal.ToString("C"))</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="text-end text-light">
        <h4>Total: @("R" + @Model.VendaValorTotal.ToString("C"))</h4>
    </div>

    @if (!Model.VendaCancelada)
    {
        <form asp-action="CancelarVenda" asp-route-id="@Model.VendaID" method="post" class="mt-4" autocomplete="off">
            
            <div class="mb-3">
                <label class="form-label text-light">Motivo do cancelamento</label>
                <input type="text" name="descricao" class="form-control bg-shadow text-light"
                       maxlength="50" placeholder="Ex: Devolução, erro na venda..." required />
            </div>

            <div class="d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-primary">Voltar</a>
                <button type="submit" class="btn btn-danger">Cancelar Venda</button>
            </div>

        </form>
    }
    else
    {
        <div class="d-flex justify-content-between mt-4">
            <a asp-action="Index" class="btn btn-primary">Voltar</a>
        </div>
    }

</div>