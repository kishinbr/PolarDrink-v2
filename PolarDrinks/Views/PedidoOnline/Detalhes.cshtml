@model PolarDrinks.Models.Loja.PedidoModel
@{
    ViewData["Title"] = "Detalhes do Pedido Online";
}

<div class="container bg-shadow p-4 rounded-4 p-5 mt-5">

    <h2 class="text-light mb-4">
        Detalhes do Pedido #@Model.PedidoID (Código: @Model.PedidoCodigo)
    </h2>

    @if (Model.PedidoStatus == PolarDrinks.Models.Loja.PedidoModel.Status.CanceladoCliente ||
         Model.PedidoStatus == PolarDrinks.Models.Loja.PedidoModel.Status.CanceladoNaoRetirado ||
         Model.PedidoStatus == PolarDrinks.Models.Loja.PedidoModel.Status.CanceladoAdmin)
    {
        <div class="bg-dark text-danger rounded-3 p-3 mb-3 text-center">
            <div class="fw-bold fs-5 mb-2">
                PEDIDO CANCELADO
                @if (Model.PedidoStatus == PolarDrinks.Models.Loja.PedidoModel.Status.CanceladoCliente)
                {
                    <span>(pelo Cliente)</span>
                }
                else if (Model.PedidoStatus == PolarDrinks.Models.Loja.PedidoModel.Status.CanceladoNaoRetirado)
                {
                    <span>(Não Retirado / Expirado)</span>
                }
                else
                {
                    <span>(pelo Admin)</span>
                }
            </div>
        </div>
    }

    <div class="text-light mb-3">
        <strong>Cliente:</strong> @Model.Cliente?.ClienteNome <br />
        <strong>Telefone:</strong> @Model.Cliente?.ClienteTelefone <br />
        <hr />
        <strong>Data da Compra:</strong> @Model.PedidoData.ToString("dd/MM/yyyy HH:mm") <br />
        <strong>Data da Separação:</strong> @(Model.PedidoDataSeparado?.ToString("dd/MM/yyyy HH:mm") ?? "-") <br />
        <strong>Separado por:</strong> @(Model.UsuarioSeparou?.UsuarioNome ?? "-") <br />
        <strong>Data da Entrega:</strong> @(Model.PedidoDataConcluido?.ToString("dd/MM/yyyy HH:mm") ?? "-") <br />
        <strong>Confirmado por:</strong> @(Model.UsuarioEntregou?.UsuarioNome ?? "-") <br />
    </div>

    <table class="table bg-shadowt table-hover">
        <thead class="bg-tpreto">
            <tr>
                <th>Produto</th>
                <th>Qtd</th>
                <th class="text-end">Unitário</th>
                <th class="text-end">Total</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model.Itens)
            {
                <tr>
                    <td>@item.Produto?.ProdutoNome</td>
                    <td>@item.ItemPedidoQtd</td>
                    <td class="text-end">@("R" + item.ItemPedidoPreco.ToString("C"))</td>
                    <td class="text-end">@("R" + (item.ItemPedidoPreco * item.ItemPedidoQtd).ToString("C"))</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="text-end text-light">
        <h4>Total: @("R" + Model.PedidoValorTotal.ToString("C"))</h4>
    </div>

    <div class="d-flex mt-3">
        <a asp-action="Historico" class="btn btn-primary">
            Voltar
        </a>
    </div>

</div>