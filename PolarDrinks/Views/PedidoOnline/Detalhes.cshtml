@model PolarDrinks.Models.Loja.PedidoModel
@{
    ViewData["Title"] = "Detalhes do Pedido Online";
}

<div class="tema-dark">
    <div class="container-fluid px-3 px-lg-4 py-4" style="max-width: 1400px;">

        <div class="bg-shadow text-light p-4 rounded-4 mb-3 d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="sf-icon-badge" style="background: linear-gradient(135deg,#3b82f6,#6366f1); box-shadow: 0 8px 20px -8px rgba(59,130,246,.8);">
                    <i class="bi bi-receipt-cutoff fs-4 text-white"></i>
                </div>
                <div>
                    <h1 class="m-0 fs-3 fw-bold">Detalhes do Pedido #@Model.PedidoID</h1>
                    <small class="text-secondary">Código: @Model.PedidoCodigo</small>
                </div>
            </div>
        </div>

        @if (Model.PedidoStatus == PolarDrinks.Models.Loja.PedidoModel.Status.CanceladoCliente ||
             Model.PedidoStatus == PolarDrinks.Models.Loja.PedidoModel.Status.CanceladoNaoRetirado ||
             Model.PedidoStatus == PolarDrinks.Models.Loja.PedidoModel.Status.CanceladoAdmin)
        {
            <div class="bg-shadow p-3 rounded-4 mb-3 text-center" style="border-left: 3px solid #ef4444 !important;">
                <div class="fw-bold fs-5" style="color:#f87171;">
                    <i class="bi bi-x-circle-fill me-2"></i>
                    PEDIDO CANCELADO
                    @if (Model.PedidoStatus == PolarDrinks.Models.Loja.PedidoModel.Status.CanceladoCliente)
                    {
                        <span>(pelo Cliente)</span>
                    }
                    else if (Model.PedidoStatus == PolarDrinks.Models.Loja.PedidoModel.Status.CanceladoNaoRetirado)
                    {
                        <span>(Não Retirado / Expirado)</span>
                    }
                    else
                    {
                        <span>(pelo Admin)</span>
                    }
                </div>
            </div>
        }

        <div class="row g-3">
            <div class="col-12 col-lg-5">
                <div class="bg-shadow text-light p-4 rounded-4 h-100">
                    <h5 class="fw-bold mb-4">
                        <i class="bi bi-person-vcard me-2"></i>
                        Informações do Pedido
                    </h5>

                    <div class="mb-3">
                        <div class="text-secondary small">Cliente</div>
                        <div class="fw-semibold">@Model.Cliente?.ClienteNome</div>
                    </div>

                    <div class="mb-3">
                        <div class="text-secondary small">Telefone</div>
                        <div class="fw-semibold">@Model.Cliente?.ClienteTelefone</div>
                    </div>

                    <hr class="border-secondary">

                    <div class="mb-3">
                        <div class="text-secondary small">Data da Compra</div>
                        <div class="sf-num">@Model.PedidoData.ToString("dd/MM/yyyy HH:mm")</div>
                    </div>

                    <div class="mb-3">
                        <div class="text-secondary small">Data da Separação</div>
                        <div class="sf-num">@(Model.PedidoDataSeparado?.ToString("dd/MM/yyyy HH:mm") ?? "-")</div>
                    </div>

                    <div class="mb-3">
                        <div class="text-secondary small">Separado por</div>
                        <div>@(Model.UsuarioSeparou?.UsuarioNome ?? "-")</div>
                    </div>

                    <div class="mb-3">
                        <div class="text-secondary small">Data da Entrega</div>
                        <div class="sf-num">@(Model.PedidoDataConcluido?.ToString("dd/MM/yyyy HH:mm") ?? "-")</div>
                    </div>

                    <div>
                        <div class="text-secondary small">Confirmado por</div>
                        <div>@(Model.UsuarioEntregou?.UsuarioNome ?? "-")</div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-7">
                <div class="bg-shadow text-light p-3 rounded-4 h-100">
                    <h5 class="fw-bold mb-3">
                        <i class="bi bi-basket2-fill me-2"></i>
                        Produtos do Pedido
                    </h5>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 text-light">
                            <thead>
                                <tr class="bg-tpreto text-secondary sf-thead">
                                    <th class="py-3 ps-3">Produto</th>
                                    <th class="py-3 text-center">Qtd</th>
                                    <th class="py-3 text-end">Unitário</th>
                                    <th class="py-3 text-end pe-3">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Itens)
                                {
                                    <tr>
                                        <td class="ps-3 fw-semibold">@item.Produto?.ProdutoNome</td>
                                        <td class="text-center">
                                            <span class="sf-badge" style="background:rgba(255,255,255,.05); color:#e7e9ee; border-color:rgba(255,255,255,.1);">
                                                @item.ItemPedidoQtd
                                            </span>
                                        </td>
                                        <td class="text-end sf-num">@("R" + item.ItemPedidoPreco.ToString("C"))</td>
                                        <td class="text-end pe-3 fw-semibold sf-num">@("R" + (item.ItemPedidoPreco * item.ItemPedidoQtd).ToString("C"))</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="d-flex justify-content-end mt-4 pt-3" style="border-top:1px solid rgba(255,255,255,.06);">
                        <div class="text-end">
                            <div class="text-secondary small">Total do Pedido</div>
                            <div class="fs-3 fw-bold sf-num">@("R" + Model.PedidoValorTotal.ToString("C"))</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-3">
            <a asp-action="Historico" class="btn btn-outline-light">
                <i class="bi bi-arrow-left me-1"></i>
                Voltar
            </a>
        </div>

    </div>
</div>

