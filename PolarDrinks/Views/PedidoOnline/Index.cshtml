@model List<PolarDrinks.Models.Loja.PedidoModel>

@{
    var separados = (List<PolarDrinks.Models.Loja.PedidoModel>)ViewBag.Separados;
}

@{
    ViewData["Title"] = "Pedidos Online";
}

<div class="container-fluid px-3 py-2">

    @if (TempData["MensagemSucesso"] != null)
    {
        <div class="alert bg-success text-light">
            @TempData["MensagemSucesso"]
        </div>
    }
    else if (TempData["MensagemErro"] != null)
    {
        <div class="alert bg-danger text-light">
            @TempData["MensagemErro"]
        </div>
    }

    <!-- CABEÇALHO -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 bg-shadow text-light p-4 rounded-4 mt-2">
        <h1 class="m-0 mb-3 mb-md-0">
            Pedidos Online
        </h1>
       
    </div>
    <div class="row g-3">
        <div class="col-12 col-xl-6">
            <div class="bg-shadow text-light p-3 rounded-4 h-100">
                <h4 class="text-warning mb-4">
                    <i class="bi bi-box-seam"></i>
                    Aguardando Separação (@Model.Count)
                </h4>


                @if (Model.Any())
                {
                    <div class="row g-3">

                        @foreach (var pedido in Model)
                        {
                            <div class="col-12 col-xxl-6">

                                <div class="bg-tpreto p-3 rounded-4 h-100 d-flex flex-column">

                                    <div class="d-flex justify-content-between align-items-start mb-3">

                                        <div>
                                            <h5 class="mb-1">
                                                Pedido #@pedido.PedidoID
                                            </h5>

                                            <small class="text-secondary">
                                                Código: @pedido.PedidoCodigo
                                            </small>
                                        </div>

                                        <span class="badge bg-warning text-dark">
                                            Aguardando
                                        </span>

                                    </div>

                                    <div class="mb-3">

                                        <div class="mb-1">
                                            <strong>Cliente:</strong>
                                            @pedido.Cliente?.ClienteNome
                                        </div>

                                        <div class="mb-1">
                                            <strong>Total:</strong>
                                            @pedido.PedidoValorTotal.ToString("C")
                                        </div>

                                        <div>
                                            <strong>Data:</strong>
                                            @pedido.PedidoData.ToString("dd/MM/yyyy HH:mm")
                                        </div>

                                    </div>

                                    <div class="mb-3">

                                        <strong>Itens:</strong>

                                        <ul class="mb-0 mt-2">
                                            @foreach (var item in pedido.Itens)
                                            {
                                                <li>
                                                    @item.ItemPedidoQtd x @item.Produto?.ProdutoNome
                                                </li>
                                            }
                                        </ul>

                                    </div>

                                    <form method="post"
                                          asp-action="MarcarComoSeparado"
                                          class="mt-auto">

                                        <input type="hidden"
                                               name="id"
                                               value="@pedido.PedidoID" />

                                        <button type="submit"
                                                class="btn btn-success w-100">

                                            <i class="bi bi-check-lg"></i>
                                            Marcar como Separado

                                        </button>

                                    </form>

                                </div>

                            </div>
                        }

                    </div>
                }
                else
                {
                    <div class="text-center text-muted my-4">

                        <i class="bi bi-inbox fs-3 text-light"></i>

                        <p class="mt-2 mb-0 text-light">
                            Nenhum pedido aguardando separação
                        </p>

                    </div>
                }

            </div>

        </div>


        <!-- SEPARADOS -->
        <div class="col-12 col-xl-6">

            <div class="bg-shadow text-light p-3 rounded-4 h-100">

                <h4 class="text-success mb-4">
                    <i class="bi bi-check-circle-fill"></i>
                    Separado / Pronto para Retirada (@separados.Count)
                </h4>


                @if (separados.Any())
                {
                    <div class="row g-3">

                        @foreach (var pedido in separados)
                        {
                            <div class="col-12 col-xxl-6">

                                <div class="bg-tpreto p-3 rounded-4 h-100 d-flex flex-column">

                                    <div class="d-flex justify-content-between align-items-start mb-3">

                                        <div>
                                            <h5 class="mb-1">
                                                Pedido #@pedido.PedidoID
                                            </h5>

                                            <small class="text-secondary">
                                                Código: @pedido.PedidoCodigo
                                            </small>
                                        </div>

                                        <span class="badge bg-success">
                                            Separado
                                        </span>

                                    </div>

                                    <div class="mb-3">

                                        <div class="mb-1">
                                            <strong>Cliente:</strong>
                                            @pedido.Cliente?.ClienteNome
                                        </div>

                                        <div>
                                            <strong>Total:</strong>
                                            @pedido.PedidoValorTotal.ToString("C")
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center"> 
                                            <div> <strong>Data:</strong> @pedido.PedidoData.ToString("dd/MM/yyyy HH:mm") </div> 
                                            <div> <strong>Separado em:</strong> @pedido.PedidoDataSeparado?.ToString("dd/MM/yyyy HH:mm") </div> 
                                        </div>

                                    </div>

                                    <div class="mb-3">

                                        <strong>Itens:</strong>

                                        <ul class="mb-0 mt-2">
                                            @foreach (var item in pedido.Itens)
                                            {
                                                <li>
                                                    @item.ItemPedidoQtd x @item.Produto?.ProdutoNome
                                                </li>
                                            }
                                        </ul>

                                    </div>

                                    <!-- BOTÕES FIXOS NO FINAL -->
                                    <div class="d-flex gap-2 flex-wrap mt-auto">

                                        <form method="post"
                                              asp-action="VoltarParaSeparacao"
                                              class="flex-grow-1">

                                            <input type="hidden"
                                                   name="id"
                                                   value="@pedido.PedidoID" />

                                            <button type="submit"
                                                    class="btn btn-outline-warning w-100">

                                                <i class="bi bi-arrow-left"></i>
                                                Voltar

                                            </button>

                                        </form>

                                        <button type="button"
                                                class="btn btn-success flex-grow-1"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modalEntrega-@pedido.PedidoID">

                                            <i class="bi bi-check-circle"></i>
                                            Confirmar

                                        </button>

                                    </div>

                                </div>

                            </div>


                            <!-- MODAL CONFIRMAR ENTREGA -->
                            <div class="modal fade"
                                 id="modalEntrega-@pedido.PedidoID"
                                 tabindex="-1">

                                <div class="modal-dialog modal-dialog-centered">

                                    <div class="modal-content bg-shadow text-light">

                                        <div class="modal-header">

                                            <h5 class="modal-title">
                                                Confirmar Entrega
                                            </h5>

                                            <button type="button"
                                                    class="btn-close btn-close-white"
                                                    data-bs-dismiss="modal">
                                            </button>

                                        </div>


                                        <form method="post"
                                              asp-action="ConfirmarEntrega">

                                            <div class="modal-body">

                                                <p>
                                                    Informe o código fornecido ao cliente para confirmar a retirada do pedido
                                                    <strong>#@pedido.PedidoID</strong>.
                                                </p>

                                                <input type="hidden"
                                                       name="id"
                                                       value="@pedido.PedidoID" />

                                                <label class="form-label">
                                                    Código do cliente
                                                </label>

                                                <input type="text"
                                                       name="codigo"
                                                       class="form-control"
                                                       placeholder="Digite o código"
                                                       maxlength="4"
                                                       required 
                                                       autocomplete="off"/>

                                            </div>


                                            <div class="modal-footer">

                                                <button type="button"
                                                        class="btn btn-secondary"
                                                        data-bs-dismiss="modal">

                                                    Cancelar

                                                </button>

                                                <button type="submit"
                                                        class="btn btn-success">

                                                    <i class="bi bi-check-lg"></i>
                                                    Confirmar Entrega

                                                </button>

                                            </div>

                                        </form>

                                    </div>

                                </div>

                            </div>
                        }

                    </div>
                }
                else
                {
                    <div class="text-center text-muted my-4">

                        <i class="bi bi-check2-circle fs-3"></i>

                        <p class="mt-2 mb-0">
                            Nenhum pedido separado
                        </p>

                    </div>
                }

            </div>

        </div>

    </div>

</div>


<script>
    setTimeout(function  () {
        location.reload();
    }, 5 * 60 * 1000);
</script>