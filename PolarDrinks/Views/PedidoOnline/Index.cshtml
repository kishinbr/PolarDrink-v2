@model List<PolarDrinks.Models.Loja.PedidoModel>
@{
    var separados = (List<PolarDrinks.Models.Loja.PedidoModel>)ViewBag.Separados;
}
@{
    ViewData["Title"] = "Pedidos Online";
}
<div class="tema-dark">
    <div class="container-fluid px-3 px-lg-4 py-4">
        <!-- ALERTAS -->
        @if (TempData["MensagemSucesso"] != null)
        {
            <div class="alert text-light mb-3" style="background: rgba(16,185,129,.15); border-left: 3px solid #10b981 !important;">
                <i class="bi bi-check-circle-fill me-2"style="color:#34d399;"></i>@TempData["MensagemSucesso"]
            </div>
        }
        else if (TempData["MensagemErro"] != null)
        {
            <div class="alert text-light mb-3" style="background: rgba(239,68,68,.15); border-left: 3px solid #ef4444 !important;">
                <i class="bi bi-exclamation-circle-fill me-2" style="color:#f87171;"></i>@TempData["MensagemErro"]
            </div>
        }
        <!-- CABEÇALHO -->
        <div class="bg-shadow text-light p-4 rounded-4 mb-3 d-flex align-items-center gap-3">
            <div class="sf-icon-badge"
                 style="background: linear-gradient(135deg,#3b82f6,#6366f1);
                        box-shadow: 0 8px 20px -8px rgba(59,130,246,.8);">
                <i class="bi bi-bag-check-fill fs-4 text-white"></i>
            </div>
            <div>
                <h1 class="m-0 fs-3 fw-bold">Pedidos Online</h1>
            </div>

        </div>


        <!-- COLUNAS -->
        <div class="row g-3">


            <!-- AGUARDANDO SEPARAÇÃO -->
            <div class="col-12 col-xl-6">

                <div class="bg-shadow text-light p-3 rounded-4 h-100">

                    <h4 class="mb-4"
                        style="color:#fbbf24;">

                        <i class="bi bi-box-seam me-1"></i>

                        Aguardando Separação (@Model.Count)

                    </h4>


                    @if (Model.Any())
                    {
                        <div class="row g-3">

                            @foreach (var pedido in Model)
                            {
                                <div class="col-12 col-xxl-6">

                                    <div class="bg-tpreto p-3 rounded-4 h-100 d-flex flex-column">

                                        <!-- CABEÇALHO DO CARD -->
                                        <div class="d-flex justify-content-between align-items-start mb-3">

                                            <div>

                                                <h5 class="mb-1 fw-semibold">
                                                    Pedido #@pedido.PedidoID
                                                </h5>

                                                <small class="text-secondary">
                                                    Código: @pedido.PedidoCodigo
                                                </small>

                                            </div>


                                            <span class="sf-badge sf-badge-baixo">
                                                Aguardando
                                            </span>

                                        </div>


                                        <!-- INFORMAÇÕES -->
                                        <div class="mb-3">

                                            <div class="mb-1">
                                                <strong>Cliente:</strong>
                                                @pedido.Cliente?.ClienteNome
                                            </div>

                                            <div class="mb-1">
                                                <strong>Total:</strong>
                                                @pedido.PedidoValorTotal.ToString("C")
                                            </div>

                                            <div>
                                                <strong>Data:</strong>
                                                @pedido.PedidoData.ToString("dd/MM/yyyy HH:mm")
                                            </div>

                                        </div>


                                        <!-- ITENS -->
                                        <div class="mb-3">

                                            <strong>Itens:</strong>

                                            <ul class="mb-0 mt-2">

                                                @foreach (var item in pedido.Itens)
                                                {
                                                    <li>
                                                        @item.ItemPedidoQtd x @item.Produto?.ProdutoNome
                                                    </li>
                                                }

                                            </ul>

                                        </div>


                                        <!-- AÇÃO -->
                                        <form method="post"
                                              asp-action="MarcarComoSeparado"
                                              class="mt-auto">

                                            <input type="hidden"
                                                   name="id"
                                                   value="@pedido.PedidoID" />

                                            <button type="submit"
                                                    class="btn btn-success w-100">

                                                <i class="bi bi-check-lg me-1"></i>
                                                Marcar como Separado

                                            </button>

                                        </form>

                                    </div>

                                </div>
                            }

                        </div>
                    }
                    else
                    {
                        <div class="text-center my-4">

                            <i class="bi bi-inbox fs-3 text-secondary"></i>

                            <p class="mt-2 mb-0 text-secondary">
                                Nenhum pedido aguardando separação
                            </p>

                        </div>
                    }

                </div>

            </div>


            <!-- SEPARADOS -->
            <div class="col-12 col-xl-6">

                <div class="bg-shadow text-light p-3 rounded-4 h-100">

                    <h4 class="mb-4"
                        style="color:#34d399;">

                        <i class="bi bi-check-circle-fill me-1"></i>

                        Separado / Pronto para Retirada (@separados.Count)

                    </h4>


                    @if (separados.Any())
                    {
                        <div class="row g-3">

                            @foreach (var pedido in separados)
                            {
                                <div class="col-12 col-xxl-6">

                                    <div class="bg-tpreto p-3 rounded-4 h-100 d-flex flex-column">

                                        <!-- CABEÇALHO -->
                                        <div class="d-flex justify-content-between align-items-start mb-3">

                                            <div>

                                                <h5 class="mb-1 fw-semibold">
                                                    Pedido #@pedido.PedidoID
                                                </h5>

                                                <small class="text-secondary">
                                                    Código: @pedido.PedidoCodigo
                                                </small>

                                            </div>


                                            <span class="sf-badge sf-badge-ok">
                                                Separado
                                            </span>

                                        </div>


                                        <!-- INFORMAÇÕES -->
                                        <div class="mb-3">

                                            <div class="mb-1">
                                                <strong>Cliente:</strong>
                                                @pedido.Cliente?.ClienteNome
                                            </div>

                                            <div class="mb-1">
                                                <strong>Total:</strong>
                                                @pedido.PedidoValorTotal.ToString("C")
                                            </div>

                                            <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap">

                                                <div>
                                                    <strong>Data:</strong>
                                                    @pedido.PedidoData.ToString("dd/MM/yyyy HH:mm")
                                                </div>

                                                <div>
                                                    <strong>Separado em:</strong>
                                                    @pedido.PedidoDataSeparado?.ToString("dd/MM/yyyy HH:mm")
                                                </div>

                                            </div>

                                        </div>


                                        <!-- ITENS -->
                                        <div class="mb-3">

                                            <strong>Itens:</strong>

                                            <ul class="mb-0 mt-2">

                                                @foreach (var item in pedido.Itens)
                                                {
                                                    <li>
                                                        @item.ItemPedidoQtd x @item.Produto?.ProdutoNome
                                                    </li>
                                                }

                                            </ul>

                                        </div>


                                        <!-- BOTÕES -->
                                        <div class="d-flex gap-2 flex-wrap mt-auto">

                                            <form method="post"
                                                  asp-action="VoltarParaSeparacao"
                                                  class="flex-grow-1">

                                                <input type="hidden"
                                                       name="id"
                                                       value="@pedido.PedidoID" />

                                                <button type="submit"
                                                        class="btn btn-outline-warning w-100">

                                                    <i class="bi bi-arrow-left me-1"></i>
                                                    Voltar

                                                </button>

                                            </form>


                                            <button type="button"
                                                    class="btn btn-success flex-grow-1"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#modalEntrega-@pedido.PedidoID">

                                                <i class="bi bi-check-circle me-1"></i>
                                                Confirmar

                                            </button>

                                        </div>

                                    </div>

                                </div>


                                <!-- MODAL CONFIRMAR ENTREGA -->
                                <div class="modal fade"
                                     id="modalEntrega-@pedido.PedidoID"
                                     tabindex="-1">

                                    <div class="modal-dialog modal-dialog-centered">

                                        <div class="modal-content bg-shadow text-light">

                                            <div class="modal-header">

                                                <h5 class="modal-title">
                                                    Confirmar Entrega
                                                </h5>

                                                <button type="button"
                                                        class="btn-close btn-close-white"
                                                        data-bs-dismiss="modal">
                                                </button>

                                            </div>


                                            <form method="post"
                                                  asp-action="ConfirmarEntrega">

                                                <div class="modal-body">

                                                    <p>
                                                        Informe o código fornecido ao cliente para confirmar a retirada do pedido
                                                        <strong>#@pedido.PedidoID</strong>.
                                                    </p>

                                                    <input type="hidden"
                                                           name="id"
                                                           value="@pedido.PedidoID" />


                                                    <label class="form-label">
                                                        Código do cliente
                                                    </label>

                                                    <input type="text"
                                                           name="codigo"
                                                           class="form-control bg-tpreto text-light"
                                                           placeholder="Digite o código"
                                                           maxlength="4"
                                                           required
                                                           autocomplete="off" />

                                                </div>


                                                <div class="modal-footer">

                                                    <button type="button"
                                                            class="btn btn-outline-light"
                                                            data-bs-dismiss="modal">

                                                        Cancelar

                                                    </button>


                                                    <button type="submit"
                                                            class="btn btn-success">

                                                        <i class="bi bi-check-lg me-1"></i>
                                                        Confirmar Entrega

                                                    </button>

                                                </div>

                                            </form>

                                        </div>

                                    </div>

                                </div>
                            }

                        </div>
                    }
                    else
                    {
                        <div class="text-center my-4">

                            <i class="bi bi-check2-circle fs-3 text-secondary"></i>

                            <p class="mt-2 mb-0 text-secondary">
                                Nenhum pedido separado
                            </p>

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>

</div>


<script>
    setTimeout(function () {
        location.reload();
    }, 5 * 60 * 1000);
</script>

