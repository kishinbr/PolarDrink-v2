@model List<PolarDrinks.Models.Loja.PedidoModel>
@{
    ViewData["Title"] = "Histórico de Pedidos Online";
}

<div class="tema-dark">

    <div class="container-fluid px-3 px-lg-4 py-4" style="max-width: 1400px;">

        <!-- ALERTAS -->
        @if (TempData["MensagemSucesso"] != null)
        {
            <div class="alert text-light mb-3"
                 style="background: rgba(16,185,129,.15); border-left: 3px solid #10b981 !important;">
                <i class="bi bi-check-circle-fill me-2" style="color:#34d399;"></i>
                @TempData["MensagemSucesso"]
            </div>
        }
        else if (TempData["MensagemErro"] != null)
        {
            <div class="alert text-light mb-3"
                 style="background: rgba(239,68,68,.15); border-left: 3px solid #ef4444 !important;">
                <i class="bi bi-exclamation-circle-fill me-2" style="color:#f87171;"></i>
                @TempData["MensagemErro"]
            </div>
        }

        <!-- CABEÇALHO -->
        <div class="bg-shadow text-light p-4 rounded-4 mb-3 d-flex flex-wrap justify-content-between align-items-center gap-3">

            <div class="d-flex align-items-center gap-3">

                <div class="sf-icon-badge"
                     style="background: linear-gradient(135deg,#3b82f6,#6366f1);
                            box-shadow: 0 8px 20px -8px rgba(59,130,246,.8);">

                    <i class="bi bi-bag-check-fill fs-4 text-white"></i>

                </div>

                <div>
                    <h1 class="m-0 fs-3 fw-bold">
                        Histórico de Pedidos Online
                    </h1>
                </div>

            </div>

            <a asp-action="Index"
               asp-controller="Venda"
               class="btn text-white fw-semibold px-3 py-2 rounded-3 border-0"
               style="background: linear-gradient(135deg,#3b82f6,#6366f1);"
               title="Ver histórico">

                <i class="bi bi-clock-history me-2"></i>
                Ver histórico

            </a>

        </div>

        <!-- FILTROS -->
        <div class="bg-shadow text-light p-3 rounded-4 mb-3 d-flex flex-wrap justify-content-between align-items-center gap-3">

            <div class="sf-segment" id="filtroPedidos">

                <button type="button"
                        class="active"
                        data-filtro="todos">
                    Todos
                </button>

                <button type="button"
                        data-filtro="cartao"
                        class="sf-badge"
                        style="background:rgba(167,139,250,.14);
                               color:#c4b5fd;
                               border-color:rgba(167,139,250,.3);">
                    Cartão
                </button>

                <button type="button"
                        data-filtro="pix"
                        class="sf-badge"
                        style="background:rgba(0,189,174,.14);
                               color:#2dd4bf;
                               border-color:rgba(0,189,174,.3);">
                    Pix
                </button>

                <button type="button"
                        data-filtro="concluido"
                        class="sf-badge"
                        style="background:#203D3D;
                               color:#30D38D;
                               border-color:#1C594C;">
                    Concluído
                </button>

                <button type="button"
                        data-filtro="cancelado"
                        class="sf-badge"
                        style="background:#402D35;
                               color:#DA4435;
                               border-color:#753439;">
                    Cancelado
                </button>

                <button type="button"
                        data-filtro="expirado"
                        class="sf-badge"
                        style="background:#402D35;
                               color:#DA4435;
                               border-color:#753439;">
                    Expirado
                </button>



            </div>


            <div class="d-flex align-items-end gap-2 flex-wrap">

                <div>

                    <label class="form-label text-secondary small mb-1">
                        Início
                    </label>

                    <input type="date"
                           id="dataInicioPedidos"
                           class="form-control form-control-sm bg-tpreto text-light border-0"
                           style="box-shadow:none;">

                </div>


                <div>

                    <label class="form-label text-secondary small mb-1">
                        Fim
                    </label>

                    <input type="date"
                           id="dataFimPedidos"
                           class="form-control form-control-sm bg-tpreto text-light border-0"
                           style="box-shadow:none;">

                </div>


                <button type="button"
                        id="limparFiltrosPedidos"
                        class="btn btn-outline-light btn-sm px-2"
                        title="Limpar filtros">

                    <i class="bi bi-x-lg"></i>

                </button>

            </div>

        </div>


        <!-- TABELA -->
        <div class="bg-shadow text-light p-3 rounded-4 overflow-hidden">

            <div class="table-responsive">

                <table id="tabelaPedidosOnline"
                       class="table table-hover align-middle mb-0 text-light">

                    <thead>

                        <tr class="bg-tpreto text-secondary sf-thead">

                            <th class="py-3 ps-3">
                                Pedido
                            </th>

                            <th class="py-3">
                                Compra
                            </th>

                            <th class="py-3">
                                Entrega
                            </th>

                            <th class="py-3">
                                Confirmado por
                            </th>

                            <th class="py-3">
                                Pagamento
                            </th>

                            <th class="py-3 text-end">
                                Total
                            </th>

                            <th class="py-3">
                                Status
                            </th>

                            <th class="py-3 text-center pe-3">
                                Detalhes
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var pedido in Model)
                        {
                            var filtroPagamento = pedido.PedidoTipoPagamento?.ToLower() switch
                            {
                                "cartão" => "cartao",
                                "cartao" => "cartao",
                                "pix" => "pix",
                                _ => ""
                            };

                            var filtroStatus = pedido.PedidoStatus switch
                            {
                                PolarDrinks.Models.Loja.PedidoModel.Status.Concluido => "concluido",
                                PolarDrinks.Models.Loja.PedidoModel.Status.CanceladoCliente => "cancelado",
                                PolarDrinks.Models.Loja.PedidoModel.Status.CanceladoAdmin => "cancelado",
                                PolarDrinks.Models.Loja.PedidoModel.Status.CanceladoNaoRetirado => "expirado",
                                _ => ""
                            };

                            <tr data-pagamento="@filtroPagamento"
                                data-status="@filtroStatus"
                                data-data="@pedido.PedidoData.ToString("yyyy-MM-dd")">

                                <!-- PEDIDO -->
                                <td class="ps-3">

                                    <span class="sf-badge"
                                          style="background: rgba(255,255,255,.05);
                                                 color:#e7e9ee;
                                                 border-color:rgba(255,255,255,.1);">

                                        #@pedido.PedidoID

                                    </span>

                                </td>


                                <!-- COMPRA -->
                                <td class="sf-num"
                                    data-order="@pedido.PedidoData.ToString("yyyy-MM-dd HH:mm:ss")">

                                    @pedido.PedidoData.ToString("dd/MM/yyyy HH:mm")

                                </td>


                                <!-- ENTREGA -->
                                <td class="sf-num">

                                    @(pedido.PedidoDataConcluido?.ToString("dd/MM/yyyy HH:mm") ?? "-")

                                </td>


                                <!-- CONFIRMADO POR -->
                                <td>

                                    @(pedido.UsuarioEntregou?.UsuarioNome ?? "-")

                                </td>


                                <!-- PAGAMENTO -->
                                <td>

                                    @if (pedido.PedidoTipoPagamento == "Pix")
                                    {
                                        <span class="sf-badge"
                                              style="background:rgba(0,189,174,.14);
                                                     color:#2dd4bf;
                                                     border-color:rgba(0,189,174,.3);">
                                            Pix
                                        </span>
                                    }


                                    else
                                    {
                                        <span class="sf-badge"
                                              style="background:rgba(167,139,250,.14);
                                                     color:#c4b5fd;
                                                     border-color:rgba(167,139,250,.3);">
                                            Cartão
                                        </span>
                                    }

                                </td>


                                <!-- TOTAL -->
                                <td class="text-end fw-semibold sf-num">

                                    @pedido.PedidoValorTotal.ToString("C")

                                </td>


                                <!-- STATUS -->
                                <td>

                                    @if (pedido.PedidoStatus == PolarDrinks.Models.Loja.PedidoModel.Status.Concluido)
                                    {
                                        <span class="sf-badge sf-badge-ok">
                                            Concluído
                                        </span>
                                    }
                                    else if (pedido.PedidoStatus == PolarDrinks.Models.Loja.PedidoModel.Status.CanceladoCliente)
                                    {
                                        <span class="sf-badge sf-badge-zerado">
                                            Cancelado
                                        </span>
                                    }
                                    else if (pedido.PedidoStatus == PolarDrinks.Models.Loja.PedidoModel.Status.CanceladoNaoRetirado)
                                    {
                                        <span class="sf-badge sf-badge-zerado">
                                            Expirado
                                        </span>
                                    }
                                    else if (pedido.PedidoStatus == PolarDrinks.Models.Loja.PedidoModel.Status.CanceladoAdmin)
                                    {
                                        <span class="sf-badge sf-badge-zerado">
                                            Cancelado
                                        </span>
                                    }

                                </td>


                                <!-- AÇÕES -->
                                <td class="text-center pe-3">

                                    <a class="btn btn-sm border-0 text-white sf-btn-edit"
                                       asp-action="Detalhes"
                                       asp-route-id="@pedido.PedidoID"
                                       title="Ver detalhes">

                                        <i class="bi bi-file-earmark-text-fill"></i>

                                    </a>


                                    @{
                                        var podeCancelar =
                                            pedido.PedidoStatus == PolarDrinks.Models.Loja.PedidoModel.Status.Concluido
                                            && pedido.PedidoDataConcluido.HasValue
                                            && DateTime.Now <= pedido.PedidoDataConcluido.Value.AddHours(24);
                                    }


                                    @if (podeCancelar)
                                    {
                                        <button type="button"
                                                class="btn btn-sm border-0 text-white"
                                                style="background:linear-gradient(135deg,#ef4444,#dc2626);"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modalCancelar@(pedido.PedidoID)"
                                                title="Cancelar pedido">

                                            <i class="bi bi-x-circle"></i>

                                        </button>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>


<!-- MODAIS DE CANCELAMENTO -->
@foreach (var pedido in Model)
{
    var podeCancelarModal =
        pedido.PedidoStatus == PolarDrinks.Models.Loja.PedidoModel.Status.Concluido
        && pedido.PedidoDataConcluido.HasValue
        && DateTime.Now <= pedido.PedidoDataConcluido.Value.AddHours(24);

    if (podeCancelarModal)
    {
        <div class="modal fade"
             id="modalCancelar@(pedido.PedidoID)"
             tabindex="-1">

            <div class="modal-dialog">

                <div class="modal-content bg-shadow text-light">

                    <div class="modal-header">

                        <h5 class="modal-title">
                            Cancelar Pedido #@pedido.PedidoID
                        </h5>

                        <button type="button"
                                class="btn-close btn-close-white"
                                data-bs-dismiss="modal">
                        </button>

                    </div>


                    <form method="post"
                          asp-action="CancelarAposEntrega">

                        <div class="modal-body">

                            <input type="hidden"
                                   name="id"
                                   value="@pedido.PedidoID" />

                            <label class="form-label">
                                Motivo do cancelamento
                            </label>

                            <textarea class="form-control bg-tpreto text-light"
                                      name="descricao"
                                      rows="3"
                                      required
                                      maxlength="50"></textarea>

                        </div>


                        <div class="modal-footer">

                            <button type="button"
                                    class="btn btn-outline-light"
                                    data-bs-dismiss="modal">

                                Voltar

                            </button>

                            <button type="submit"
                                    class="btn btn-danger">

                                <i class="bi bi-x-circle me-1"></i>
                                Confirmar Cancelamento

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>
    }
}


<script>
    document.addEventListener("DOMContentLoaded", function () {

        var segment = document.getElementById('filtroPedidos');
        var dataInicio = document.getElementById('dataInicioPedidos');
        var dataFim = document.getElementById('dataFimPedidos');
        var limparFiltros = document.getElementById('limparFiltrosPedidos');

        var linhas = Array.from(
            document.querySelectorAll('#tabelaPedidosOnline tbody tr')
        );

        var filtroAtivo = 'todos';


        function aplicarFiltros() {

            var inicio = dataInicio.value;
            var fim = dataFim.value;


            linhas.forEach(function (tr) {

                var pagamento = tr.getAttribute('data-pagamento');
                var status = tr.getAttribute('data-status');
                var data = tr.getAttribute('data-data');

                var matchFiltro = true;


                if (filtroAtivo === 'cartao') {
                    matchFiltro = pagamento === 'cartao';
                }
                else if (filtroAtivo === 'pix') {
                    matchFiltro = pagamento === 'pix';
                }
                else if (filtroAtivo === 'concluido') {
                    matchFiltro = status === 'concluido';
                }
                else if (filtroAtivo === 'cancelado') {
                    matchFiltro = status === 'cancelado';
                }
                else if (filtroAtivo === 'expirado') {
                    matchFiltro = status === 'expirado';
                }


                var matchDataInicio =
                    !inicio || data >= inicio;

                var matchDataFim =
                    !fim || data <= fim;


                tr.style.display =
                    (matchFiltro && matchDataInicio && matchDataFim)
                        ? ''
                        : 'none';

            });

        }


        segment.querySelectorAll('button').forEach(function (btn) {

            btn.addEventListener('click', function () {

                segment.querySelectorAll('button').forEach(function (b) {
                    b.classList.remove('active');
                });

                btn.classList.add('active');

                filtroAtivo =
                    btn.getAttribute('data-filtro');

                aplicarFiltros();

            });

        });


        dataInicio.addEventListener(
            'change',
            aplicarFiltros
        );


        dataFim.addEventListener(
            'change',
            aplicarFiltros
        );


        limparFiltros.addEventListener(
            'click',
            function () {

                filtroAtivo = 'todos';


                segment.querySelectorAll('button').forEach(function (b) {
                    b.classList.remove('active');
                });


                segment
                    .querySelector('[data-filtro="todos"]')
                    .classList.add('active');


                dataInicio.value = '';
                dataFim.value = '';


                aplicarFiltros();

            }
        );

    });
</script>

