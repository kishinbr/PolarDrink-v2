@model IEnumerable<PolarDrinks.Models.UsuarioModel>
@{
    ViewData["Title"] = "Usuários";
}

<div class="tema-dark">
    <div class="container-fluid px-3 px-lg-4 py-4" style="max-width: 1400px;">

        <div class="bg-shadow text-light p-4 rounded-4 mb-3 d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="sf-icon-badge" style="background: linear-gradient(135deg,#3b82f6,#6366f1); box-shadow: 0 8px 20px -8px rgba(59,130,246,.8);">
                    <i class="bi bi-people-fill fs-4 text-white"></i>
                </div>
                <div>
                    <h1 class="m-0 fs-3 fw-bold">Usuários</h1>
                </div>
            </div>

            <a class="btn text-white fw-semibold px-3 py-2 rounded-3 border-0" style="background: linear-gradient(135deg,#10b981,#059669);" 
                asp-action="Cadastrar" title="Cadastrar">
                <i class="bi bi-person-plus-fill me-1"></i>
                Cadastrar novo Usuário
            </a>
        </div>

        @if (TempData["MensagemSucesso"] != null)
        {
            <div class="bg-shadow text-light p-3 rounded-4 mb-3" style="background: rgba(16,185,129,.15) !important; border-left: 3px solid #10b981 !important;">
                <i class="bi bi-check-circle-fill me-2" style="color:#34d399;"></i>
                @TempData["MensagemSucesso"]
            </div>
        }
        else if (TempData["MensagemErro"] != null)
        {
            <div class="bg-shadow text-light p-3 rounded-4 mb-3" style="background: rgba(239,68,68,.15) !important; border-left: 3px solid #ef4444 !important;">
                <i class="bi bi-exclamation-circle-fill me-2" style="color:#f87171;"></i>
                @TempData["MensagemErro"]
            </div>
        }

        <div class="bg-shadow p-4 rounded-4">
            <div class="table-responsive">
                <table id="tabelaUsuarios" class="table table-hover align-middle mb-0 text-light">
                    <thead class="bg-tpreto text-secondary sf-thead">
                        <tr>
                            <th>Nome</th>
                            <th>Usuário</th>
                            <th>Perfil</th>
                            <th>Criado em</th>
                            <th>Status</th>
                            <th class="text-center">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in Model)
                        {
                            <tr>
                                <td class="align-middle">@u.UsuarioNome</td>
                                <td class="align-middle">@u.UsuarioLogin</td>
                                <td class="align-middle">
                                    @if (u.UsuarioPerfil == "Admin")
                                    {
                                        <span class="sf-badge sf-badge-ativo">Admin</span>
                                    }
                                    else
                                    {
                                        <span class="sf-badge" style="background:rgba(148,163,184,.14); color:#cbd5e1; border-color:rgba(148,163,184,.3);">Funcionário</span>
                                    }
                                </td>
                                <td class="align-middle">@u.UsuarioCriadoEm.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="align-middle">
                                    @if (u.UsuarioAtivo)
                                    {
                                        <span class="sf-badge sf-badge-ok">Ativo</span>
                                    }
                                    else
                                    {
                                        <span class="sf-badge sf-badge-inativo">Inativo</span>
                                    }
                                </td>
                                <td class="text-center align-middle">
                                    <div class="d-flex justify-content-center gap-2">
                                        <a asp-action="AlterarSenha" asp-route-id="@u.UsuarioID" class="btn btn-sm btn-warning" title="Alterar Senha">
                                            <i class="bi bi-key-fill me-1"></i>Alterar Senha
                                        </a>
                                        <a asp-action="Desativar" asp-route-id="@u.UsuarioID" class="btn btn-sm @(u.UsuarioAtivo ? "btn-danger" : "btn-success")">
                                            <i class="bi @(u.UsuarioAtivo ? "bi-person-x-fill" : "bi-person-check-fill") me-1"></i>
                                            @(u.UsuarioAtivo ? "Desativar" : "Ativar")
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>
@section Scripts {
    <script>
        $(document).ready(function () {
           $('#tabelaUsuarios').DataTable({
            pageLength: 10,
            lengthMenu: [10, 20, 30],
            scrollY: "50vh",
            scrollX: true,
            scrollCollapse: true,
            paging: true,

            columnDefs: [
                { orderable: false, targets: [5] }, 
                { className: "text-start", targets: [0, 1] }, 
                { className: "text-center", targets: [2, 3, 4, 5] }, 


            ],

            language: {
                "decimal": "",
                "emptyTable": "Nenhum usuário cadastrado",
                "info": "Mostrando de _START_ a _END_ de _TOTAL_ usuários",
                "infoEmpty": "Mostrando 0 de 0 usuários",
                "infoFiltered": "(filtrado de _MAX_ usuários)",
                "lengthMenu": "Mostrar _MENU_ usuários",
                "loadingRecords": "Carregando...",
                "search": "Procurar:",
                "zeroRecords": "Usuário não encontrado",
                "paginate": {
                    "first": "Primeiro",
                    "last": "Último",
                    "next": "Próximo",
                    "previous": "Anterior"
                }
            }
        });
        });
    </script>
}