@{
    ViewData["Title"] = "Novo Usuário";
}

<div class="tema-dark">
    <div class="container-fluid px-3 px-lg-4 py-4" style="max-width:1400px;">
        <div class="bg-shadow text-light p-4 rounded-4 mb-3 d-flex align-items-center gap-3">
            <div class="sf-icon-badge" style="background:linear-gradient(135deg,#3b82f6,#6366f1); box-shadow:0 8px 20px -8px rgba(59,130,246,.8);">
                <i class="bi bi-person-plus-fill fs-4 text-white"></i>
            </div>
            <div>
                <h1 class="m-0 fs-3 fw-bold">Novo Usuário</h1>
            </div>
        </div>

        <div class="bg-shadow p-4 rounded-4 mx-auto" style="max-width:480px;">
            @if (ViewBag.Erro != null)
            {
                <div class="bg-shadow text-light p-3 rounded-4 mb-3" role="alert" style="background:rgba(239,68,68,.15) !important; border-left:3px solid #ef4444 !important;">
                    <i class="bi bi-exclamation-circle-fill me-2" style="color:#f87171;"></i>
                    @ViewBag.Erro
                </div>
            }

            <form method="post">
                <div class="mb-3">
                    <label class="form-label text-light">Nome</label>
                    <input type="text" name="usuarioNome" class="form-control bg-shadow text-light" required />
                </div>

                <div class="mb-3">
                    <label class="form-label text-light">Login de usuário</label>
                    <input type="text" name="usuarioLogin" class="form-control bg-shadow text-light" required />
                </div>

                <div class="mb-3">
                    <label class="form-label text-light">Perfil</label>
                    <select name="usuarioPerfil" class="form-select bg-shadow text-light">
                        <option value="Funcionario" style="background:#16181f;color:#e7e9ee;">Funcionário</option>
                        <option value="Admin" style="background:#16181f;color:#e7e9ee;">Admin</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label text-light">Senha</label>
                    <input type="password" name="senha" class="form-control bg-shadow text-light" minlength="6" required />
                    <small class="text-secondary">Mínimo 6 caracteres.</small>
                </div>

                <div class="mb-4">
                    <label class="form-label text-light">Confirmar senha</label>
                    <input type="password" name="confirmacaoSenha" class="form-control bg-shadow text-light" minlength="6" required />
                </div>

                <div class="mb-4">
                    <label class="form-label text-light">Senha do @Context.Session.GetString("Nome")</label>
                    <input type="password" name="senhaAtual" class="form-control bg-shadow text-light" minlength="6" required />
                </div>

                <div class="d-flex gap-3">
                    <a asp-action="Index" class="btn btn-outline-light w-50">
                        <i class="bi bi-arrow-left me-1"></i>Voltar
                    </a>
                    <button type="submit" class="btn btn-success w-50">
                        <i class="bi bi-person-plus-fill me-1"></i>Cadastrar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

