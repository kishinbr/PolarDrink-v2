@model PolarDrinks.Models.UsuarioModel
@{
    ViewData["Title"] = Model.UsuarioAtivo ? "Desativar Usuário" : "Ativar Usuário";
}

<div class="container bg-shadow p-5 rounded-5 mt-3" style="max-width:480px;">

    <div class="text-center mb-4">
        <h2 class="text-light">
            @(Model.UsuarioAtivo ? "Desativar Usuário" : "Ativar Usuário")
        </h2>
        <p class="text-secondary">
            @(Model.UsuarioAtivo
                ? "Você está prestes a desativar este usuário."
                : "Você está prestes a ativar este usuário.")
        </p>
        <p class="text-secondary">Nome: <strong class="text-light">@Model.UsuarioNome</strong></p>
        <p class="text-secondary">Usuário: <strong class="text-light">@Model.UsuarioLogin</strong></p>
    </div>

    @if (ViewBag.Erro != null)
    {
        <div class="alert bg-danger text-light" role="alert">
            @ViewBag.Erro
        </div>
    }

    <form method="post">
        <div class="mb-4">
            <label class="form-label text-light">Confirme sua senha</label>
            <input type="password" name="senhaAtual" class="form-control bg-shadow text-light" required />
        </div>


        <div class="d-flex gap-3">
            <a asp-action="Index" class="btn btn-primary w-50">Voltar</a>
            <button type="submit"
                    class="btn w-50 @(Model.UsuarioAtivo ? "btn-danger" : "btn-success")">
                @(Model.UsuarioAtivo ? "Desativar" : "Ativar")
            </button>
            
        </div>
    </form>

</div>
