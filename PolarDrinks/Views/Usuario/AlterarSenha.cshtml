@model PolarDrinks.Models.UsuarioModel
@{
    ViewData["Title"] = "Alterar Senha";
}

<div class="container bg-shadow p-5 rounded-5 mt-3" style="max-width:480px;">

    <div class="text-center mb-4">
        <h2 class="text-light">Alterar Senha</h2>
        <p class="text-secondary">Nome: <strong class="text-light">@Model.UsuarioNome</strong></p>
        <p class="text-secondary">Usuário: <strong class="text-light">@Model.UsuarioLogin</strong></p>
    </div>

    @if (ViewBag.Erro != null)
    {
        <div class="alert bg-danger text-light" role="alert">
            @ViewBag.Erro
        </div>
    }

    <form method="post">
        <div class="mb-4">
            <label class="form-label text-light">Senha atual</label>
            <input type="password" name="senhaAtual" class="form-control bg-shadow text-light" required />
        </div>

        <div class="mb-3">
            <label class="form-label text-light">Nova senha</label>
            <input type="password" name="novaSenha" class="form-control bg-shadow text-light"
                   minlength="6" required />
            <small class="text-secondary">Mínimo 6 caracteres.</small>
        </div>

        <div class="mb-4">
            <label class="form-label text-light">Confirmar nova senha</label>
            <input type="password" name="confirmacaoSenha" class="form-control bg-shadow text-light" required />
        </div>

        <div class="d-flex gap-3">
            <a asp-action="Index" class="btn btn-primary w-50">Voltar</a>
            <button type="submit" class="btn btn-success w-50">Salvar</button>
            
        </div>
    </form>

</div>
