@model PolarDrinks.Models.UsuarioModel
@{
    ViewData["Title"] = "Alterar Senha";
}

<div class="tema-dark">
    <div class="container-fluid px-3 px-lg-4 py-4" style="max-width: 1400px;">

        <div class="bg-shadow text-light p-4 rounded-4 mb-3 d-flex align-items-center gap-3">
            <div class="sf-icon-badge" style="background: linear-gradient(135deg,#3b82f6,#6366f1); box-shadow: 0 8px 20px -8px rgba(59,130,246,.8);">
                <i class="bi bi-key-fill fs-4 text-white"></i>
            </div>
            <div>
                <h1 class="m-0 fs-3 fw-bold">Alterar Senha</h1>
            </div>
        </div>

        <div class="bg-shadow p-4 rounded-4 mx-auto" style="max-width:480px;">

            <div class="text-center mb-4">
                <div class="sf-icon-badge mx-auto mb-3" style="background:rgba(59,130,246,.14);">
                    <i class="bi bi-person-fill fs-4" style="color:#60a5fa;"></i>
                </div>
                <p class="text-secondary mb-2">Nome: <strong class="text-light">@Model.UsuarioNome</strong></p>
                <p class="text-secondary mb-0">Usuário: <strong class="text-light">@Model.UsuarioLogin</strong></p>
            </div>

            @if (ViewBag.Erro != null)
            {
                <div class="bg-shadow text-light p-3 rounded-4 mb-3" role="alert" style="background:rgba(239,68,68,.15) !important; border-left:3px solid #ef4444 !important;">
                    <i class="bi bi-exclamation-circle-fill me-2" style="color:#f87171;"></i>
                    @ViewBag.Erro
                </div>
            }

            <form method="post">
                <div class="mb-4">
                    <label class="form-label text-light">Senha atual</label>
                    <input type="password" name="senhaAtual" class="form-control bg-shadow text-light" required />
                </div>

                <div class="mb-3">
                    <label class="form-label text-light">Nova senha</label>
                    <input type="password" name="novaSenha" class="form-control bg-shadow text-light" minlength="6" required />
                    <small class="text-secondary">Mínimo 6 caracteres.</small>
                </div>

                <div class="mb-4">
                    <label class="form-label text-light">Confirmar nova senha</label>
                    <input type="password" name="confirmacaoSenha" class="form-control bg-shadow text-light" required />
                </div>

                <div class="d-flex gap-3">
                    <a asp-action="Index" class="btn btn-outline-light w-50">
                        <i class="bi bi-arrow-left me-1"></i>Voltar
                    </a>
                    <button type="submit" class="btn btn-success w-50">
                        <i class="bi bi-check-lg me-1"></i>Salvar
                    </button>
                </div>
            </form>

        </div>

    </div>
</div>
