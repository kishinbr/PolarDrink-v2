@model PolarDrinks.ViewModels.CompraDetalhesViewModel
@{
    ViewData["Title"] = "Excluir Reabastecimento";
}

<div class="tema-dark">
    <div class="container-fluid px-3 px-lg-4 py-4" style="max-width:1400px;">
        <div class="bg-shadow text-light p-4 rounded-4 mb-3 d-flex align-items-center gap-3">
            <div class="sf-icon-badge" style="background:linear-gradient(135deg,#ef4444,#dc2626); box-shadow:0 8px 20px -8px rgba(239,68,68,.8);">
                <i class="bi bi-trash3-fill fs-4 text-white"></i>
            </div>
            <div>
                <h1 class="m-0 fs-3 fw-bold">Excluir Reabastecimento #@Model.Compra.CompraID</h1>
                <small class="text-secondary">Confira os dados antes de confirmar a exclusão</small>
            </div>
        </div>

        <div class="bg-shadow text-light p-4 rounded-4 mb-4">
            <div class="row g-3">
                <div class="col-md-6">
                    <strong>Data:</strong> @Model.Compra.CompraData.ToString("dd/MM/yyyy")
                </div>
                <div class="col-md-6">
                    <strong>Fornecedor:</strong> @Model.Compra.Fornecedor?.FornecedorNome
                </div>
                <div class="col-md-6">
                    <strong>Status:</strong>
                    <span class="sf-badge sf-badge-baixo">@Model.Compra.CompraStatus</span>
                </div>
                <div class="col-md-6">
                    <strong>Data de Entrega:</strong> Não Entregue
                </div>
            </div>
        </div>

        <div class="bg-shadow text-light p-4 rounded-4 mb-4">
            <div style="overflow-x:auto;">
                <table class="table table-hover align-middle mb-0 text-light">
                    <thead class="bg-tpreto text-secondary sf-thead">
                        <tr>
                            <th>Produto</th>
                            <th>Qtd</th>
                            <th class="text-end">Unitário</th>
                            <th class="text-end">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Itens)
                        {
                            <tr>
                                <td>@item.Produto?.ProdutoNome</td>
                                <td>@item.ItemCompraQtd</td>
                                <td class="text-end">@("R" + @item.ItemCompraPreco.ToString("C"))</td>
                                <td class="text-end">@("R" + (item.ItemCompraQtd * item.ItemCompraPreco).ToString("C"))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="text-end text-light mt-3">
                <h4 class="m-0">Total: @("R" + @Model.Compra.CompraValorTotal.ToString("C"))</h4>
            </div>
        </div>

        <div class="d-flex gap-3">
            <a asp-action="Index" class="btn btn-outline-light w-50" title="Cancelar Exclusão">
                <i class="bi bi-arrow-left me-1"></i>Cancelar
            </a>

            <form asp-action="ConfirmarExclusao" method="post" class="w-50">
                <input type="hidden" name="id" value="@Model.Compra.CompraID" />
                <button type="submit" class="btn btn-danger w-100" title="Confirmar Exclusão">
                    <i class="bi bi-trash3 me-1"></i>Confirmar Exclusão
                </button>
            </form>
        </div>
    </div>
</div>
