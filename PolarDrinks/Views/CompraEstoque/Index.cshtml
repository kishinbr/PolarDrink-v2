
@model PolarDrinks.ViewModels.CompraIndexViewModel
@{
    ViewData["Title"] = "Reabastecimento";
}

<div class="tema-dark">
    <div class="container-fluid px-3 px-lg-4 py-4" style="max-width:1400px;">

        <div class="bg-shadow text-light p-4 rounded-4 mb-3 d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="sf-icon-badge" style="background:linear-gradient(135deg,#3b82f6,#6366f1); box-shadow:0 8px 20px -8px rgba(59,130,246,.8);">
                    <i class="bi bi-box-arrow-in-down fs-4 text-white"></i>
                </div>
                <div>
                    <h1 class="m-0 fs-3 fw-bold">Reabastecimento</h1>
                </div>
            </div>
            <a class="btn text-white fw-semibold px-3 py-2 rounded-3 border-0" style="background: linear-gradient(135deg,#10b981,#059669);"
                asp-action="Cadastrar" title="Cadastrar">
                <i class="bi bi-plus-lg me-1"></i>Novo Reabastecimento
            </a>
        </div>

        @if (TempData["MensagemSucesso"] != null)
        {
            <div class="bg-shadow text-light p-3 rounded-4 mb-3" style="background:rgba(16,185,129,.15) !important; border-left:3px solid #10b981 !important;">
                <i class="bi bi-check-circle-fill me-2" style="color:#34d399;"></i>
                @TempData["MensagemSucesso"]
            </div>
        }
        else if (TempData["MensagemErro"] != null)
        {
            <div class="bg-shadow text-light p-3 rounded-4 mb-3" style="background:rgba(239,68,68,.15) !important; border-left:3px solid #ef4444 !important;">
                <i class="bi bi-exclamation-circle-fill me-2" style="color:#f87171;"></i>
                @TempData["MensagemErro"]
            </div>
        }

        @if (Model.Pendentes != null && Model.Pendentes.Any())
        {
            <div class="bg-shadow text-light p-4 rounded-4 mb-4">
                <h4 class="d-flex justify-content-between align-items-center text-warning mb-4 mt-2">
                    <span><i class="bi bi-clock-history me-2"></i>Pedidos Pendentes</span>
                </h4>

                <div style="overflow-x:auto;">
                    <table class="table table-hover align-middle mb-0 text-light">
                        <thead class="bg-tpreto text-secondary sf-thead">
                            <tr>
                                <th>ID</th>
                                <th>Data Compra</th>
                                <th>Fornecedor</th>
                                <th>Status</th>
                                <th class="text-center">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Pendentes)
                            {
                                <tr>
                                    <td>@item.CompraID</td>
                                    <td>@item.CompraData.ToString("dd/MM/yyyy")</td>
                                    <td>@item.Fornecedor?.FornecedorNome</td>
                                    <td><span class="sf-badge sf-badge-baixo">@item.CompraStatus</span></td>
                                    <td class="text-center">
                                        <a asp-action="Detalhes" asp-route-id="@item.CompraID" asp-route-confirmar="false" class="btn btn-primary btn-sm" title="Detalhes">
                                            <i class="bi bi-file-earmark-text-fill"></i>
                                        </a>
                                        <a asp-action="Detalhes" asp-route-id="@item.CompraID" asp-route-confirmar="true" class="btn btn-success btn-sm" title="Confirmar Entrega">
                                            <i class="bi bi-truck"></i>
                                        </a>
                                        <a asp-action="Excluir" asp-route-id="@item.CompraID" class="btn btn-danger btn-sm" title="Cancelar Entrega">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else
        {
            <div class="bg-shadow text-light p-4 rounded-4 mb-4 text-center">
                <i class="bi bi-inbox fs-3 text-secondary"></i>
                <p class="mt-2 mb-0 text-secondary">Nenhum pedido pendente</p>
            </div>
        }

        <div class="bg-shadow text-light p-4 rounded-4 mb-4">
            <h4 class="d-flex justify-content-between align-items-center text-success mb-4 mt-2">
                <span><i class="bi bi-check-circle-fill me-2"></i>Pedidos Concluídos</span>
            </h4>

            <div class="mb-3 d-flex justify-content-center">
                <div class="d-flex align-items-end gap-2 flex-wrap">
                    <div>
                        <label class="form-label small mb-1">Início</label>
                        <input type="date" id="dataInicio" class="form-control form-control-sm bg-shadow text-light">
                    </div>
                    <div>
                        <label class="form-label small mb-1">Fim</label>
                        <input type="date" id="dataFim" class="form-control form-control-sm bg-shadow text-light">
                    </div>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-2" title="Limpar filtros">
                        <i class="bi bi-x-lg"></i>
                    </a>
                </div>
            </div>

            <div style="overflow-x:auto;">
                <table id="tabelaConcluidos" class="table table-hover align-middle mb-0 text-light">
                    <thead class="bg-tpreto text-secondary sf-thead">
                        <tr>
                            <th>ID</th>
                            <th>Data Compra</th>
                            <th>Data Entrega</th>
                            <th>Fornecedor</th>
                            <th>Status</th>
                            <th class="text-center">Detalhes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Concluidas)
                        {
                            <tr>
                                <td>@item.CompraID</td>
                                <td data-order="@item.CompraData.ToString("yyyy-MM-dd")">@item.CompraData.ToString("dd/MM/yyyy")</td>
                                <td>@item.CompraDataEntrega?.ToString("dd/MM/yyyy")</td>
                                <td>@item.Fornecedor?.FornecedorNome</td>
                                <td><span class="sf-badge sf-badge-ok">@item.CompraStatus</span></td>
                                <td class="text-center">
                                    <a class="btn btn-primary btn-sm" asp-action="Detalhes" asp-route-id="@item.CompraID" title="Detalhes">
                                        <i class="bi bi-file-earmark-text-fill"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>

