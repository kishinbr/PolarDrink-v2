@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Polar Drinks - Meu Perfil</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/loja.css" />

</head>
<body>

    @Html.Partial("_HeaderLoja")

    <main class="perfil-container">

        <div class="perfil-topo">
            <h1><i class="bi bi-person-circle"></i> Meu Perfil</h1>
            <p>Acompanhe seus pedidos e consulte seu histórico de compras.</p>
        </div>

        <section class="secao-pedidos">
            <div class="secao-titulo">
                <i class="bi bi-clock-history"></i>
                <h3>Pedidos em Andamento</h3>
            </div>

            <div id="listaPedidosAndamento" class="lista-pedidos">
                <div class="lista-vazia">
                    <i class="bi bi-arrow-repeat"></i>
                    Carregando...
                </div>
            </div>
        </section>

        <section class="secao-pedidos">
            <div class="secao-titulo">
                <i class="bi bi-check-circle"></i>
                <h3>Pedidos Concluídos</h3>
            </div>

            <div id="listaPedidosConcluidos" class="lista-pedidos">
                <div class="lista-vazia">
                    <i class="bi bi-arrow-repeat"></i>
                    Carregando...
                </div>
            </div>
        </section>

    </main>

    <div id="overlayModal" style="display:none; position:fixed; top:0; left:0; right:0; bottom:0; z-index:30;"></div>

    <div id="modalDetalhePedido" style="display:none; position:fixed; top:50%; left:50%; transform:translate(-50%,-50%); z-index:31;">

        <button id="btnFecharModal">
            <i class="bi bi-x-lg"></i>
        </button>

        <div id="conteudoModalPedido"></div>

    </div>

    <script src="~/js/loja/loja-api.js"></script>
    <script src="~/js/loja/loja-header.js"></script>
    <script src="~/js/loja/loja-perfil.js"></script>

</body>
</html>