@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Polar Drinks - Catálogo</title>
</head>
<body>

    <header style="display:flex; align-items:center; gap:20px; padding:10px; border-bottom:1px solid #ccc;">

        <div style="position:relative;">
            <input type="text" id="campoBusca" placeholder="Buscar produtos..." autocomplete="off" />
            <div id="dropdownSugestoes" style="display:none; position:absolute; top:100%; left:0; background:white; border:1px solid #ccc; width:250px; z-index:10;"></div>
        </div>

        <div style="margin-left:auto; display:flex; gap:15px; align-items:center;">
            <a href="/loja/conta" id="linkLogin">Login</a>

            <a href="/loja/carrinho">
                Carrinho <span id="contadorCarrinho" style="display:none;">0</span>
            </a>
        </div>

    </header>
    <div style="display:flex; gap:20px; padding:20px;">

        <aside style="width:200px;">
            <h4>Categorias</h4>
            <div id="listaCategorias">
                <!-- preenchido via JavaScript -->
            </div>
        </aside>

        <main style="flex:1;">
            <div id="gridProdutos" style="display:grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap:15px;">
                <!-- preenchido via JavaScript -->
            </div>
        </main>

    </div>
    <button id="btnAbrirSidecart" style="position:fixed; bottom:20px; right:20px; width:60px; height:60px; border-radius:50%; background:#333; color:white; border:none; font-size:20px; z-index:19;">
        🛒
    </button>
    <div id="sidecartOverlay" style="display:none; position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,0.4); z-index:20;"></div>

    <div id="sidecart" style="display:none; position:fixed; top:0; right:0; width:320px; height:100%; background:white; border-left:1px solid #ccc; z-index:21; padding:15px; overflow-y:auto;">
        <button id="btnFecharSidecart">Fechar</button>

        <h3>Seu Carrinho</h3>

        <div id="sidecartItens">
            <!-- preenchido via JavaScript -->
        </div>

        <p><strong>Total: <span id="sidecartTotal">R$ 0,00</span></strong></p>

        <button id="btnProsseguir">Prosseguir</button>
    </div>

    <script src="~/js/loja/loja-api.js"></script>
    <script src="~/js/loja/loja-catalogo.js"></script>

</body>
</html>
