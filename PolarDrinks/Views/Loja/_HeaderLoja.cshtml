                    </a>
                    <a href="#" id="btnSairMenu">
                        <i class="bi bi-box-arrow-right"></i> Sair
                    </a>
                </div>
            </div>

            <a href="/loja/carrinho" class="header-acao">
                <span class="icone-carrinho">
                    <i class="bi bi-cart3"></i>
                    <span id="contadorCarrinho" class="contador-carrinho" style="display:none;">0</span>
                </span>
                <span class="texto-carrinho">Carrinho</span>
            </a>

        </div>
    </div>
</header>

<div id="sidecartOverlay" style="display:none; position:fixed; top:0; left:0; right:0; bottom:0; z-index:2000;"></div>

<div id="sidecart" style="display:none; position:fixed; top:0; right:0; height:100%; z-index:2001; overflow-y:auto;">

