            <span>Polar <strong>Drinks</strong></span>
        </a>

        <div id="areaBusca" class="area-busca" style="display:none;">
            <i class="bi bi-search"></i>
            <input type="text" id="campoBusca" placeholder="Buscar produtos..." autocomplete="off" />
            <div id="dropdownSugestoes"></div>
        </div>

        <div class="header-acoes">

            <div id="areaConta" class="area-conta">
                <a href="/loja/conta" id="linkLogin" class="header-acao">
