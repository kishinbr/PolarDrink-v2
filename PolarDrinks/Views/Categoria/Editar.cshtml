@model PolarDrinks.Models.Loja.CategoriaModel
@{
    ViewData["title"] = "Editar Categoria";
}
<div class="tema-dark">
    <div class="container-fluid px-3 px-lg-4 py-4" style="max-width: 1400px;">

        <div class="bg-shadow text-light p-4 rounded-4 mb-3 d-flex align-items-center gap-3">
            <div class="sf-icon-badge" style="background:linear-gradient(135deg,#f59e0b,#d97706); box-shadow:0 8px 20px -8px rgba(245,158,11,.8);">
                <i class="bi bi-pencil-square fs-4 text-white"></i>
            </div>
            <div>
                <h1 class="m-0 fs-3 fw-bold">Editar Categoria</h1>
            </div>
        </div>

        <div class="bg-shadow p-4 rounded-4 mx-auto">
            <form method="post">
                <input type="hidden" asp-for="CategoriaID" />

                <div class="mb-4">
                    <label class="form-label text-light">Nome</label>
                    <input type="text" class="form-control bg-shadow text-light" asp-for="CategoriaNome" maxlength="100">
                    <span asp-validation-for="CategoriaNome" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" asp-for="CategoriaAtiva">
                        <label class="form-check-label text-light">Categoria ativa</label>
                    </div>
                </div>

                <div class="d-flex gap-3 mt-4">
                    <a class="btn btn-outline-light w-50" asp-action="Index" title="Voltar">
                        <i class="bi bi-arrow-left me-1"></i>Voltar
                    </a>
                    <button type="submit" class="btn btn-success w-50" title="Salvar Alterações">
                        <i class="bi bi-check-lg me-1"></i>Salvar Alterações
                    </button>
                </div>
            </form>
        </div>

    </div>
</div>

