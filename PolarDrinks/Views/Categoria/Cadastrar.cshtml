@model PolarDrinks.Models.Loja.CategoriaModel
@{
    ViewData["Title"] = "Cadastrar Categoria";
}

<div class="tema-dark">
    <div class="container-fluid px-3 px-lg-4 py-4" style="max-width:1400px;">

        <div class="bg-shadow text-light p-4 rounded-4 mb-3 d-flex align-items-center gap-3">
            <div class="sf-icon-badge" style="background:linear-gradient(135deg,#3b82f6,#6366f1); box-shadow:0 8px 20px -8px rgba(59,130,246,.8);">
                <i class="bi bi-tags-fill fs-4 text-white"></i>
            </div>
            <div>
                <h1 class="m-0 fs-3 fw-bold">Cadastrar Categoria</h1>
            </div>
        </div>

        <div class="bg-shadow p-4 rounded-4 mx-auto">

            @if (TempData["MensagemSucesso"] != null)
            {
                <div class="bg-shadow text-light p-3 rounded-4 mb-3" role="alert" style="background:rgba(16,185,129,.15) !important; border-left:3px solid #10b981 !important;">
                    <i class="bi bi-check-circle-fill me-2" style="color:#34d399;"></i>
                    @TempData["MensagemSucesso"]
                </div>
            }
            else if (TempData["MensagemErro"] != null)
            {
                <div class="bg-shadow text-light p-3 rounded-4 mb-3" role="alert" style="background:rgba(239,68,68,.15) !important; border-left:3px solid #ef4444 !important;">
                    <i class="bi bi-exclamation-circle-fill me-2" style="color:#f87171;"></i>
                    @TempData["MensagemErro"]
                </div>
            }

            <form method="post">
                <div class="mb-4">
                    <label class="form-label text-light">Nome</label>
                    <input type="text" class="form-control bg-shadow text-light" asp-for="CategoriaNome" placeholder="Nome da Categoria" maxlength="100">
                    <span asp-validation-for="CategoriaNome" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" asp-for="CategoriaAtiva">
                        <label class="form-check-label text-light">Categoria ativa</label>
                    </div>
                </div>

                <div class="d-flex gap-3 mt-4">
                    <a class="btn btn-outline-light w-50" asp-controller="Categoria" asp-action="Index" title="Voltar">
                        <i class="bi bi-arrow-left me-1"></i>Voltar
                    </a>
                    <button type="submit" class="btn btn-success w-50" title="Cadastrar">
                        <i class="bi bi-plus-lg me-1"></i>Cadastrar
                    </button>
                </div>
            </form>

        </div>

    </div>
</div>

