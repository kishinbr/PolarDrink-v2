@model IEnumerable<MovimentacaoEstoqueModel>

@{
    ViewData["Title"] = "Movimentações do Estoque";
}

<div class="tema-dark">
    <div class="container-fluid px-3 px-lg-4 py-4" style="max-width: 1400px;">

        <div class="bg-shadow text-light p-4 rounded-4 mb-3">

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">

                <div class="d-flex align-items-center gap-3">
                    <div class="sf-icon-badge"
                         style="background:linear-gradient(135deg,#3b82f6,#6366f1);box-shadow:0 8px 20px -8px rgba(59,130,246,.8);">
                        <i class="bi bi-arrow-left-right fs-4 text-white"></i>
                    </div>

                    <div>
                        <h1 class="m-0 fs-3 fw-bold">Histórico de Movimentações</h1>
                    </div>
                </div>

            </div>

            <div class="position-relative mb-3">

                <i class="bi bi-search position-absolute text-secondary"
                   style="left:14px;top:50%;transform:translateY(-50%);z-index:2;"></i>

                <input type="text"
                       id="buscaProduto"
                       class="form-control bg-tpreto text-light border-0 ps-5 py-2 rounded-3"
                       placeholder="Digite o nome ou código do produto"
                       autocomplete="off"
                       maxlength="100"
                       style="box-shadow:none;">

                <div id="listaSugestoes"
                     class="list-group position-absolute w-100"
                     style="z-index:1000;">
                </div>

            </div>

            @if (ViewBag.ProdutoSelecionado != null)
            {
                <div class="bg-tpreto text-light p-3 rounded-4">

                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">

                        <div>
                            <div class="text-secondary" style="font-size:.78rem;">
                                Produto selecionado
                            </div>

                            <div class="fw-semibold mt-1">
                                @ViewBag.ProdutoSelecionado.ProdutoNome
                            </div>
                        </div>

                        <div class="text-center">

                            <div class="text-secondary" style="font-size:.78rem;">
                                Estoque Atual / Mínimo
                            </div>

                            @if (ViewBag.ProdutoSelecionado.ProdutoQtdEstoque <= ViewBag.ProdutoSelecionado.ProdutoEstoqueMinimo)
                            {
                                <span class="sf-badge sf-badge-baixo mt-1">
                                    @ViewBag.ProdutoSelecionado.ProdutoQtdEstoque / @ViewBag.ProdutoSelecionado.ProdutoEstoqueMinimo
                                </span>
                            }
                            else
                            {
                                <span class="sf-badge sf-badge-ok mt-1">
                                    @ViewBag.ProdutoSelecionado.ProdutoQtdEstoque / @ViewBag.ProdutoSelecionado.ProdutoEstoqueMinimo
                                </span>
                            }

                        </div>

                    </div>

                </div>
            }

        </div>

        <div class="bg-shadow text-light p-3 rounded-4 overflow-hidden">

            <div class="table-responsive">

                <table id="tabelaMovimentacoes"
                       class="table table-hover align-middle mb-0 text-light">

                    <thead>
                        <tr class="bg-tpreto text-secondary sf-thead">
                            <th class="py-3 ps-4">COD Movi</th>
                            <th class="py-3">Data</th>
                            <th class="py-3 text-center">Tipo</th>
                            <th class="py-3 text-center">QTD</th>
                            <th class="py-3 text-center">COD Venda/Compra</th>
                            <th class="py-3">Responsável</th>
                            <th class="py-3 pe-4">Descrição</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var mov in Model)
                            {
                                <tr>

                                    <td class="ps-4" data-order="@mov.MovimentacaoID">

                                        <span class="sf-badge"
                                              style="background:rgba(255,255,255,.08);color:#e7e9ee;border-color:rgba(255,255,255,.08);">
                                            #@mov.MovimentacaoID
                                        </span>

                                    </td>

                                    <td class="sf-num">
                                        @mov.MovimentacaoData.ToString("dd/MM/yyyy HH:mm")
                                    </td>

                                    <td class="text-center">

                                        @if (mov.MovimentacaoTipo == "Entrada")
                                        {
                                            <span class="sf-badge sf-badge-ok">
                                                Reabastecimento
                                            </span>
                                        }
                                        else if (mov.MovimentacaoTipo == "Saida")
                                        {
                                            <span class="sf-badge sf-badge-ativo">
                                                Venda
                                            </span>
                                        }
                                        else if (mov.MovimentacaoTipo == "SaidaOnline")
                                        {
                                            <span class="sf-badge"
                                                  style="background:rgba(6,182,212,.14);color:#22d3ee;border-color:rgba(6,182,212,.3);">
                                                Venda Online
                                            </span>
                                        }
                                        else if (mov.MovimentacaoTipo == "Cancelamento")
                                        {
                                            <span class="sf-badge sf-badge-zerado">
                                                Cancelamento
                                            </span>
                                        }
                                        else if (mov.MovimentacaoTipo == "CancelamentoOnline")
                                        {
                                            <span class="sf-badge sf-badge-zerado">
                                                Cancelamento Online
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="sf-badge sf-badge-baixo">
                                                Edição
                                            </span>
                                        }

                                    </td>

                                    <td class="text-center sf-num">

                                        @if (mov.MovimentacaoTipo == "Entrada")
                                        {
                                            <span class="text-success fw-semibold">
                                                +@mov.MovimentacaoQtd
                                            </span>
                                        }
                                        else if (mov.MovimentacaoTipo == "Saida" || mov.MovimentacaoTipo == "SaidaOnline")
                                        {
                                            <span class="text-danger fw-semibold">
                                                -@mov.MovimentacaoQtd
                                            </span>
                                        }
                                        else
                                        {
                                            if (mov.MovimentacaoQtd > 0)
                                            {
                                                <span class="text-success fw-bold">
                                                    +@mov.MovimentacaoQtd
                                                </span>
                                            }
                                            else if (mov.MovimentacaoQtd < 0)
                                            {
                                                <span class="text-danger fw-bold">
                                                    @mov.MovimentacaoQtd
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-secondary">
                                                    0
                                                </span>
                                            }
                                        }

                                    </td>

                                    <td class="text-center"
                                        data-order="@(mov.ItemVenda != null
                                            ? mov.ItemVenda.VendaID
                                            : mov.ItemCompra != null
                                            ? mov.ItemCompra.CompraID
                                            : mov.ItemPedido != null
                                            ? mov.ItemPedido.PedidoID
                                            : 0)">

                                        @if (mov.ItemVenda != null)
                                        {
                                            <span class="sf-badge sf-badge-ativo">
                                                #@mov.ItemVenda.VendaID
                                            </span>
                                        }
                                        else if (mov.ItemCompra != null)
                                        {
                                            <span class="sf-badge sf-badge-ok">
                                                #@mov.ItemCompra.CompraID
                                            </span>
                                        }
                                        else if (mov.ItemPedido != null)
                                        {
                                            <span class="sf-badge"
                                                  style="background:rgba(6,182,212,.14);color:#22d3ee;border-color:rgba(6,182,212,.3);">
                                                #@mov.ItemPedido.PedidoID
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-secondary">
                                                -
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        @if (mov.ItemPedido != null)
                                        {
                                            @(mov.ItemPedido.Pedido?.UsuarioSeparou?.UsuarioNome ?? "-")
                                        }
                                        else
                                        {
                                            @mov.Usuario?.UsuarioNome
                                        }

                                    </td>

                                    <td class="pe-4"
                                        title="@mov.MovimentacaoDescricao">

                                        <span class="d-inline-block text-truncate"
                                              style="max-width:220px;">

                                            @(mov.MovimentacaoDescricao != null && mov.MovimentacaoDescricao.Length > 20
                                                ? mov.MovimentacaoDescricao.Substring(0, 20) + "..."
                                                : mov.MovimentacaoDescricao)

                                        </span>

                                    </td>

                                </tr>
                            }
                        }
                    </tbody>

                </table>

            </div>

        </div>

    </div>
</div>

@section Scripts {
    <script>
        const produtos = @Html.Raw(Json.Serialize(ViewBag.Produtos));

        const buscaInput = document.getElementById("buscaProduto");
        const lista = document.getElementById("listaSugestoes");

        function renderLista(filtro = "") {

            lista.innerHTML = "";

            const filtrados = produtos
                .filter(p =>
                    p.produtoNome.toLowerCase().includes(filtro) ||
                    p.produtoCodBarra.toLowerCase().includes(filtro)
                )
                .slice(0, 8);

            filtrados.forEach(p => {

                const item = document.createElement("a");

                item.classList.add(
                    "list-group-item",
                    "list-group-item-action"
                );

                item.innerHTML = `
                    <div style="display:flex; justify-content:space-between;">
                        <span>${p.produtoNome} [${p.produtoCodBarra}]</span>
                        <span>${p.produtoQtdEstoque} QTD</span>
                    </div>
                `;

                item.onclick = () => {
                    window.location.href = `/Estoque/Movimentacoes?produtoId=${p.produtoID}`;
                };

                lista.appendChild(item);
            });
        }

        buscaInput.addEventListener("focus", () =>
            renderLista(buscaInput.value.toLowerCase())
        );

        buscaInput.addEventListener("input", () =>
            renderLista(buscaInput.value.toLowerCase())
        );

        document.addEventListener("click", e => {

            if (!buscaInput.contains(e.target) &&
                !lista.contains(e.target)) {

                lista.innerHTML = "";
            }

        });

        $(document).ready(function () {

            $('#tabelaMovimentacoes').DataTable({
                pageLength: 10,
                lengthMenu: [10, 20, 30],
                scrollX: true,
                scrollCollapse: true,
                paging: true,
                order: [],

                columnDefs: [
                    { orderable: false, targets: [5] },
                    { className: "text-center", targets: [4] }
                ],

                language: {
                    "decimal": "",
                    "emptyTable": "Movimentações não encontradas",
                    "info": "Mostrando de _START_ a _END_ de um total de _TOTAL_ movimentações",
                    "infoEmpty": "Mostrando de 0 a 0 de 0 movimentações",
                    "infoFiltered": "(filtrado de _MAX_ movimentações no total)",
                    "thousands": ",",
                    "lengthMenu": "Mostrar _MENU_ movimentações",
                    "loadingRecords": "Carregando...",
                    "search": "Procurar:",
                    "zeroRecords": "Movimentação não encontrada",

                    "paginate": {
                        "first": "Primeiro",
                        "last": "Último",
                        "next": "Próximo",
                        "previous": "Anterior"
                    },

                    "aria": {
                        "orderable": "Ordenar por esta coluna",
                        "orderableReverse": "Ordem reversa desta coluna"
                    }
                }
            });

            setTimeout(function () {

                $(".alert").fadeOut("slow", function () {
                    $(this).alert('close');
                });

            }, 3000);

        });
    </script>
}

