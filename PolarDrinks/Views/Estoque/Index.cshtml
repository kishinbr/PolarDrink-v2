@{
    ViewData["Title"] = "Estoque";
}

@model IEnumerable<ProdutoModel>
@using System.Globalization

<div class="tema-dark">
    <div class="container-fluid px-3 px-lg-4 py-4" style="max-width: 1400px;">

        <div class="bg-shadow text-light p-4 rounded-4 mb-3 d-flex flex-wrap justify-content-between align-items-center gap-3">

            <div class="d-flex align-items-center gap-3">
                <div class="sf-icon-badge" style="background: linear-gradient(135deg,#3b82f6,#6366f1); box-shadow: 0 8px 20px -8px rgba(59,130,246,.8);">
                    <i class="bi bi-box-seam-fill fs-4 text-white"></i>
                </div>

                <div>
                    <h1 class="m-0 fs-3 fw-bold">Estoque de Produtos</h1>
                </div>
            </div>

            @if (Context.Session.GetString("Perfil") == "Admin")
            {
                <a class="btn text-white fw-semibold px-3 py-2 rounded-3 border-0"
                   style="background: linear-gradient(135deg,#10b981,#059669);"
                   asp-controller="Estoque"
                   asp-action="Cadastrar"
                   data-bs-toggle="tooltip"
                   title="Cadastrar">
                    <i class="bi bi-file-earmark-plus-fill me-2"></i>Cadastrar novo Produto
                </a>
            }
        </div>

        @if (TempData["MensagemSucesso"] != null)
        {
            <div class="alert border-0 text-light rounded-3 mb-3"
                 style="background: rgba(16,185,129,.15); border-left: 3px solid #10b981 !important;"
                 role="alert">
                <i class="bi bi-check-circle-fill me-2" style="color:#34d399;"></i>
                @TempData["MensagemSucesso"]
            </div>
        }
        else if(TempData["MensagemErro"] != null)
        {
            <div class="alert border-0 text-light rounded-3 mb-3"
                 style="background: rgba(239,68,68,.15); border-left: 3px solid #ef4444 !important;"
                 role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2" style="color:#f87171;"></i>
                @TempData["MensagemErro"]
            </div>
        }

        <div class="bg-shadow text-light p-3 rounded-4 overflow-hidden">

            <div class="table-responsive">

                <table id="Produtos" class="table table-hover align-middle mb-0 text-light">

                    <thead>
                        <tr class="bg-tpreto text-secondary sf-thead">
                            <th class="py-3 ps-4" style="width: 15%;">Nome</th>
                            <th class="py-3 text-center" style="width: 15%;">Cod Barra</th>
                            <th class="py-3" style="width: 15%;">Descrição</th>
                            <th class="py-3 text-end" style="width: 10%;">P. Custo</th>
                            <th class="py-3 text-end" style="width: 10%;">P. Venda</th>
                            <th class="py-3 text-center" style="width: 10%;">Qtd / Mín</th>
                            <th class="py-3 text-center" style="width: 5%;">Promoção</th>
                            <th class="py-3 text-center" style="width: 15%;">Status</th>

                            @if (Context.Session.GetString("Perfil") == "Admin")
                            {
                                <th class="py-3 text-center pe-4" style="width: 10%;">Edição</th>
                            }
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null)
                        {
                            @foreach (var produto in Model)
                            {
                                <tr>

                                    <td class="ps-4 fw-semibold">
                                        @produto.ProdutoNome
                                    </td>

                                    <td class="text-center text-secondary sf-num">
                                        @produto.ProdutoCodBarra
                                    </td>

                                    <td class="text-secondary" style="max-width:220px;">
                                        <span class="d-inline-block text-truncate" style="max-width:200px;">
                                            @(produto.ProdutoDescricao != null && produto.ProdutoDescricao.Length > 20
                                                ? produto.ProdutoDescricao.Substring(0, 20) + "..."
                                                : produto.ProdutoDescricao)
                                        </span>
                                    </td>

                                    <td class="text-end sf-num">
                                        @("R" + produto.ProdutoPrecoCusto.GetValueOrDefault(0).ToString("C"))
                                    </td>

                                    <td class="text-end fw-semibold sf-num">
                                        @("R" + produto.ProdutoPrecoVenda.GetValueOrDefault(0).ToString("C"))
                                    </td>

                                    <td class="text-center" data-order="@produto.ProdutoQtdEstoque.GetValueOrDefault(0)">

                                        @{
                                            var atual = produto.ProdutoQtdEstoque.GetValueOrDefault(0);
                                            var minimo = produto.ProdutoEstoqueMinimo;

                                            string classe = "";

                                            if (atual == 0)
                                            {
                                                classe = "sf-badge sf-badge-zerado";
                                            }
                                            else if (atual <= minimo)
                                            {
                                                classe = "sf-badge sf-badge-baixo";
                                            }
                                            else
                                            {
                                                classe = "sf-badge sf-badge-ok";
                                            }
                                        }

                                        <span class="@classe">
                                            @($"{atual}/{minimo}")
                                        </span>

                                    </td>

                                    <td class="text-center">

                                        @if (produto.ProdutoPromocao > 0)
                                        {
                                            <span class="fw-semibold" style="color:#34d399;">
                                                @produto.ProdutoPromocao.ToString("0.#")%
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-secondary">-</span>
                                        }

                                    </td>

                                    <td class="text-center">

                                        @if (produto.ProdutoAtivo)
                                        {
                                            <span class="sf-badge sf-badge-ativo">
                                                Disponível
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="sf-badge sf-badge-inativo">
                                                Indisponível
                                            </span>
                                        }

                                    </td>

                                    @if (Context.Session.GetString("Perfil") == "Admin")
                                    {
                                        <td class="text-center pe-4">

                                            <div class="d-inline-flex gap-2">

                                                <a class="btn btn-sm border-0 text-white sf-btn-edit"
                                                   asp-controller="Estoque"
                                                   asp-action="Editar"
                                                   asp-route-id="@produto.ProdutoID"
                                                   data-bs-toggle="tooltip"
                                                   title="Edição completa">
                                                    <i class="bi bi-pencil-square"></i>
                                                </a>

                                                <a class="btn btn-sm border-0 text-white btn-edicao-rapida sf-btn-promo"
                                                   data-bs-toggle="modal"
                                                   data-bs-target="#edicaoRapidaModal"
                                                   data-id="@produto.ProdutoID"
                                                   data-preco="@produto.ProdutoPrecoVenda"
                                                   data-promocao="@produto.ProdutoPromocao"
                                                   title="Promoção">
                                                    <i class="bi bi-percent"></i>
                                                </a>

                                            </div>

                                        </td>
                                    }

                                </tr>
                            }
                        }
                    </tbody>

                </table>

            </div>
        </div>
    </div>
</div>

<!-- Edição Rápida -->
<div class="modal fade" id="edicaoRapidaModal" tabindex="-1">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content bg-shadow text-light rounded-4 border-0">

            <div class="modal-header border-0">

                <h5 class="modal-title fw-bold">
                    <i class="bi bi-percent me-2" style="color:#a78bfa;"></i>
                    Promoção Rápida do Produto
                </h5>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body">

                <form id="formEdicaoRapida"
                      method="post"
                      asp-controller="Estoque"
                      asp-action="EdicaoRapida">

                    <input type="hidden"
                           id="ProdutoID"
                           name="ProdutoID" />

                    <div class="mb-3">

                        <label class="form-label text-secondary"
                               style="font-size:.8rem;">
                            Preço de Venda
                        </label>

                        <input type="text"
                               class="form-control bg-shadow text-light border-0 py-2 rounded-3"
                               id="PrecoVenda"
                               name="ProdutoPrecoVenda">

                    </div>

                    <div class="mb-3">

                        <label class="form-label text-secondary"
                               style="font-size:.8rem;">
                            Promoção (%)
                        </label>

                        <input type="text"
                               class="form-control bg-shadow text-light border-0 py-2 rounded-3"
                               id="Promocao"
                               name="ProdutoPromocao">

                    </div>

                </form>

            </div>

            <div class="modal-footer border-0">

                <button type="button"
                        class="btn border-0 text-light px-3 rounded-3"
                        style="background:rgba(255,255,255,.08);"
                        data-bs-dismiss="modal"
                        title="Voltar">
                    Voltar
                </button>

                <button type="button"
                        class="btn border-0 text-white px-3 rounded-3 fw-semibold"
                        style="background:linear-gradient(135deg,#10b981,#059669);"
                        id="btnConfirmarEdicao"
                        title="Confirmar">
                    Confirmar
                </button>

            </div>

        </div>

    </div>

</div>

@section Scripts {
<script>
document.addEventListener("DOMContentLoaded", function () {

    var modal = document.getElementById('edicaoRapidaModal');
    var btnConfirmar = document.getElementById('btnConfirmarEdicao');

    const precoInput = document.getElementById("PrecoVenda");
    const promocaoInput = document.getElementById("Promocao");

    // ===========================
    // ABRIR MODAL
    // ===========================

    modal.addEventListener('show.bs.modal', function (event) {

        var button = event.relatedTarget;

        var id = button.getAttribute('data-id');
        var preco = button.getAttribute('data-preco');
        var promocao = button.getAttribute('data-promocao');

        modal.querySelector('#ProdutoID').value = id;
        precoInput.value = "";
        promocaoInput.value = "";

        let promocaoFormatada = parseFloat(promocao).toString();

        precoInput.placeholder = preco;
        promocaoInput.placeholder = promocaoFormatada;
    });


    precoInput.addEventListener("input", function () {

        let value = this.value;

        value = value.replace(/[^0-9.]/g, '');

        let parts = value.split('.');

        if (parts.length > 2) {
            value = parts[0] + '.' + parts[1];
        }

        if (value.startsWith('0') && value.length > 1 && value[1] !== '.') {
            value = value.replace(/^0+/, '');
        }

        if (value.includes('.')) {

            let [intPart, decPart] = value.split('.');

            intPart = intPart.substring(0, 5);
            decPart = decPart.substring(0, 2);

            value = intPart + '.' + decPart;

        } else {

            value = value.substring(0, 5);
        }

        this.value = value;
    });


    promocaoInput.addEventListener("input", function () {

        let value = this.value;

        value = value.replace(/[^0-9.]/g, '');

        let parts = value.split('.');

        if (parts.length > 2) {
            value = parts[0] + '.' + parts[1];
        }

        if (value.startsWith('0') && value.length > 1 && value[1] !== '.') {
            value = value.replace(/^0+/, '');
        }

        if (value.includes('.')) {

            let [intPart, decPart] = value.split('.');

            intPart = intPart.substring(0, 3);
            decPart = decPart.substring(0, 1);

            value = intPart + '.' + decPart;

        } else {

            value = value.substring(0, 3);
        }

        let numero = parseFloat(value) || 0;

        if (numero > 100) numero = 100;

        this.value = numero.toString();
    });


    btnConfirmar.addEventListener('click', function () {

        if (!precoInput.value) {
            precoInput.value = precoInput.placeholder || "0.00";
        }

        if (!promocaoInput.value) {
            promocaoInput.value = promocaoInput.placeholder || "0";
        }

        document.getElementById('formEdicaoRapida').submit();
    });

});
</script>
}

