@model ProdutoModel
@{
    ViewData["title"] = "Editar Produto";
}

<div class="container bg-shadow p-5 rounded-5 mt-5">
    <div class="mb-5 text-center">
        <h1 class="text-light">Editar Produto</h1>
    </div>
 
    @if (TempData["MensagemSucesso"] != null)
    {
        <div class="alert bg-success text-light" role="alert">
            @TempData["MensagemSucesso"]
        </div>
    }
    else if (TempData["MensagemErro"] != null)
    {
        <div class="alert bg-danger text-light" role="alert">
            @TempData["MensagemErro"]
        </div>
    }

    <form method="post" asp-action="Editar">
        <input type="hidden" asp-for="ProdutoID" />

        <div class="mb-4">
            <label class="form-label text-light">Nome</label>
            <input type="text" class="form-control bg-shadow text-light" asp-for="ProdutoNome" maxlength="100">
            <span asp-validation-for="ProdutoNome" class="text-danger"></span>
        </div>

        <div class="mb-4">
            <label class="form-label text-light">Descrição</label>
            <textarea class="form-control bg-shadow text-light" asp-for="ProdutoDescricao" rows="3" maxlength="200"></textarea>
            <span asp-validation-for="ProdutoDescricao" class="text-danger"></span>
        </div>

        <div class="row mb-4">
            <div class="col-md-4">
                <label class="form-label text-light">Código de Barras</label>
                <input type="text" class="form-control bg-shadow text-light" asp-for="ProdutoCodBarra" maxlength="13" placeholder="@Model.ProdutoCodBarra">
                <span asp-validation-for="ProdutoCodBarra" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label class="form-label text-light">Preço de Custo</label>
                <input type="text" step="0.01" class="form-control bg-shadow text-light" asp-for="ProdutoPrecoCusto" placeholder="@Model.ProdutoPrecoCusto.GetValueOrDefault(0).ToString("C")">
                <span asp-validation-for="ProdutoPrecoCusto" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label class="form-label text-light">Preço de Venda</label>
                <input type="text" step="0.01" class="form-control bg-shadow text-light" asp-for="ProdutoPrecoVenda" placeholder="@Model.ProdutoPrecoVenda.GetValueOrDefault(0).ToString("C")">
                <span asp-validation-for="ProdutoPrecoVenda" class="text-danger"></span>
            </div>
        </div>

        <div class="row mb-4">
            
            <div class="col-md-6">
                <label class="form-label text-light">Quantidade em Estoque</label>

                <div class="d-flex gap-2">
                    <input asp-for="ProdutoQtdEstoque"
                            class="form-control bg-shadowi text-light"
                            readonly />


                    <button type="button" class="btn bg-secondary"
                            data-bs-toggle="modal"
                            data-bs-target="#ajusteEstoqueModal"
                            title="Ajustar Estoque">
                        Ajustar
                    </button>
                </div>
            </div>

            <div class="col-md-6">
                <label class="form-label text-light">Estoque Mínimo</label>
                <input type="text" class="form-control bg-shadow text-light" asp-for="ProdutoEstoqueMinimo">
                <span asp-validation-for="ProdutoEstoqueMinimo" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-4">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" asp-for="ProdutoAtivo">
                <label class="form-check-label text-light">
                    Produto disponível
                </label>
            </div>
        </div>

        <div class="d-flex gap-3 mt-4">
            <a class="btn btn-primary w-50" asp-action="Index" title="Voltar">Voltar</a>
            <button type="submit" class="btn btn-success w-50" title="Salvar Alterações">Salvar Alterações</button>
            
        </div>

    </form>
</div>

<div class="modal fade" id="ajusteEstoqueModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content bg-shadow text-light">

            <div class="modal-header">
                <h5 class="modal-title">Ajustar Estoque</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <form method="post" asp-action="AjustarEstoque">
                <div class="modal-body">

                    <input type="hidden" name="ProdutoID" value="@Model.ProdutoID" />

                    <div class="mb-3">
                        <label>Quantidade Atual</label>
                        <input type="text" class="form-control bg-shadowi text-light"
                               value="@Model.ProdutoQtdEstoque" disabled>
                    </div>

                    <div class="mb-3">
                        <label>Nova Quantidade</label>
                        <input type="text" class="form-control bg-shadow text-light" name="NovaQuantidade" required maxlength="10">
                    </div>

                    <div class="mb-3">
                        <label>Descrição da alteração</label>
                        <textarea class="form-control bg-shadow text-light" name="Descricao" rows="3" required maxlength="50"></textarea>
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" data-bs-dismiss="modal" title="Voltar">Voltar</button>
                    <button type="submit" class="btn btn-success" title="Confirmar">Confirmar</button>
                </div>
            </form>

        </div>
    </div>
</div>
@section Scripts {
<script>
    // =========================
    // PREÇO (CUSTO E VENDA)
    // =========================
    $(document).on("input", 'input[name="ProdutoPrecoCusto"], input[name="ProdutoPrecoVenda"]', function () {
        let value = this.value;

        value = value.replace(/[^0-9.]/g, '');

        let parts = value.split('.');
        if (parts.length > 2) {
            value = parts[0] + '.' + parts[1];
        }

        if (value.startsWith('0') && value.length > 1 && value[1] !== '.') {
            value = value.replace(/^0+/, '');
        }

        if (value.includes('.')) {
            let [intPart, decPart] = value.split('.');
            intPart = intPart.substring(0, 5);
            decPart = decPart.substring(0, 2);
            value = intPart + '.' + decPart;
        } else {
            value = value.substring(0, 5);
        }

        this.value = value;
    });

    // =========================
    // ESTOQUE MÍNIMO (0 - 9999)
    // =========================
    $(document).on("input", 'input[name="ProdutoEstoqueMinimo"]', function () {
        let value = this.value;

        value = value.replace(/[^0-9]/g, '');
        value = value.substring(0, 4);

        if (value.length > 1) {
            value = value.replace(/^0+/, '');
        }

        this.value = value;
    });

    // =========================
    // CÓDIGO DE BARRAS
    // =========================
    $(document).on("input", 'input[name="ProdutoCodBarra"]', function () {
        this.value = this.value.replace(/[^0-9]/g, '');
    });

    // =========================
    // MODAL - NOVA QUANTIDADE
    // =========================
    $(document).on("input", 'input[name="NovaQuantidade"]', function () {
        let value = this.value;

        value = value.replace(/[^0-9]/g, '');
        value = value.substring(0, 4);

        if (value.length > 1) {
            value = value.replace(/^0+/, '');
        }

        this.value = value;
    });

    
</script>
}