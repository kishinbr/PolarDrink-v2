@{
    ViewData["Title"] = "THE Dashboard";
}
@model PolarDrinks.Models.DashboardViewModel
@using System.Globalization

<div class="servfesta-dash">
    <div class="container-fluid px-3 px-lg-4 py-4">

        <!-- HEADER + SELETOR DE CANAL -->
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
            <div>
                <h6 class="m-0 fw-normal text-secondary">
                    Gestão / <span class="text-light fw-semibold">Dashboard</span>
                </h6>
                <span class="text-secondary" style="font-size:.75rem;" id="dashDate"></span>
            </div>

            <div class="sf-segment" role="tablist" aria-label="Canal de vendas">
                <button type="button" data-ch="presencial" class="active" onclick="sfSetCanal('presencial')">
                    <i class="bi bi-shop"></i> Presencial
                </button>
                <button type="button" data-ch="online" onclick="sfSetCanal('online')">
                    <i class="bi bi-globe2"></i> Online
                </button>
                <button type="button" data-ch="geral" onclick="sfSetCanal('geral')">
                    <i class="bi bi-bar-chart-line"></i> Geral
                </button>
            </div>
        </div>

        <!-- LINHA PRINCIPAL -->
        <div class="row g-3 mb-3">

            <!-- COLUNA ESQUERDA -->
            <div class="col-lg-8 d-flex flex-column gap-3">

                <!-- KPIs FINANCEIROS (trocam por canal) -->
                <div class="row g-3">
                    <div class="col-6 col-xl-4">
                        <div class="card rounded-4 h-100 p-3 bg-shadow">
                            <div class="sf-kpibar mb-2" style="background:#3b82f6;"></div>
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="text-secondary" style="font-size:.78rem;">Total Hoje</span>
                                <span class="sf-chip" id="chipCanal" style="color:#3b82f6;">Presencial</span>
                            </div>
                            <div class="fw-bold" style="font-size:1.3rem; color:#3b82f6;"
                                 data-presencial="R$ @Model.TotalHoje.ToString("N2")"
                                 data-online="R$ @Model.TotalOnlineHoje.ToString("N2")"
                                 data-geral="R$ @Model.TotalCombinadoHoje.ToString("N2")">
                                R$ @Model.TotalHoje.ToString("N2")
                            </div>
                        </div>
                    </div>

                    <div class="col-6 col-xl-4">
                        <div class="card rounded-4 h-100 p-3 bg-shadow">
                            <div class="sf-kpibar mb-2" style="background:#a78bfa;"></div>
                            <div class="text-secondary mb-1" style="font-size:.78rem;">Total Mês</div>
                            <div class="fw-bold" style="font-size:1.3rem; color:#a78bfa;"
                                 data-presencial="R$ @Model.TotalMes.ToString("N2")"
                                 data-online="R$ @Model.TotalOnlineMes.ToString("N2")"
                                 data-geral="R$ @Model.TotalCombinadoMes.ToString("N2")">
                                R$ @Model.TotalMes.ToString("N2")
                            </div>
                        </div>
                    </div>

                    <div class="col-6 col-xl-4">
                        <div class="card rounded-4 h-100 p-3 bg-shadow">
                            <div class="sf-kpibar mb-2" style="background:#22d3ee;"></div>
                            <div class="text-secondary mb-1" style="font-size:.78rem;">Ticket Médio</div>
                            <div class="fw-bold" style="font-size:1.3rem; color:#22d3ee;"
                                 data-presencial="R$ @Model.TicketMedio.ToString("N2")"
                                 data-online="R$ @Model.TicketMedioOnline.ToString("N2")"
                                 data-geral="R$ @Model.TicketMedioCombinado.ToString("N2")">
                                R$ @Model.TicketMedio.ToString("N2")
                            </div>
                        </div>
                    </div>

                    <div class="col-6 col-xl-4">
                        <div class="card rounded-4 h-100 p-3 bg-shadow">
                            <div class="sf-kpibar mb-2" style="background:#34d399;"></div>
                            <div class="text-secondary mb-1" style="font-size:.78rem;">Lucro Hoje</div>
                            <div class="fw-bold" style="font-size:1.3rem; color:#34d399;"
                                 data-presencial="R$ @Model.LucroHoje.ToString("N2")"
                                 data-online="R$ @Model.LucroOnlineHoje.ToString("N2")"
                                 data-geral="R$ @Model.LucroCombinadoHoje.ToString("N2")">
                                R$ @Model.LucroHoje.ToString("N2")
                            </div>
                        </div>
                    </div>

                    <div class="col-6 col-xl-4">
                        <div class="card rounded-4 h-100 p-3 bg-shadow">
                            <div class="sf-kpibar mb-2" style="background:#f59e0b;"></div>
                            <div class="text-secondary mb-1" style="font-size:.78rem;">Lucro Mês</div>
                            <div class="fw-bold" style="font-size:1.3rem; color:#f59e0b;"
                                 data-presencial="R$ @Model.LucroMes.ToString("N2")"
                                 data-online="R$ @Model.LucroOnlineMes.ToString("N2")"
                                 data-geral="R$ @Model.LucroCombinadoMes.ToString("N2")">
                                R$ @Model.LucroMes.ToString("N2")
                            </div>
                        </div>
                    </div>

                    <div class="col-6 col-xl-4">
                        <div class="card rounded-4 h-100 p-3 bg-shadow">
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="sf-kpibar mb-2" style="background:#34d399;"></div>
                                <i class="bi bi-graph-up-arrow" style="color:#34d399;"></i>
                            </div>
                            <div class="text-secondary mb-1" style="font-size:.78rem;">Previsão Amanhã</div>
                            <div class="fw-bold" style="font-size:1.3rem; color:#34d399;"
                                 data-presencial="R$ @Model.PrevisaoAmanha.ToString("N2")"
                                 data-online="R$ @Model.PrevisaoAmanhaOnline.ToString("N2")"
                                 data-geral="R$ @Model.PrevisaoAmanhaCombinada.ToString("N2")">
                                R$ @Model.PrevisaoAmanha.ToString("N2")
                            </div>
                        </div>
                    </div>
                </div>

                <!-- GRÁFICO VENDAS -->
                <div class="card rounded-4 p-3 flex-fill text-light bg-shadow">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                        <h6 class="mb-0 d-flex align-items-center gap-2"><i class="bi bi-activity" style="color:#3b82f6;"></i> Vendas</h6>
                        <div class="btn-group btn-group-sm flex-wrap">
                            <span class="btn btn-outline-primary" id="totalVendasLabel">Quantidade vendas: 0</span>
                            <button class="btn btn-outline-primary filtro-vendas" data-periodo="hoje" onclick="atualizarVendas('hoje')">Hoje</button>
                            <button class="btn btn-outline-primary filtro-vendas" data-periodo="semana" onclick="atualizarVendas('semana')">7d</button>
                            <button class="btn btn-outline-primary filtro-vendas" data-periodo="mes" onclick="atualizarVendas('mes')">30d</button>
                            <button class="btn btn-outline-primary filtro-vendas" data-periodo="ano" onclick="atualizarVendas('ano')">Ano</button>
                        </div>
                    </div>
                    <canvas id="graficoVendas" style="height:300px;"></canvas>
                </div>

                <!-- PARTICIPAÇÃO + OPERAÇÃO ONLINE -->
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="card rounded-4 p-3 h-100 bg-shadow">
                            <div class="d-flex align-items-center gap-2 mb-3">
                                <i class="bi bi-pie-chart-fill" style="color:#a78bfa;"></i>
                                <span class="text-light">Canal de Vendas Mensal</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2" style="font-size:.8rem;">
                                <span style="color:#3b82f6;"><i class="bi bi-shop me-1"></i>Presencial @Model.PercentualPresencialMes%</span>
                                <span style="color:#00BDAE;">@Model.PercentualOnlineMes% Online<i class="bi bi-globe2 ms-1"></i></span>
                            </div>
                            <div class="d-flex rounded-pill overflow-hidden" style="height:14px;">
                                <div style="width:@(Model.PercentualPresencialMes)%; background:linear-gradient(90deg,#2563eb,#3b82f6);"></div>
                                <div style="width:@(Model.PercentualOnlineMes)%; background:linear-gradient(90deg,#00BDAE,#0ea5a0);"></div>
                            </div>
                            <div class="row g-2 mt-3">
                                <div class="col-6">
                                    <div class="bg-tpreto rounded-3 p-2 text-center">
                                        <div class="text-secondary" style="font-size:.65rem;">Combinado Hoje</div>
                                        <div class="fw-semibold text-light">R$ @Model.TotalCombinadoHoje.ToString("N2")</div>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="bg-tpreto rounded-3 p-2 text-center">
                                        <div class="text-secondary" style="font-size:.65rem;">Ticket Combinado</div>
                                        <div class="fw-semibold text-light">R$ @Model.TicketMedioCombinado.ToString("N2")</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="card rounded-4 p-3 h-100 bg-shadow">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <span class="text-light d-flex align-items-center gap-2"><i class="bi bi-truck" style="color:#00BDAE;"></i>  Online</span>
                                <span class="sf-chip" style="color:#00BDAE;">Retirada</span>
                            </div>
                            <div class="row g-2">
                                <div class="col-6">
                                    <div class="bg-tpreto rounded-3 p-2 h-100">
                                        <i class="bi bi-box-arrow-in-down" style="color:#f87171; font-size:14px;"></i>
                                        <div class="text-secondary mt-1" style="font-size:.65rem;">Não-retirada (mês)</div>
                                        <div class="fw-semibold" style="color:#f87171;">@Model.TaxaNaoRetiradaMes%</div>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="bg-tpreto rounded-3 p-2 h-100">
                                        <i class="bi bi-clock-history" style="color:#22d3ee; font-size:14px;"></i>
                                        <div class="text-secondary mt-1" style="font-size:.65rem;">Tempo médio retirada</div>
                                        <div class="fw-semibold" style="color:#22d3ee;">@(Model.TempoMedioRetiradaHoras.HasValue ? Model.TempoMedioRetiradaHoras.Value.ToString("0.0") + "h" : "—")</div>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="bg-tpreto rounded-3 p-2 h-100">
                                        <i class="bi bi-fire" style="color:#f59e0b; font-size:14px;"></i>
                                        <div class="text-secondary mt-1" style="font-size:.65rem;">Horário de pico</div>
                                        <div class="fw-semibold" style="color:#f59e0b;">@(Model.HorarioPicoPedidos.HasValue ? Model.HorarioPicoPedidos + "h" : "—")</div>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="bg-tpreto rounded-3 p-2 h-100">
                                        <i class="bi bi-hourglass-split" style="color:#34d399; font-size:14px;"></i>
                                        <div class="text-secondary mt-1" style="font-size:.65rem;">Fat. por expiração</div>
                                        <div class="fw-semibold" style="color:#34d399;">R$ @Model.FaturamentoPorExpiracaoMes.ToString("N2")</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- COLUNA DIREITA -->
            <div class="col-lg-4 d-flex flex-column gap-3">
                <!-- GRÁFICO PAGAMENTOS -->
                <div class="card rounded-4 p-3 flex-fill bg-shadow">
                    <!-- CARDS PAGAMENTO -->
                    <div class="row g-3 mb-3">
                        <div class="col-12 col-sm-4">

                            <div class="card rounded-4  p-3 bg-shadow">
                                <small class="d-flex align-items-center gap-1" style="color:#00BDAE;"><i class="bi bi-x-diamond" style="color:#00BDAE;"></i> Pix</small>
                                <h5 id="valPix" class="mt-1 mb-0" style="color:#00BDAE; font-size:1rem;"
                                    data-presencial="@("R" + Model.TotalPix.ToString("C"))"
                                    data-online="@("R" + Model.TotalPixOnline.ToString("C"))"
                                    data-geral="@("R" + Model.TotalPixGeral.ToString("C"))">
                                    @("R" + Model.TotalPix.ToString("C"))
                                </h5>
                            </div>
                        </div>
                        <div class="col-12 col-sm-4">
                            <div class="card rounded-4 p-3 bg-shadow">
                                <small style="color:mediumpurple;"><i class="bi bi-credit-card" style="color:mediumpurple;"></i> Cartão</small>
                                <h5 id="valCartao" class="mt-1 mb-0" style="color:mediumpurple; font-size:1rem;"
                                    data-presencial="@("R" + Model.TotalCartao.ToString("C"))"
                                    data-online="@("R" + Model.TotalCartaoOnline.ToString("C"))"
                                    data-geral="@("R" + Model.TotalCartaoGeral.ToString("C"))">
                                    @("R" + Model.TotalCartao.ToString("C"))
                                </h5>
                            </div>
                        </div>
                        <div class="col-12 col-sm-4">
                            <div class="card rounded-4 h-100 p-3 bg-shadow">
                                <small style="color:#198754;"><i class="bi bi-cash" style="color:#198754;"></i> Dinheiro</small>
                                @* <div class="text-secondary" style="font-size:.75rem;"
                                     data-presencial="@Model.QtdDinheiro vendas"
                                     data-online="0 vendas"
                                     data-geral="@Model.QtdDinheiroGeral vendas">
                                    @Model.QtdDinheiro vendas
                                </div> *@
                                <h5 id="valDinheiro" class="mt-1 mb-0" style="color:#198754; font-size:1rem;"
                                    data-presencial="@("R" + Model.TotalDinheiro.ToString("C"))"
                                    data-online="R$ 0,00"
                                    data-geral="@("R" + Model.TotalDinheiroGeral.ToString("C"))">
                                    @("R" + Model.TotalDinheiro.ToString("C"))
                                </h5>
                            </div>
                        </div>
                    </div>


                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">

                        <h6 class="mb-0 text-light d-flex align-items-center gap-2"><i class="bi bi-wallet2" style="color:#f59e0b;"></i> Pagamento</h6>
                        <span class="sf-chip text-secondary m-auto" id="chipProdutos">Presencial</span>
                        <div class="btn-group btn-group-sm flex-wrap">
                            <span class="btn btn-outline-warning" id="qtdPagamentosLabel">Total: 0</span>
                            <button class="btn btn-outline-warning filtro-pagamento" data-periodo="hoje" onclick="atualizarPagamentos('hoje')">Hoje</button>
                            <button class="btn btn-outline-warning filtro-pagamento" data-periodo="semana" onclick="atualizarPagamentos('semana')">7d</button>
                            <button class="btn btn-outline-warning filtro-pagamento" data-periodo="mes" onclick="atualizarPagamentos('mes')">30d</button>
                            <button class="btn btn-outline-warning filtro-pagamento" data-periodo="total" onclick="atualizarPagamentos('total')">Total</button>
                        </div>
                    </div>

                    <div class="d-flex flex-column gap-2 mb-3">
                        <div class="d-flex align-items-center justify-content-between rounded-3 px-3 py-2 bg-tpreto">
                            <div class="d-flex align-items-center gap-2"><span style="width:12px;height:12px;background:#00BDAE;border-radius:3px;"></span><span class="text-light">Pix</span></div>
                            <span class="text-light fw-semibold" id="lblPix">0</span>
                        </div>
                        <div class="d-flex align-items-center justify-content-between rounded-3 px-3 py-2 bg-tpreto">
                            <div class="d-flex align-items-center gap-2"><span style="width:12px;height:12px;background:mediumpurple;border-radius:3px;"></span><span class="text-light">Cartão</span></div>
                            <span class="text-light fw-semibold" id="lblCartao">0</span>
                        </div>
                        <div class="d-flex align-items-center justify-content-between rounded-3 px-3 py-2 bg-tpreto">
                            <div class="d-flex align-items-center gap-2"><span style="width:12px;height:12px;background:#198754;border-radius:3px;"></span><span class="text-light">Dinheiro</span></div>
                            <span class="text-light fw-semibold" id="lblDinheiro">0</span>
                        </div>
                    </div>
                    
                    <div class="d-flex justify-content-center align-items-center flex-fill mt-2">
                        <canvas id="graficoPagamentos" style="max-width:280px; max-height:280px;"></canvas>

                    </div>

                </div>
            </div>
        </div>

        <!-- LINHA INFERIOR -->
        <div class="row g-3">

            <!-- ESTOQUE -->
            <div class="col-6 col-lg-3">
                <div class="card rounded-4 h-100 p-3 bg-shadow">
                    <div class="d-flex align-items-center gap-2 mb-3"><i class="bi bi-box-seam" style="color:#f59e0b;"></i><span class="text-light">Estoque</span></div>
                    <div class="mb-3">
                        <div class="d-flex justify-content-between mb-1" style="font-size:.75rem;"><span class="text-light">Estoque Baixo</span><span style="color:#f59e0b;">@Model.EstoqueBaixo produtos</span></div>
                        <div class="rounded-pill bg-tpreto" style="height:10px;"><div class="rounded-pill" style="height:10px; width:@(Math.Min(Model.EstoqueBaixo * 10, 100))%; background:#f59e0b;"></div></div>
                    </div>
                    <div>
                        <div class="d-flex justify-content-between mb-1" style="font-size:.75rem;"><span class="text-light">Sem Estoque</span><span style="color:#f87171;">@Model.SemEstoque produtos</span></div>
                        <div class="rounded-pill bg-tpreto" style="height:10px;"><div class="rounded-pill" style="height:10px; width:@(Math.Min(Model.SemEstoque * 10, 100))%; background:#f87171;"></div></div>
                    </div>
                </div>
            </div>

            <!-- PRODUTOS (troca por canal) -->
            <div class="col-6 col-lg-3">
                <div class="card rounded-4 h-100 p-3 bg-shadow">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <span class="text-light d-flex align-items-center gap-2"><i class="bi bi-bag-check" style="color:#34d399;"></i> Produtos</span>
                        <span class="sf-chip text-secondary" id="chipProdutos">Presencial</span>
                    </div>
                    <div class="d-flex align-items-center gap-2 flex-wrap rounded-3 mb-2 p-2 bg-tpreto">
                        <span class="text-light flex-grow-1 text-truncate" style="font-size:.82rem;" id="prodVendido"
                              data-presencial="@(Model.ProdutoMaisVendido ?? "—")"
                              data-online="@(Model.ProdutoMaisVendidoOnline ?? "—")"
                              data-geral="@(Model.ProdutoMaisVendidoTotal ?? "—")">@(Model.ProdutoMaisVendido ?? "—")</span>
                        <div class="d-flex align-items-center gap-1" style="color:#34d399; font-size:.75rem;"><span>Vendido</span><i class="bi bi-trophy-fill" style="color:#34d399;"></i></div>
                    </div>
                    <div class="d-flex align-items-center gap-2 flex-wrap rounded-3 mb-2 p-2 bg-tpreto">
                        <span class="text-light flex-grow-1 text-truncate" style="font-size:.82rem;" id="prodLucrativo"
                              data-presencial="@(Model.ProdutoMaisLucrativo ?? "—")"
                              data-online="@(Model.ProdutoMaisLucrativoOnline ?? "—")"
                              data-geral="@(Model.ProdutoMaisLucrativoTotal ?? "—")">@(Model.ProdutoMaisLucrativo ?? "—")</span>
                        <div class="d-flex align-items-center gap-1" style="color:#34d399; font-size:.75rem;"><span>Lucrativo</span><i class="bi bi-currency-dollar" style="color:#34d399;"></i></div>
                    </div>
                </div>
            </div>

            <!-- EM ALTA TOP 3 -->
            <div class="col-6 col-lg-3">
                <div class="card rounded-4 h-100 p-3 bg-shadow">
                    <div class="d-flex align-items-center gap-2 mb-3"><i class="bi bi-fire" style="color:#f87171;"></i><span class="text-light">Em Alta</span></div>
                    @if (Model.Top3ProdutosAlta != null && Model.Top3ProdutosAlta.Any())
                    {
                        string[] cores = { "#f59e0b", "#9ca3af", "#cd7f32" };
                        string[] icones = { "bi-1-square", "bi-2-square", "bi-3-square" };
                        for (int i = 0; i < Model.Top3ProdutosAlta.Count && i < 3; i++)
                        {
                            <div class="d-flex align-items-center gap-2 rounded-3 mb-2 p-2 bg-tpreto">
                                <i class="bi @icones[i]" style="color:@cores[i]; font-size:14px;"></i>
                                <span class="text-light flex-fill text-truncate" style="font-size:.8rem;">@Model.Top3ProdutosAlta[i]</span>
                                <i class="bi bi-arrow-up-short" style="color:#34d399; font-size:16px;"></i>
                            </div>
                        }
                    }
                    else
                    {
                        <small class="text-secondary">Dados insuficientes</small>
                    }
                </div>
            </div>

            <!-- CANCELAMENTOS (troca por canal) -->
            <div class="col-6 col-lg-3">
                <div class="card rounded-4 h-100 p-3 bg-shadow">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <span class="text-light d-flex align-items-center gap-2"><i class="bi bi-x-circle" style="color:#f87171;"></i> Cancelamentos</span>
                        <span class="sf-chip text-secondary" id="chipCancel">Presencial</span>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-4">
                            <div class="p-2 rounded-3 bg-tpreto text-center">
                                <div class="text-secondary" style="font-size:.65rem;">Hoje</div>
                                <div class="text-light fw-semibold" id="cancelHoje"
                                     data-presencial="@Model.CanceladosHoje" data-online="@Model.CanceladosOnlineHoje" data-geral="@Model.CanceladosTotalHoje">
                                    @Model.CanceladosHoje
                                </div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-2 rounded-3 bg-tpreto text-center">
                                <div class="text-secondary" style="font-size:.65rem;">Semana</div>
                                <div class="text-light fw-semibold" id="cancelSemana"
                                     data-presencial="@Model.CanceladosSemana" data-online="@Model.CanceladosOnlineSemana" data-geral="@Model.CanceladosTotalSemana">
                                    @Model.CanceladosSemana
                                </div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-2 rounded-3 bg-tpreto text-center">
                                <div class="text-secondary" style="font-size:.65rem;">Mês</div>
                                <div class="text-light fw-semibold" id="cancelMes"
                                     data-presencial="@Model.CanceladosMes" data-online="@Model.CanceladosOnlineMes" data-geral="@Model.CanceladosTotalMes">
                                    @Model.CanceladosMes
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="p-2 rounded-3 bg-tpreto">
                        <div class="text-danger" style="font-size:.7rem;">Produto mais cancelado</div>
                        <div class="text-light fw-semibold text-truncate" id="prodCancelado"
                             data-presencial="@(Model.ProdutoMaisCancelado ?? "—")"
                             data-online="@(Model.ProdutoMaisCanceladoOnline ?? "—")"
                             data-geral="@(Model.ProdutoMaisCanceladoTotal ?? "—")">
                            @(Model.ProdutoMaisCancelado ?? "—")
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- GIRO DE ESTOQUE LENTO -->
        <div class="row g-3 mt-0">
            <div class="col-12">
                <div class="card rounded-4 p-3 bg-shadow">
                    <div class="d-flex align-items-center gap-2 mb-3"><i class="bi bi-arrow-repeat" style="color:#f59e0b;"></i><span class="text-light">Giro de Estoque</span></div>
                    <div class="row g-2">
                        @foreach (var g in Model.ProdutosGiroLento)
                        {
                            <div class="col-6 col-md-4 col-xl">
                                <div class="bg-tpreto rounded-3 p-3 h-100">
                                    <div class="text-light text-truncate mb-2" style="font-size:.8rem;">@g.ProdutoNome</div>
                                    <div class="d-flex justify-content-between align-items-end">
                                        <div><div class="text-secondary" style="font-size:.6rem;">Estoque atual</div><div class="fw-semibold text-light">@g.EstoqueAtual</div></div>
                                        <div class="text-end">
                                            <div class="text-secondary" style="font-size:.6rem;">Giro</div>
                                            <div class="fw-semibold" style="color:@(g.GiroDias.HasValue ? "#f59e0b" : "#f87171");">@(g.GiroDias.HasValue ? g.GiroDias.Value.ToString("0.0") + "d" : "sem venda")</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<script>
    // Data no header
    document.getElementById("dashDate").textContent =
        new Date().toLocaleDateString("pt-BR", { weekday: "long", day: "2-digit", month: "long", year: "numeric" });

    // Alterna todos os elementos que têm data-presencial / data-online / data-geral
        function sfSetCanal(canal) {
        document.querySelectorAll('.sf-segment button').forEach(b => b.classList.toggle('active', b.dataset.ch === canal));
        const rotulo = { presencial: 'Presencial', online: 'Online', geral: 'Geral' }[canal];
        ['chipCanal', 'chipProdutos', 'chipCancel'].forEach(id => { const el = document.getElementById(id); if (el) el.textContent = rotulo; });
        document.querySelectorAll('[data-' + canal + ']').forEach(el => {
            const v = el.getAttribute('data-' + canal);
            if (v !== null) el.textContent = v;
        });

        if (window.atualizarCanalPagamentos) {
            window.atualizarCanalPagamentos(canal);
        }
    }

    // Dados dos gráficos vindos do Model (mantém sua estrutura atual)
        window.dashData = {
        pagamentosPorCanal: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PagamentosPorCanalEPeriodo)),
        vendas: {
            hoje:   @Html.Raw(Json.Serialize(Model.VendasHojeLista)),
            semana: @Html.Raw(Json.Serialize(Model.VendasSemana)),
            mes:    @Html.Raw(Json.Serialize(Model.VendasMesGrafico)),
            ano:    @Html.Raw(Json.Serialize(Model.VendasAno))
            }
    };
</script>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="~/js/dash.js"></script>
