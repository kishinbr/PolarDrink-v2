@model IEnumerable<FornecedorModel>
@{
    ViewData["Title"] = "Fornecedores";
}

<div class="tema-dark">
    <div class="container-fluid px-3 px-lg-4 py-4" style="max-width:1400px;">

        <div class="bg-shadow text-light p-4 rounded-4 mb-3 d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="sf-icon-badge" style="background:linear-gradient(135deg,#3b82f6,#6366f1); box-shadow:0 8px 20px -8px rgba(59,130,246,.8);">
                    <i class="bi bi-truck-front-fill fs-4 text-white"></i>
                </div>
                <div>
                    <h1 class="m-0 fs-3 fw-bold">Fornecedores</h1>
                </div>
            </div>

            @if (Context.Session.GetString("Perfil") == "Admin")
            {
                <a class="btn text-white fw-semibold px-3 py-2 rounded-3 border-0" style="background: linear-gradient(135deg,#10b981,#059669);"
                   asp-controller="Fornecedor"
                   asp-action="Cadastrar"
                   data-bs-toggle="tooltip"
                   title="Cadastrar">

                    <i class="bi bi-file-earmark-plus-fill me-2"></i>
                    Cadastrar novo Fornecedor
                </a>

            }
        </div>

        @if (TempData["MensagemSucesso"] != null)
        {
            <div class="bg-shadow text-light p-3 rounded-4 mb-3" style="background:rgba(16,185,129,.15) !important; border-left:3px solid #10b981 !important;">
                <i class="bi bi-check-circle-fill me-2" style="color:#34d399;"></i>
                @TempData["MensagemSucesso"]
            </div>
        }
        else if (TempData["MensagemErro"] != null)
        {
            <div class="bg-shadow text-light p-3 rounded-4 mb-3" style="background:rgba(239,68,68,.15) !important; border-left:3px solid #ef4444 !important;">
                <i class="bi bi-exclamation-circle-fill me-2" style="color:#f87171;"></i>
                @TempData["MensagemErro"]
            </div>
        }

        <div class="bg-shadow text-light p-4 rounded-4">
            <div class="table-responsive">
                <table id="Fornecedores" class="table table-hover align-middle mb-0 text-light">
                    <thead class="bg-tpreto text-secondary sf-thead">
                        <tr>
                            <th style="width:15%;">Nome</th>
                            <th style="width:15%;">CNPJ</th>
                            <th style="width:15%;">Telefone</th>
                            <th style="width:15%;">Email</th>
                            <th style="width:15%;">CEP</th>
                            <th style="width:15%;">Cidade</th>
                            <th style="width:5%;">UF</th>
                            <th style="width:5%;" class="text-center">Status</th>
                            @if (Context.Session.GetString("Perfil") == "Admin")
                            {
                                <th style="width:5%;" class="text-center">Ações</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var fornecedor in Model)
                            {
                                <tr>
                                    <td>@fornecedor.FornecedorNome</td>
                                    <td>@fornecedor.FornecedorCNPJ</td>
                                    <td>@fornecedor.FornecedorTelefone</td>
                                    <td>@fornecedor.FornecedorEmail</td>
                                    <td>@fornecedor.FornecedorCEP</td>
                                    <td>@fornecedor.FornecedorCidade</td>
                                    <td>@fornecedor.FornecedorEstado</td>
                                    <td class="text-center">
                                        @if (fornecedor.FornecedorAtivo)
                                        {
                                            <span class="sf-badge sf-badge-ok">Disponível</span>
                                        }
                                        else
                                        {
                                            <span class="sf-badge sf-badge-inativo">Indisponível</span>
                                        }
                                    </td>
                                    @if (Context.Session.GetString("Perfil") == "Admin")
                                    {
                                        <td class="text-center">
                                            <a class="btn btn-warning btn-sm" asp-action="Editar" asp-route-id="@fornecedor.FornecedorID" title="Editar fornecedor">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                        </td>
                                    }
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>

