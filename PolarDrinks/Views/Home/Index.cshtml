@{
    ViewData["Title"] = "Início";
    var ehAdmin = Context.Session.GetString("Perfil") == "Admin";
}

<div class="pagina">

    <section class="hero-painel">
        <div>
            <span class="hero-etiqueta">
                <span id="ice-badge" class="hero-gelo"><i class="bi bi-snow2"></i></span>
                Painel da equipe
            </span>

            <h1>Bem-vindo ao<br />Polar Drinks!</h1>
            <p>Sua plataforma de controle de estoque e vendas de bebidas e produtos.</p>

            <a class="botao botao-branco" asp-controller="Venda" asp-action="Cadastrar">
                Nova venda <i class="bi bi-arrow-right"></i>
            </a>
        </div>

        <div id="bear-zone" class="hero-urso">
            <img id="bear-img" src="/img/polaria.png" alt="Polaria, o mascote do Polar Drinks" />
        </div>
    </section>

    <div class="atalhos">
        <a class="atalho" asp-controller="Venda" asp-action="Cadastrar">
            <span class="icone-atalho"><i class="bi bi-cart-check"></i></span>
            <b>Nova venda</b>
            <small>Registrar uma venda no balcão</small>
            <span class="ir">Abrir <i class="bi bi-arrow-right"></i></span>
        </a>

        <a class="atalho" asp-controller="PedidoOnline" asp-action="Index">
            <span class="icone-atalho"><i class="bi bi-bag-check"></i></span>
            <b>Pedidos online</b>
            <small>Separar e entregar os pedidos da loja</small>
            <span class="ir">Abrir <i class="bi bi-arrow-right"></i></span>
        </a>

        <a class="atalho" asp-controller="Estoque" asp-action="Index">
            <span class="icone-atalho"><i class="bi bi-box-seam"></i></span>
            <b>Produtos</b>
            <small>Consultar preços e estoque</small>
            <span class="ir">Abrir <i class="bi bi-arrow-right"></i></span>
        </a>

        @if (ehAdmin)
        {
            <a class="atalho" asp-controller="Dashboard" asp-action="Index">
                <span class="icone-atalho"><i class="bi bi-graph-up"></i></span>
                <b>Dashboard</b>
                <small>Indicadores e relatórios</small>
                <span class="ir">Abrir <i class="bi bi-arrow-right"></i></span>
            </a>
        }
        else
        {
            <a class="atalho" asp-controller="Fornecedor" asp-action="Index">
                <span class="icone-atalho"><i class="bi bi-truck"></i></span>
                <b>Fornecedores</b>
                <small>Contatos de quem abastece a loja</small>
                <span class="ir">Abrir <i class="bi bi-arrow-right"></i></span>
            </a>
        }
    </div>

</div>

<!-- Easter egg: 5 cliques no gelo congelam a tela -->
<div id="congelamento" aria-hidden="true">
    <div class="congelamento-embacado"></div>
    <canvas class="congelamento-cristais"></canvas>
    <div class="congelamento-brilho"></div>
</div>

<style>
    .cherry-ball {
        position:absolute;
        width:15px;
        height:15px;
        border-radius:50%;
        background:#7b1a1a;
        box-shadow:inset -2px -2px 5px rgba(0,0,0,0.4),inset 2px 2px 4px rgba(255,255,255,0.1);
        pointer-events:none;
        opacity:0;
        z-index:10;
        transform:rotate(35deg);
    }

    .cherry-ball::before {
        content:'';
        position:absolute;
        top:-10px;
        left:60%;
        width:2px;
        height:12px;
        background:#1a5c2a;
        border-radius:1px;
        transform-origin:bottom center;
    }

    .umbrella-wrap {
        position:absolute;
        pointer-events:none;
        opacity:0;
        z-index:10;
        width:32px;
        height:38px;
    }

    .umbrella-wrap svg {
        width:100%;
        height:100%;
    }

    /* ==============================
       EFEITO DE CONGELAMENTO
       O embaçado e a cor fria são atualizados pelo script a cada quadro;
       os cristais de gelo são desenhados no canvas, crescendo das bordas.
       ============================== */

    #congelamento {
        position:fixed;
        inset:0;
        z-index:3000;
        pointer-events:none;
        visibility:hidden;
        transition:opacity 1.4s ease;
    }

    #congelamento.ativo {
        visibility:visible;
    }

    #congelamento.derretendo {
        opacity:0;
    }

    .congelamento-embacado,
    .congelamento-cristais,
    .congelamento-brilho {
        position:absolute;
        inset:0;
        width:100%;
        height:100%;
    }

    .congelamento-brilho {
        opacity:0;
        background:linear-gradient(115deg, transparent 35%, rgba(255,255,255,.18) 47%, rgba(255,255,255,.4) 50%, rgba(255,255,255,.18) 53%, transparent 65%);
        background-size:250% 100%;
        background-position:120% 0;
    }

    #congelamento.brilhando .congelamento-brilho {
        animation:congelamentoBrilho 1.1s ease-in-out forwards;
    }

    @@keyframes congelamentoBrilho {
        0% {
            opacity:0;
            background-position:120% 0;
        }

        20% {
            opacity:1;
        }

        100% {
            opacity:0;
            background-position:-20% 0;
        }
    }
</style>

<script>
    // ===== Animação original (cereja + guarda-chuva) =====

    (function () {
        var clicks = 0;
        var MAX = 5;
        var animating = false;
        var STOP_PCT = 0.56;
        var img = document.getElementById('bear-img');
        var zone = document.getElementById('bear-zone');

        img.addEventListener('click', function () {
            if (animating) return;

            clicks++;

            if (clicks >= MAX) {
                clicks = 0;
                animating = true;
                launch();
            }
        });

        function launch() {
            var imgW = img.offsetWidth;
            var imgH = img.offsetHeight;
            var stopY = Math.round(imgH * STOP_PCT);
            var centerX = Math.round(imgW / 2);

            launchCherry(centerX, stopY);
            launchUmbrella(centerX, stopY, imgW);
        }

        function launchCherry(centerX, stopY) {
            var ball = document.createElement('div');

            ball.className = 'cherry-ball';
            ball.style.left = (centerX - 7) + 'px';
            ball.style.top = '-16px';
            ball.style.opacity = '1';

            zone.appendChild(ball);

            var y = -16;
            var vy = 0.8;
            var finalStop = stopY - 8;

            function fall() {
                vy += 0.18;
                y += vy;
                ball.style.top = y + 'px';

                if (y < finalStop) {
                    requestAnimationFrame(fall);
                } else {
                    ball.style.top = finalStop + 'px';
                    ball.style.transition = 'transform 0.5s';
                    ball.style.transform = 'rotate(35deg) scale(1.3)';

                    setTimeout(function () {
                        ball.style.transform = 'rotate(35deg) scale(1)';
                    }, 500);

                    fadeOut(ball, 1800);
                }
            }

            requestAnimationFrame(fall);
        }

        function launchUmbrella(centerX, stopY, imgW) {
            var wrap = document.createElement('div');

            wrap.className = 'umbrella-wrap';

            var umbX = centerX - 10;

            wrap.style.left = umbX + 'px';
            wrap.style.top = '-40px';
            wrap.style.opacity = '1';
            wrap.innerHTML = buildUmbrellaSVG();

            zone.appendChild(wrap);

            var y = -40;
            var vy = 0;
            var t = 0;
            var finalStop = stopY - 30;

            function fall() {
                vy += 0.06;

                if (vy > 1.2) {
                    vy = 1.2;
                }

                y += vy;
                t += 0.07;

                var sway = Math.sin(t) * 18;
                var tiltDeg = 20 + Math.sin(t) * 10;

                wrap.style.top = y + 'px';
                wrap.style.transform = 'rotate(' + tiltDeg + 'deg)';
                wrap.style.left = (umbX + sway) + 'px';

                if (y < finalStop) {
                    requestAnimationFrame(fall);
                } else {
                    wrap.style.top = finalStop + 'px';
                    fadeOut(wrap, 1200);
                }
            }

            requestAnimationFrame(fall);
        }

        function buildUmbrellaSVG() {
            return '<svg viewBox="0 0 32 38" xmlns="http://www.w3.org/2000/svg">' +
                '<path d="M16 3 Q2 3 2 14 Q8 8 16 10 Q24 8 30 14 Q30 3 16 3Z" fill="#e74c3c"/>' +
                '<path d="M16 3 Q2 3 2 14 Q8 8 16 10 Q24 8 30 14 Q30 3 16 3Z" fill="none" stroke="#c0392b" stroke-width="0.8"/>' +
                '<path d="M16 10 Q8 8 2 14" fill="none" stroke="#fff" stroke-width="0.5" opacity="0.4"/>' +
                '<path d="M16 10 Q24 8 30 14" fill="none" stroke="#fff" stroke-width="0.5" opacity="0.4"/>' +
                '<path d="M2 14 Q8 8 16 10" fill="#e67e22" stroke="none"/>' +
                '<path d="M16 10 Q24 8 30 14" fill="#f1c40f" stroke="none"/>' +
                '<line x1="16" y1="10" x2="16" y2="33" stroke="#8B4513" stroke-width="1.5" stroke-linecap="round"/>' +
                '<path d="M16 33 Q17 36 15 37 Q13 38 13 36" fill="none" stroke="#8B4513" stroke-width="1.5" stroke-linecap="round"/>' +
                '</svg>';
        }

        function fadeOut(el, delay) {
            setTimeout(function () {
                el.style.transition = 'opacity 0.6s';
                el.style.opacity = '0';

                setTimeout(function () {
                    el.remove();
                    animating = false;
                }, 650);
            }, delay);
        }
    })();

    // ===== Congelar a tela (5 cliques no gelo) =====
    // 1) A tela embaça e esfria, das bordas para o centro.
    // 2) Cristais de gelo "trincam" a partir das bordas e dos cantos.
    // 3) Um brilho passa pelo gelo, a tela fica congelada um instante e derrete.

    (function () {
        var CLIQUES = 5;
        var DURACAO_CONGELAR = 3.2;   // segundos até a tela terminar de embaçar
        var TEMPO_CONGELADO = 1.8;    // segundos parado, já congelado
        var TEMPO_DERRETER = 1.4;     // deve ser igual ao "transition" do #congelamento

        var badge = document.getElementById('ice-badge');
        var tela = document.getElementById('congelamento');
        if (!badge || !tela) return;

        var embacado = tela.querySelector('.congelamento-embacado');
        var canvas = tela.querySelector('.congelamento-cristais');
        var ctx = canvas.getContext('2d');

        var cliques = 0;
        var rodando = false;

        badge.addEventListener('click', function () {
            if (rodando) return;

            cliques++;

            if (cliques >= CLIQUES) {
                cliques = 0;
                congelar();
            }
        });

        function aleatorio(min, max) {
            return min + Math.random() * (max - min);
        }

        // Gera o gelo: cada cristal nasce numa borda e cresce para dentro como uma "pena",
        // com galhos alternados dos dois lados em ângulo de cristal (perto de 60 graus).
        function gerarCristais(largura, altura) {
            var trechos = [];
            var escala = Math.min(largura, altura);

            function galho(x, y, angulo, comprimento, espessura, inicio, geracao) {
                var velocidade = geracao === 0 ? aleatorio(110, 170) : aleatorio(80, 130);
                var passo = geracao === 0 ? 6 : 4;
                var percorrido = 0;
                var tempo = inicio;
                var lado = Math.random() < 0.5 ? -1 : 1;
                var contador = 0;

                while (percorrido < comprimento) {
                    angulo += aleatorio(-0.06, 0.06);

                    var nx = x + Math.cos(angulo) * passo;
                    var ny = y + Math.sin(angulo) * passo;
                    var restante = 1 - percorrido / comprimento;

                    tempo += passo / velocidade;

                    trechos.push({
                        x1: x, y1: y, x2: nx, y2: ny,
                        t: tempo,
                        largura: Math.max(0.5, espessura * (0.4 + 0.6 * restante)),
                        alfa: 0.4 + 0.5 * restante,
                        geracao: geracao
                    });

                    x = nx;
                    y = ny;
                    percorrido += passo;
                    contador++;

                    if (geracao < 2 && contador % (geracao === 0 ? 2 : 3) === 0) {
                        var tamanho = comprimento * (geracao === 0 ? 0.22 : 0.4) * (0.35 + 0.65 * restante) * aleatorio(0.7, 1.1);

                        galho(x, y, angulo + lado * aleatorio(0.95, 1.15), tamanho, espessura * 0.5, tempo, geracao + 1);
                        lado = -lado;
                    }
                }
            }

            // Bordas: perto dos cantos o gelo nasce antes e vai mais fundo
            var bordas = [
                { tamanho: largura, ponto: function (p) { return [p, 0]; }, angulo: Math.PI / 2 },
                { tamanho: largura, ponto: function (p) { return [p, altura]; }, angulo: -Math.PI / 2 },
                { tamanho: altura, ponto: function (p) { return [0, p]; }, angulo: 0 },
                { tamanho: altura, ponto: function (p) { return [largura, p]; }, angulo: Math.PI }
            ];

            bordas.forEach(function (borda) {
                for (var p = aleatorio(0, 40); p < borda.tamanho; p += aleatorio(35, 95)) {
                    var canto = Math.abs(p / borda.tamanho - 0.5) * 2; // 0 no meio da borda, 1 no canto
                    var xy = borda.ponto(p);

                    galho(xy[0], xy[1],
                        borda.angulo + aleatorio(-0.85, 0.85),
                        escala * aleatorio(0.05, 0.2) * (1 + 1.2 * canto * canto),
                        aleatorio(1.4, 2.2),
                        aleatorio(0, 0.4) + (1 - canto) * 0.9,
                        0);
                }
            });

            // Cantos: as rachaduras maiores, as primeiras a aparecer
            var cantos = [
                [0, 0, 0], [largura, 0, Math.PI / 2],
                [largura, altura, Math.PI], [0, altura, -Math.PI / 2]
            ];

            cantos.forEach(function (canto) {
                for (var i = 0; i < 4; i++) {
                    var direcao = canto[2] + (i + 0.5) * (Math.PI / 2) / 4 + aleatorio(-0.15, 0.15);
                    var recuo = aleatorio(0, 40);

                    galho(canto[0] + Math.cos(canto[2]) * recuo, canto[1] + Math.sin(canto[2]) * recuo,
                        direcao,
                        escala * aleatorio(0.32, 0.5),
                        aleatorio(2, 2.6),
                        aleatorio(0, 0.2),
                        0);
                }
            });

            trechos.sort(function (a, b) { return a.t - b.t; });
            return trechos;
        }

        // Mancha clara e suave que vai "esbranquiçando" a região em volta dos cristais
        var mancha = document.createElement('canvas');
        mancha.width = mancha.height = 64;
        (function () {
            var c = mancha.getContext('2d');
            var g = c.createRadialGradient(32, 32, 0, 32, 32, 32);
            g.addColorStop(0, 'rgba(225, 242, 255, 0.10)');
            g.addColorStop(1, 'rgba(225, 242, 255, 0)');
            c.fillStyle = g;
            c.fillRect(0, 0, 64, 64);
        })();

        function desenhar(trechos, desde, ate) {
            var i, s;

            // 1) Neblina de gelo em volta dos troncos principais
            for (i = desde; i < ate; i++) {
                s = trechos[i];
                if (s.geracao === 0) {
                    ctx.drawImage(mancha, s.x2 - 28, s.y2 - 28, 56, 56);
                }
            }

            // 2) Brilho azulado largo
            ctx.strokeStyle = 'rgba(150, 205, 255, 0.16)';
            for (i = desde; i < ate; i++) {
                s = trechos[i];
                ctx.lineWidth = s.largura * 3;
                ctx.beginPath();
                ctx.moveTo(s.x1, s.y1);
                ctx.lineTo(s.x2, s.y2);
                ctx.stroke();
            }

            // 3) O cristal branco por cima
            for (i = desde; i < ate; i++) {
                s = trechos[i];
                ctx.strokeStyle = 'rgba(242, 250, 255, ' + s.alfa + ')';
                ctx.lineWidth = s.largura;
                ctx.beginPath();
                ctx.moveTo(s.x1, s.y1);
                ctx.lineTo(s.x2, s.y2);
                ctx.stroke();
            }
        }

        // Embaçado e cor fria: fortes nas bordas, mais leves no centro
        function aplicarEmbacado(p) {
            var desfoque = (10 * p).toFixed(1);
            var centro = (0.65 * p).toFixed(2);
            var borda = Math.round(85 - 45 * p);

            embacado.style.backdropFilter = 'blur(' + desfoque + 'px) saturate(' + (1 - 0.45 * p).toFixed(2) + ') brightness(' + (1 + 0.12 * p).toFixed(2) + ')';
            embacado.style.webkitBackdropFilter = embacado.style.backdropFilter;

            embacado.style.background =
                'radial-gradient(ellipse at center, rgba(160, 210, 255, ' + (0.14 * p).toFixed(3) + ') 30%, rgba(200, 230, 255, ' + (0.3 * p).toFixed(3) + ') 65%, rgba(235, 247, 255, ' + (0.7 * p).toFixed(3) + ') 100%)';

            var mascara = 'radial-gradient(ellipse at center, rgba(0, 0, 0, ' + centro + ') 25%, #000 ' + borda + '%)';
            embacado.style.maskImage = mascara;
            embacado.style.webkitMaskImage = mascara;
        }

        function congelar() {
            rodando = true;

            var proporcao = Math.min(window.devicePixelRatio || 1, 2);
            var largura = window.innerWidth;
            var altura = window.innerHeight;

            canvas.width = largura * proporcao;
            canvas.height = altura * proporcao;
            ctx.setTransform(proporcao, 0, 0, proporcao, 0, 0);
            ctx.clearRect(0, 0, largura, altura);
            ctx.lineCap = 'round';

            var trechos = gerarCristais(largura, altura);
            var desenhados = 0;
            var comeco = null;

            aplicarEmbacado(0);
            tela.classList.remove('derretendo', 'brilhando');
            tela.classList.add('ativo');

            function quadro(agora) {
                if (comeco === null) comeco = agora;

                var segundos = (agora - comeco) / 1000;
                var p = Math.min(segundos / DURACAO_CONGELAR, 1);

                aplicarEmbacado(1 - Math.pow(1 - p, 2));

                var ate = desenhados;
                while (ate < trechos.length && trechos[ate].t <= segundos) ate++;

                desenhar(trechos, desenhados, ate);
                desenhados = ate;

                if (p < 1 || desenhados < trechos.length) {
                    requestAnimationFrame(quadro);
                } else {
                    congelado();
                }
            }

            requestAnimationFrame(quadro);
        }

        function congelado() {
            tela.classList.add('brilhando');

            setTimeout(function () {
                tela.classList.add('derretendo');

                setTimeout(function () {
                    tela.classList.remove('ativo', 'derretendo', 'brilhando');
                    ctx.clearRect(0, 0, canvas.width, canvas.height);
                    aplicarEmbacado(0);
                    rodando = false;
                }, TEMPO_DERRETER * 1000 + 100);
            }, TEMPO_CONGELADO * 1000);
        }
    })();
</script>
