
@{
    ViewData["Title"] = "Polar Drinks";
}

<div class="tema-dark" style="min-height:calc(100vh - 56px);display:flex;align-items:center;justify-content:center;">
    <div class="container py-4 px-3 px-md-5">
        <div class="bg-shadow p-4 p-md-5 rounded-5 text-light text-center">
            <div id="ice-badge" class="sf-icon-badge mx-auto mb-3" style="background:linear-gradient(135deg,#3b82f6,#6366f1);box-shadow:0 8px 20px -8px rgba(59,130,246,.8);cursor:pointer;user-select:none;">
                <i class="bi bi-snow2 fs-4 text-white"></i>
            </div>

            <h1 class="display-5 display-md-4 fw-bold mb-1">Bem-vindo ao</h1>
            <h1 class="display-5 display-md-4 fw-bold mb-3">Polar Drinks!</h1>
            <p class="lead text-secondary mb-4">Sua plataforma de controle de estoque e vendas de bebidas e produtos</p>

            <div id="bear-zone" style="position:relative;display:inline-block;">
                <img id="bear-img" src="/img/polaria.png" class="img-fluid" style="max-height:400px;object-fit:contain;cursor:pointer;" alt="Polaria mascot" />
            </div>
        </div>
    </div>
</div>

<!-- Efeito de congelamento -->
<div id="frost-overlay" aria-hidden="true">
    <div class="frost-layer frost-layer-1"></div>
    <div class="frost-layer frost-layer-2"></div>
    <div class="frost-shine"></div>
    <div class="frost-noise"></div>
</div>

<style>
    .cherry-ball {
        position:absolute;
        width:15px;
        height:15px;
        border-radius:50%;
        background:#7b1a1a;
        box-shadow:inset -2px -2px 5px rgba(0,0,0,0.4),inset 2px 2px 4px rgba(255,255,255,0.1);
        pointer-events:none;
        opacity:0;
        z-index:10;
        transform:rotate(35deg);
    }

    .cherry-ball::before {
        content:'';
        position:absolute;
        top:-10px;
        left:60%;
        width:2px;
        height:12px;
        background:#1a5c2a;
        border-radius:1px;
        transform-origin:bottom center;
    }

    .umbrella-wrap {
        position:absolute;
        pointer-events:none;
        opacity:0;
        z-index:10;
        width:32px;
        height:38px;
    }

    .umbrella-wrap svg {
        width:100%;
        height:100%;
    }

    /* ==============================
       EFEITO DE CONGELAMENTO
       ============================== */

    #frost-overlay {
        position:fixed;
        inset:0;
        z-index:3000;
        pointer-events:none;
        opacity:0;
        overflow:hidden;
    }

    .frost-layer {
        position:absolute;
        inset:-10%;
        opacity:0;
        border:2px solid rgba(255,255,255,.5);
        box-shadow:
            inset 0 0 80px rgba(210,242,255,.9),
            inset 0 0 180px rgba(140,205,235,.55),
            0 0 50px rgba(180,230,250,.3);
    }

    .frost-layer-1 {
        background:
            radial-gradient(
                ellipse at 50% 50%,
                rgba(255,255,255,0) 15%,
                rgba(230,248,255,.05) 35%,
                rgba(190,225,240,.22) 65%,
                rgba(225,248,255,.65) 100%
            );
        backdrop-filter:blur(0px);
        -webkit-backdrop-filter:blur(0px);
    }

    .frost-layer-2 {
        background:
            radial-gradient(
                ellipse at 50% 50%,
                rgba(255,255,255,0) 30%,
                rgba(220,245,255,.08) 48%,
                rgba(180,220,240,.18) 75%,
                rgba(240,252,255,.45) 100%
            );
        transform:scale(1.08);
        backdrop-filter:blur(0px);
        -webkit-backdrop-filter:blur(0px);
    }

    .frost-shine {
        position:absolute;
        inset:-30%;
        opacity:0;
        background:
            linear-gradient(
                125deg,
                transparent 25%,
                rgba(255,255,255,.04) 35%,
                rgba(255,255,255,.45) 48%,
                rgba(255,255,255,.08) 53%,
                transparent 65%
            );
        transform:translateX(-60%) rotate(-8deg);
        filter:blur(5px);
    }

    .frost-noise {
        position:absolute;
        inset:0;
        opacity:0;
        background:
            radial-gradient(circle at 15% 20%,rgba(255,255,255,.35) 0 1px,transparent 2px),
            radial-gradient(circle at 72% 35%,rgba(255,255,255,.25) 0 1px,transparent 2px),
            radial-gradient(circle at 42% 80%,rgba(255,255,255,.3) 0 1px,transparent 2px),
            radial-gradient(circle at 88% 75%,rgba(255,255,255,.2) 0 1px,transparent 2px);
        background-size:130px 150px,170px 190px,190px 170px,150px 180px;
        filter:blur(1px);
    }

    #frost-overlay.active {
        animation:frostMain 5.5s ease forwards;
    }

    #frost-overlay.active .frost-layer-1 {
        animation:frostLayerOne 5.5s ease forwards;
    }

    #frost-overlay.active .frost-layer-2 {
        animation:frostLayerTwo 5.5s ease forwards;
    }

    #frost-overlay.active .frost-shine {
        animation:frostShine 5.5s ease forwards;
    }

    #frost-overlay.active .frost-noise {
        animation:frostNoise 5.5s ease forwards;
    }

    @@keyframes frostMain {
        0% {
            opacity:0;
        }

        12% {
            opacity:1;
        }

        78% {
            opacity:1;
        }

        100% {
            opacity:0;
        }
    }

    @@keyframes frostLayerOne {
        0% {
            opacity:0;
            transform:scale(1.35);
            backdrop-filter:blur(0px);
            -webkit-backdrop-filter:blur(0px);
        }

        20% {
            opacity:.35;
        }

        45% {
            opacity:.65;
            transform:scale(1.12);
            backdrop-filter:blur(2px);
            -webkit-backdrop-filter:blur(2px);
        }

        68% {
            opacity:.95;
            transform:scale(1);
            backdrop-filter:blur(7px) brightness(1.08);
            -webkit-backdrop-filter:blur(7px) brightness(1.08);
        }

        80% {
            opacity:1;
            backdrop-filter:blur(11px) brightness(1.12);
            -webkit-backdrop-filter:blur(11px) brightness(1.12);
        }

        100% {
            opacity:0;
            backdrop-filter:blur(0px);
            -webkit-backdrop-filter:blur(0px);
        }
    }

    @@keyframes frostLayerTwo {
        0% {
            opacity:0;
            transform:scale(1.3);
        }

        25% {
            opacity:.18;
        }

        50% {
            opacity:.42;
            transform:scale(1.15);
        }

        72% {
            opacity:.75;
            transform:scale(1);
        }

        82% {
            opacity:.85;
        }

        100% {
            opacity:0;
        }
    }

    @@keyframes frostShine {
        0% {
            opacity:0;
            transform:translateX(-80%) rotate(-8deg);
        }

        25% {
            opacity:0;
        }

        45% {
            opacity:.15;
        }

        62% {
            opacity:.5;
            transform:translateX(0%) rotate(-8deg);
        }

        75% {
            opacity:.18;
            transform:translateX(70%) rotate(-8deg);
        }

        100% {
            opacity:0;
            transform:translateX(100%) rotate(-8deg);
        }
    }

    @@keyframes frostNoise {
        0% {
            opacity:0;
        }

        30% {
            opacity:.05;
        }

        55% {
            opacity:.15;
        }

        75% {
            opacity:.25;
        }

        100% {
            opacity:0;
        }
    }
</style>

<script>
    // ===== Animação original (cereja + guarda-chuva) =====

    (function () {
        var clicks = 0;
        var MAX = 5;
        var animating = false;
        var STOP_PCT = 0.56;
        var img = document.getElementById('bear-img');
        var zone = document.getElementById('bear-zone');

        img.addEventListener('click', function () {
            if (animating) return;

            clicks++;

            if (clicks >= MAX) {
                clicks = 0;
                animating = true;
                launch();
            }
        });

        function launch() {
            var imgW = img.offsetWidth;
            var imgH = img.offsetHeight;
            var stopY = Math.round(imgH * STOP_PCT);
            var centerX = Math.round(imgW / 2);

            launchCherry(centerX, stopY);
            launchUmbrella(centerX, stopY, imgW);
        }

        function launchCherry(centerX, stopY) {
            var ball = document.createElement('div');

            ball.className = 'cherry-ball';
            ball.style.left = (centerX - 7) + 'px';
            ball.style.top = '-16px';
            ball.style.opacity = '1';

            zone.appendChild(ball);

            var y = -16;
            var vy = 0.8;
            var finalStop = stopY - 8;

            function fall() {
                vy += 0.18;
                y += vy;
                ball.style.top = y + 'px';

                if (y < finalStop) {
                    requestAnimationFrame(fall);
                } else {
                    ball.style.top = finalStop + 'px';
                    ball.style.transition = 'transform 0.5s';
                    ball.style.transform = 'rotate(35deg) scale(1.3)';

                    setTimeout(function () {
                        ball.style.transform = 'rotate(35deg) scale(1)';
                    }, 500);

                    fadeOut(ball, 1800);
                }
            }

            requestAnimationFrame(fall);
        }

        function launchUmbrella(centerX, stopY, imgW) {
            var wrap = document.createElement('div');

            wrap.className = 'umbrella-wrap';

            var umbX = centerX - 10;

            wrap.style.left = umbX + 'px';
            wrap.style.top = '-40px';
            wrap.style.opacity = '1';
            wrap.innerHTML = buildUmbrellaSVG();

            zone.appendChild(wrap);

            var y = -40;
            var vy = 0;
            var t = 0;
            var finalStop = stopY - 30;

            function fall() {
                vy += 0.06;

                if (vy > 1.2) {
                    vy = 1.2;
                }

                y += vy;
                t += 0.07;

                var sway = Math.sin(t) * 18;
                var tiltDeg = 20 + Math.sin(t) * 10;

                wrap.style.top = y + 'px';
                wrap.style.transform = 'rotate(' + tiltDeg + 'deg)';
                wrap.style.left = (umbX + sway) + 'px';

                if (y < finalStop) {
                    requestAnimationFrame(fall);
                } else {
                    wrap.style.top = finalStop + 'px';
                    fadeOut(wrap, 1200);
                }
            }

            requestAnimationFrame(fall);
        }

        function buildUmbrellaSVG() {
            return '<svg viewBox="0 0 32 38" xmlns="http://www.w3.org/2000/svg">' +
                '<path d="M16 3 Q2 3 2 14 Q8 8 16 10 Q24 8 30 14 Q30 3 16 3Z" fill="#e74c3c"/>' +
                '<path d="M16 3 Q2 3 2 14 Q8 8 16 10 Q24 8 30 14 Q30 3 16 3Z" fill="none" stroke="#c0392b" stroke-width="0.8"/>' +
                '<path d="M16 10 Q8 8 2 14" fill="none" stroke="#fff" stroke-width="0.5" opacity="0.4"/>' +
                '<path d="M16 10 Q24 8 30 14" fill="none" stroke="#fff" stroke-width="0.5" opacity="0.4"/>' +
                '<path d="M2 14 Q8 8 16 10" fill="#e67e22" stroke="none"/>' +
                '<path d="M16 10 Q24 8 30 14" fill="#f1c40f" stroke="none"/>' +
                '<line x1="16" y1="10" x2="16" y2="33" stroke="#8B4513" stroke-width="1.5" stroke-linecap="round"/>' +
                '<path d="M16 33 Q17 36 15 37 Q13 38 13 36" fill="none" stroke="#8B4513" stroke-width="1.5" stroke-linecap="round"/>' +
                '</svg>';
        }

        function fadeOut(el, delay) {
            setTimeout(function () {
                el.style.transition = 'opacity 0.6s';
                el.style.opacity = '0';

                setTimeout(function () {
                    el.remove();
                    animating = false;
                }, 650);
            }, delay);
        }
    })();

    // ===== Nova animação: congelar a tela (5 cliques no gelo) =====

    (function () {
        var iceClicks = 0;
        var ICE_MAX = 5;
        var freezing = false;
        var badge = document.getElementById('ice-badge');
        var overlay = document.getElementById('frost-overlay');

        if (!badge || !overlay) return;

        badge.addEventListener('click', function () {
            if (freezing) return;

            iceClicks++;

            if (iceClicks >= ICE_MAX) {
                iceClicks = 0;
                freeze();
            }
        });

        function freeze() {
            freezing = true;

            overlay.classList.remove('active');

            void overlay.offsetWidth;

            overlay.classList.add('active');

            setTimeout(function () {
                overlay.classList.remove('active');
                freezing = false;
            }, 5500);
        }
    })();
</script>

