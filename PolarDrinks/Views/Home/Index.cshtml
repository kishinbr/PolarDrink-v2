@{
    ViewData["Title"] = "Início";
    var ehAdmin = Context.Session.GetString("Perfil") == "Admin";
    var primeiroNome = (Context.Session.GetString("Nome") ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "";
}

<div class="pagina">

    <section id="heroPainel" class="hero-painel" data-nome="@primeiroNome">
        <span id="heroCeu" class="hero-ceu" aria-hidden="true"></span>

        <div>
            <span class="hero-etiqueta">
                <span id="ice-badge" class="hero-gelo"><i class="bi bi-snow2"></i></span>
                Polar Drinks
                <button type="button" id="heroTrocar" class="hero-taca" title="Trocar o período do dia" aria-label="Trocar o período do dia">
                    <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                        <path d="M3 1h10l-.4 3.6c-.3 2.6-2.1 4.4-3.85 4.75V13.5H11V15H5v-1.5h2.25V9.35C5.5 9 3.7 7.2 3.4 4.6Z" />
                    </svg>
                </button>
            </span>

            <h1 id="heroTitulo">Bem-vindo ao<br />Polar Drinks!</h1>
            <p id="heroFrase">Sua plataforma de controle de estoque e vendas de bebidas e produtos.</p>

            <a class="botao botao-branco" asp-controller="Venda" asp-action="Cadastrar">
                Nova venda <i class="bi bi-arrow-right"></i>
            </a>
        </div>

        <div id="bear-zone" class="hero-urso">
            <img id="bear-img" src="/img/polaria.png" alt="Polaria, o mascote do Polar Drinks" />
            <!-- Gorro de pijama: só aparece de madrugada (classe periodo-madrugada, ver admin.css) -->
            <span class="hero-gorro" aria-hidden="true">
            <svg viewBox="-4 0 124 80" xmlns="http://www.w3.org/2000/svg">
              <path d="M24 60 C24 44 30 34 40 30 C30 31 21 36 15 43 L9 37 C22 22 42 12 64 12 C88 12 102 30 102 56 Z" fill="#8a63c9"/>
              <path d="M40 30 C30 31 21 36 15 43 L12 40 C20 33 30 29 40 30 Z" fill="#6f4db3"/>
              <path d="M58 22 C48 26 40 34 38 44" fill="none" stroke="#3b2a66" stroke-width="1.6" stroke-linecap="round"/>
              <g fill="#fff">
                <path transform="translate(74 30) scale(1.5)" d="M0 -4 Q.6 -.6 4 0 Q.6 .6 0 4 Q-.6 .6 -4 0 Q-.6 -.6 0 -4Z"/>
                <path transform="translate(52 40) scale(.9)" d="M0 -4 Q.6 -.6 4 0 Q.6 .6 0 4 Q-.6 .6 -4 0 Q-.6 -.6 0 -4Z"/>
                <path transform="translate(92 42) scale(1)" d="M0 -4 Q.6 -.6 4 0 Q.6 .6 0 4 Q-.6 .6 -4 0 Q-.6 -.6 0 -4Z"/>
                <path transform="translate(30 25) scale(.8)" d="M0 -4 Q.6 -.6 4 0 Q.6 .6 0 4 Q-.6 .6 -4 0 Q-.6 -.6 0 -4Z"/>
                <path transform="translate(64 20) scale(.6)" d="M0 -4 Q.6 -.6 4 0 Q.6 .6 0 4 Q-.6 .6 -4 0 Q-.6 -.6 0 -4Z"/>
                <circle cx="84" cy="22" r="1"/><circle cx="46" cy="18" r=".9"/><circle cx="66" cy="46" r="1"/><circle cx="36" cy="48" r=".8"/>
              </g>
              <path d="M20 56 Q62 47 104 52 L105 64 Q62 59 19 70 Z" fill="#6b4bb0"/>
              <path d="M22 66 Q62 56 103 60" fill="none" stroke="#3b2a66" stroke-width="1.2" opacity=".6"/>
              <g fill="#dbeefe">
                <circle cx="10" cy="40" r="8.5"/>
                <circle cx="3" cy="36" r="3"/><circle cx="6" cy="32" r="3"/><circle cx="12" cy="31" r="3"/><circle cx="17" cy="35" r="3"/>
                <circle cx="18" cy="42" r="3"/><circle cx="15" cy="47" r="3"/><circle cx="9" cy="49" r="3"/><circle cx="3" cy="45" r="3"/><circle cx="1.5" cy="40" r="3"/>
              </g>
              <circle cx="10" cy="40" r="6.2" fill="#fff"/>
            </svg>
            </span>
            <span class="hero-zzz" aria-hidden="true"><b>Z</b><b>z</b><b>z</b></span>
        </div>
    </section>

    <script>
        // O urso conforme o dia: usa a hora do aparelho de quem abriu a página.
        // (O servidor na Azure fica em UTC, 3 horas à frente de Brasília, por isso a hora não vem dele.)
        // Roda logo depois do painel, antes da página aparecer, então não pisca o texto antigo.
        (function () {
            var painel = document.getElementById("heroPainel");
            var nome = painel.dataset.nome;

            // Os 4 períodos, na ordem em que a taça vai trocando.
            // Para mudar os textos: "saudacao" é o título grande e "frase" é o texto de baixo.
            var periodos = [
                { classe: "periodo-manha", icone: "bi-sun-fill", saudacao: "Bom dia",
                  frase: "Sua plataforma de controle de estoque e vendas de bebidas e produtos." },
                { classe: "periodo-tarde", icone: "", saudacao: "Boa tarde",
                  frase: "Sua plataforma de controle de estoque e vendas de bebidas e produtos." },
                { classe: "periodo-noite", icone: "bi-moon-stars-fill", saudacao: "Boa noite",
                  frase: "Sua plataforma de controle de estoque e vendas de bebidas e produtos." },
                { classe: "periodo-madrugada", icone: "bi-moon-fill", saudacao: "Boa madrugada",
                  frase: "Sua plataforma de controle de estoque e vendas de bebidas e produtos." }
            ];

            function aplicar(indice) {
                var p = periodos[indice];

                periodos.forEach(function (outro) { painel.classList.remove(outro.classe); });
                painel.classList.add(p.classe);

                document.getElementById("heroFrase").textContent = p.frase;
                document.getElementById("heroCeu").innerHTML = p.icone ? '<i class="bi ' + p.icone + '"></i>' : "";

                // "Bom dia," + quebra de linha + "Vinicius!" (createTextNode: o nome entra como texto, nunca como HTML)
                var titulo = document.getElementById("heroTitulo");
                titulo.textContent = p.saudacao + (nome ? "," : "!");
                if (nome) {
                    titulo.appendChild(document.createElement("br"));
                    titulo.appendChild(document.createTextNode(nome + "!"));
                }
            }

            // Período de acordo com a hora do aparelho
            var hora = new Date().getHours();
            var atual;
            if (hora >= 6 && hora < 12) atual = 0;        // manhã
            else if (hora >= 12 && hora < 18) atual = 1;  // tarde
            else if (hora >= 18 && hora < 23) atual = 2;  // noite
            else atual = 3;                               // madrugada
            aplicar(atual);

            // Taça: cada clique passa para o próximo período. Não salva nada,
            // então ao recarregar a página volta para o período do horário real.
            document.getElementById("heroTrocar").addEventListener("click", function () {
                atual = (atual + 1) % periodos.length;
                aplicar(atual);
            });
        })();
    </script>

    <div class="atalhos">
        <a class="atalho" asp-controller="Venda" asp-action="Cadastrar">
            <span class="icone-atalho"><i class="bi bi-cart-check"></i></span>
            <b>Nova venda</b>
            <small>Registrar uma venda no balcão</small>
            <span class="ir">Abrir <i class="bi bi-arrow-right"></i></span>
        </a>

        <a class="atalho" asp-controller="PedidoOnline" asp-action="Index">
            <span class="icone-atalho"><i class="bi bi-bag-check"></i></span>
            <b>Pedidos online</b>
            <small>Separar e entregar os pedidos da loja</small>
            <span class="ir">Abrir <i class="bi bi-arrow-right"></i></span>
        </a>

        <a class="atalho" asp-controller="Estoque" asp-action="Index">
            <span class="icone-atalho"><i class="bi bi-box-seam"></i></span>
            <b>Produtos</b>
            <small>Consultar preços e estoque</small>
            <span class="ir">Abrir <i class="bi bi-arrow-right"></i></span>
        </a>

        @if (ehAdmin)
        {
            <a class="atalho" asp-controller="Dashboard" asp-action="Index">
                <span class="icone-atalho"><i class="bi bi-graph-up"></i></span>
                <b>Dashboard</b>
                <small>Indicadores e relatórios</small>
                <span class="ir">Abrir <i class="bi bi-arrow-right"></i></span>
            </a>
        }
        else
        {
            <a class="atalho" asp-controller="Fornecedor" asp-action="Index">
                <span class="icone-atalho"><i class="bi bi-truck"></i></span>
                <b>Fornecedores</b>
                <small>Contatos de quem abastece a loja</small>
                <span class="ir">Abrir <i class="bi bi-arrow-right"></i></span>
            </a>
        }
    </div>

</div>

<!-- Easter egg: 5 cliques no gelo congelam a tela -->
<div id="congelamento" aria-hidden="true">
    <div class="congelamento-embacado"></div>
    <canvas class="congelamento-cristais"></canvas>
    <div class="congelamento-brilho"></div>
</div>

<style>
    /* ==============================
       SURPRESAS DO URSO (5 cliques no urso)
       Primeiro a cereja e o guarda-chuva caem dentro da taça que forma o nariz do urso,
       depois vêm o colar havaiano e os óculos escuros de pixel, e tudo fica junto um tempo.
       ============================== */

    .enfeite-drink {
        position:absolute;
        left:0;
        top:0;
        z-index:10;
        pointer-events:none;
        will-change:transform;
    }

    .enfeite-drink svg {
        display:block;
        width:100%;
        height:100%;
        overflow:visible;
    }

    .respingo {
        position:absolute;
        left:0;
        top:0;
        z-index:11;
        width:5px;
        height:5px;
        border-radius:50%;
        background:#bfe6ff;
        pointer-events:none;
    }

    /* ==============================
       EFEITO DE CONGELAMENTO
       O embaçado e a cor fria são atualizados pelo script a cada quadro;
       os cristais de gelo são desenhados no canvas, crescendo das bordas.
       ============================== */

    #congelamento {
        position:fixed;
        inset:0;
        z-index:3000;
        pointer-events:none;
        visibility:hidden;
        transition:opacity 1.4s ease;
    }

    #congelamento.ativo {
        visibility:visible;
    }

    #congelamento.derretendo {
        opacity:0;
    }

    .congelamento-embacado,
    .congelamento-cristais,
    .congelamento-brilho {
        position:absolute;
        inset:0;
        width:100%;
        height:100%;
    }

    .congelamento-brilho {
        opacity:0;
        background:linear-gradient(115deg, transparent 35%, rgba(255,255,255,.18) 47%, rgba(255,255,255,.4) 50%, rgba(255,255,255,.18) 53%, transparent 65%);
        background-size:250% 100%;
        background-position:120% 0;
    }

    #congelamento.brilhando .congelamento-brilho {
        animation:congelamentoBrilho 1.1s ease-in-out forwards;
    }

    @@keyframes congelamentoBrilho {
        0% {
            opacity:0;
            background-position:120% 0;
        }

        20% {
            opacity:1;
        }

        100% {
            opacity:0;
            background-position:-20% 0;
        }
    }
</style>

<script>
    // ===== Surpresas do urso (5 cliques no urso) =====
    // 1) Cereja e guarda-chuva caem na taça do nariz.  2) Colar havaiano e óculos escuros.
    // 3) Tudo fica na tela junto por alguns segundos e some.
    // O nariz do urso é uma taça. As medidas abaixo são frações do tamanho da imagem
    // (tiradas do polaria.png), então a animação acerta a taça em qualquer tamanho de tela.

    (function () {
        var CLIQUES = 5;
        var TACA = { centroX: 0.50, bordaY: 0.535 };
        var TEMPO_SERVIDO = 4.5;  // segundos que tudo fica na tela depois que os óculos encaixam
        var ESPERA_FERIAS = 2.6;  // segundos depois do drink para começar o colar e os óculos

        var SVG_CEREJA =
            '<svg viewBox="0 0 20 28" xmlns="http://www.w3.org/2000/svg">' +
            '<path d="M10 12 Q11 4 17 1" fill="none" stroke="#2f7a3a" stroke-width="1.6" stroke-linecap="round"/>' +
            '<circle cx="10" cy="19" r="8" fill="#b3122e"/>' +
            '<circle cx="7" cy="16" r="2.4" fill="#fff" opacity=".45"/>' +
            '</svg>';

        var SVG_GUARDA_CHUVA =
            '<svg viewBox="0 0 32 38" xmlns="http://www.w3.org/2000/svg">' +
            '<path d="M16 3 Q2 3 2 14 Q8 8 16 10 Q24 8 30 14 Q30 3 16 3Z" fill="#e74c3c"/>' +
            '<path d="M2 14 Q8 8 16 10" fill="#e67e22"/>' +
            '<path d="M16 10 Q24 8 30 14" fill="#f1c40f"/>' +
            '<path d="M16 3 Q2 3 2 14 Q8 8 16 10 Q24 8 30 14 Q30 3 16 3Z" fill="none" stroke="#c0392b" stroke-width="0.8"/>' +
            '<line x1="16" y1="10" x2="16" y2="35" stroke="#8B4513" stroke-width="1.5" stroke-linecap="round"/>' +
            '</svg>';

        var img = document.getElementById('bear-img');
        var zona = document.getElementById('bear-zone');
        if (!img || !zona) return;

        var cliques = 0;
        var animando = false;

        img.addEventListener('click', function () {
            if (animando) return;

            cliques++;

            if (cliques >= CLIQUES) {
                cliques = 0;
                animando = true;

                servirDrink();
                setTimeout(modoFerias, ESPERA_FERIAS * 1000);
            }
        });

        function criarEnfeite(svg, largura, altura) {
            var el = document.createElement('div');
            el.className = 'enfeite-drink';
            el.style.width = largura + 'px';
            el.style.height = altura + 'px';
            el.innerHTML = svg;
            zona.appendChild(el);
            return el;
        }

        function posicionar(el, x, y, graus) {
            el.style.transform = 'translate(' + x + 'px, ' + y + 'px) rotate(' + (graus || 0) + 'deg)';
        }

        function servirDrink() {
            var largura = img.offsetWidth;
            var altura = img.offsetHeight;

            soltarCereja(largura, altura);
            setTimeout(function () { soltarGuardaChuva(largura, altura); }, 450);
        }

        // Cereja: cai com gravidade, afunda um pouco na bebida e espirra gotinhas
        function soltarCereja(largura, altura) {
            var tamanho = largura * 0.06;
            var el = criarEnfeite(SVG_CEREJA, tamanho, tamanho * 1.4);

            var x = largura * TACA.centroX - tamanho / 2;
            var yFinal = altura * (TACA.bordaY + 0.012) - tamanho * 1.4 * (19 / 28);
            var yInicial = -tamanho * 2;
            var gravidade = altura * 2.4; // pixels por segundo ao quadrado
            var comeco = null;

            function cair(agora) {
                if (comeco === null) comeco = agora;

                var t = (agora - comeco) / 1000;
                var y = yInicial + gravidade * t * t / 2;

                if (y < yFinal) {
                    posicionar(el, x, y, 0);
                    requestAnimationFrame(cair);
                    return;
                }

                posicionar(el, x, yFinal, 0);
                el.style.transformOrigin = '50% 100%';
                el.firstChild.animate(
                    [{ transform: 'scale(1.18, 0.82)' }, { transform: 'scale(0.94, 1.06)' }, { transform: 'scale(1, 1)' }],
                    { duration: 380, easing: 'ease-out' });

                espirrar(largura * TACA.centroX, altura * TACA.bordaY);
            }

            requestAnimationFrame(cair);
        }

        // Guarda-chuva: desce balançando como uma folha e fica apoiado na borda da taça
        function soltarGuardaChuva(largura, altura) {
            var tamanho = largura * 0.11;
            var alturaEl = tamanho * 38 / 32;
            var el = criarEnfeite(SVG_GUARDA_CHUVA, tamanho, alturaEl);

            // o ponto de giro é a ponta do cabo, que fica dentro da bebida
            el.style.transformOrigin = '50% 92%';

            var pontaX = largura * (TACA.centroX + 0.035);
            var pontaY = altura * (TACA.bordaY + 0.03);
            var xFinal = pontaX - tamanho * 0.5;
            var yFinal = pontaY - alturaEl * 0.92;
            var yInicial = -alturaEl * 1.5;
            var duracao = 1.9;
            var comeco = null;

            function descer(agora) {
                if (comeco === null) comeco = agora;

                var t = (agora - comeco) / 1000;
                var p = Math.min(t / duracao, 1);
                var suave = 1 - Math.pow(1 - p, 2);
                var balanco = Math.sin(t * 3.4) * (1 - p);

                var x = xFinal + balanco * largura * 0.12;
                var y = yInicial + (yFinal - yInicial) * suave;
                var graus = 22 + balanco * 26;

                posicionar(el, x, y, graus);

                if (p < 1) requestAnimationFrame(descer);
            }

            requestAnimationFrame(descer);
        }

        // ===== Modo férias: colar havaiano + óculos escuros de pixel =====
        // Medidas também em frações da imagem: os olhos terminam em ~0.43 da altura,
        // então os óculos param logo abaixo (os olhos continuam aparecendo) e o colar fica sob o queixo.

        var OCULOS = { largura: 0.58, topo: 0.435 };
        var COLAR = { largura: 0.68, topo: 0.54 };

        function modoFerias() {
            var largura = img.offsetWidth;
            var altura = img.offsetHeight;

            colocarColar(largura, altura);
            setTimeout(function () { colocarOculos(largura, altura); }, 700);
        }

        // Óculos em pixel art: grade de 32 x 7 quadradinhos
        function svgOculos() {
            // [linha, de, até] da lente esquerda; a direita é o espelho dela
            var lente = [[1, 0, 14], [2, 0, 13], [3, 1, 12], [4, 1, 11], [5, 2, 10], [6, 3, 9]];
            // [linha, coluna] dos quadradinhos brancos do reflexo (repetidos na lente direita)
            var reflexo = [[2, 3], [2, 5], [3, 4], [3, 6], [4, 5], [4, 7]];

            var preto = '<rect x="0" y="0" width="32" height="1.05"/>';
            lente.forEach(function (l) {
                var tamanho = l[2] - l[1] + 1;
                preto += '<rect x="' + l[1] + '" y="' + l[0] + '" width="' + tamanho + '" height="1.05"/>';
                preto += '<rect x="' + (31 - l[2]) + '" y="' + l[0] + '" width="' + tamanho + '" height="1.05"/>';
            });

            var branco = '';
            reflexo.forEach(function (r) {
                branco += '<rect x="' + r[1] + '" y="' + r[0] + '" width="1" height="1"/>';
                branco += '<rect x="' + (r[1] + 16) + '" y="' + r[0] + '" width="1" height="1"/>';
            });

            return '<svg viewBox="0 0 32 7" shape-rendering="crispEdges" xmlns="http://www.w3.org/2000/svg">' +
                '<g fill="#000">' + preto + '</g>' +
                '<g class="reflexo-oculos" fill="#fff">' + branco + '</g>' +
                '</svg>';
        }

        // Colar havaiano: flores de 5 pétalas e folhas ao longo de um arco
        function svgColar() {
            var cores = ['#ff4f8b', '#ffd23f', '#ff7a3d', '#c86bfa', '#ff3b5c'];
            var total = 13;
            var pontos = [];

            for (var i = 0; i < total; i++) {
                var angulo = (12 + 156 * i / (total - 1)) * Math.PI / 180;
                pontos.push({ x: 50 + 42 * Math.cos(angulo), y: 6 + 44 * Math.sin(angulo) });
            }

            var folhas = '';
            for (var f = 0; f < total - 1; f++) {
                var a = pontos[f], b = pontos[f + 1];
                var giro = Math.atan2(b.y - a.y, b.x - a.x) * 180 / Math.PI;
                folhas += '<ellipse rx="3.8" ry="1.6" fill="#2f9e44" transform="translate(' +
                    ((a.x + b.x) / 2).toFixed(1) + ' ' + ((a.y + b.y) / 2 + 2.5).toFixed(1) + ') rotate(' + giro.toFixed(0) + ')"/>';
            }

            var flores = '';
            pontos.forEach(function (ponto, i) {
                var petalas = '';
                for (var k = 0; k < 5; k++) {
                    petalas += '<ellipse cy="-3.2" rx="2.4" ry="3.4" transform="rotate(' + (k * 72) + ')"/>';
                }
                flores += '<g fill="' + cores[i % cores.length] + '" transform="translate(' +
                    ponto.x.toFixed(1) + ' ' + ponto.y.toFixed(1) + ') rotate(' + (i * 23) + ')">' +
                    petalas + '<circle r="1.6" fill="#fff3b0"/></g>';
            });

            return '<svg viewBox="0 0 100 60" xmlns="http://www.w3.org/2000/svg">' + folhas + flores + '</svg>';
        }

        // Colar: cai por cima da cabeça, para no pescoço e balança um pouco
        function colocarColar(largura, altura) {
            var w = largura * COLAR.largura;
            var h = w * 0.6;
            var el = criarEnfeite(svgColar(), w, h);

            var x = largura / 2 - w / 2;
            var yFinal = altura * COLAR.topo;

            posicionar(el, x, yFinal, 0);
            el.animate(
                [{ transform: 'translate(' + x + 'px, ' + (-h * 1.3) + 'px)' }, { transform: 'translate(' + x + 'px, ' + yFinal + 'px)' }],
                { duration: 600, easing: 'cubic-bezier(.55, 0, 1, .45)' }
            ).onfinish = function () {
                el.firstChild.style.transformOrigin = '50% 15%';
                el.firstChild.animate(
                    [{ transform: 'rotate(0)' }, { transform: 'rotate(7deg)' }, { transform: 'rotate(-5deg)' },
                     { transform: 'rotate(3deg)' }, { transform: 'rotate(-1.5deg)' }, { transform: 'rotate(0)' }],
                    { duration: 1300, easing: 'ease-out' });
            };
        }

        // Óculos: descem devagar (bem no estilo do meme), encaixam no rosto e o reflexo pisca
        function colocarOculos(largura, altura) {
            var w = largura * OCULOS.largura;
            var h = w * 7 / 32;
            var el = criarEnfeite(svgOculos(), w, h);
            el.style.zIndex = 9; // fica atrás da cereja e do guarda-chuva, que estão "na frente", dentro da taça

            var x = largura / 2 - w / 2;
            var yFinal = altura * OCULOS.topo;
            var yInicial = -h * 4;

            posicionar(el, x, yFinal, 0);
            el.animate(
                [
                    { transform: 'translate(' + x + 'px, ' + yInicial + 'px)' },
                    { transform: 'translate(' + x + 'px, ' + (yFinal + h * 0.12) + 'px)', offset: 0.88 },
                    { transform: 'translate(' + x + 'px, ' + yFinal + 'px)' }
                ],
                { duration: 1700, easing: 'linear' }
            ).onfinish = function () {
                el.querySelector('.reflexo-oculos').animate(
                    [{ opacity: 1 }, { opacity: 0 }, { opacity: 1 }, { opacity: 0 }, { opacity: 1 }],
                    { duration: 700, easing: 'steps(1, end)' });

                setTimeout(recolher, TEMPO_SERVIDO * 1000);
            };
        }

        function espirrar(x, y) {
            for (var i = 0; i < 5; i++) {
                var gota = document.createElement('span');
                gota.className = 'respingo';
                zona.appendChild(gota);

                var dx = (i - 2) * 9 + (Math.random() * 6 - 3);
                var dy = -(14 + Math.random() * 12);

                gota.animate(
                    [
                        { transform: 'translate(' + (x - 2) + 'px, ' + (y - 2) + 'px)', opacity: 1 },
                        { transform: 'translate(' + (x - 2 + dx) + 'px, ' + (y - 2 + dy) + 'px)', opacity: 1, offset: 0.5 },
                        { transform: 'translate(' + (x - 2 + dx * 1.4) + 'px, ' + (y + 6) + 'px)', opacity: 0 }
                    ],
                    { duration: 650, easing: 'ease-out', fill: 'forwards' });
            }
        }

        function recolher() {
            zona.querySelectorAll('.enfeite-drink, .respingo').forEach(function (el) {
                el.style.transition = 'opacity .6s';
                el.style.opacity = '0';
            });

            setTimeout(function () {
                zona.querySelectorAll('.enfeite-drink, .respingo').forEach(function (el) { el.remove(); });
                animando = false;
            }, 650);
        }
    })();

    // ===== Congelar a tela (5 cliques no gelo) =====
    // 1) A tela embaça e esfria, das bordas para o centro.
    // 2) Cristais de gelo "trincam" a partir das bordas e dos cantos.
    // 3) Um brilho passa pelo gelo, a tela fica congelada um instante e derrete.

    (function () {
        var CLIQUES = 5;
        var DURACAO_CONGELAR = 3.2;   // segundos até a tela terminar de embaçar
        var TEMPO_CONGELADO = 1.8;    // segundos parado, já congelado
        var TEMPO_DERRETER = 1.4;     // deve ser igual ao "transition" do #congelamento

        var badge = document.getElementById('ice-badge');
        var tela = document.getElementById('congelamento');
        if (!badge || !tela) return;

        var embacado = tela.querySelector('.congelamento-embacado');
        var canvas = tela.querySelector('.congelamento-cristais');
        var ctx = canvas.getContext('2d');

        var cliques = 0;
        var rodando = false;

        badge.addEventListener('click', function () {
            if (rodando) return;

            cliques++;

            if (cliques >= CLIQUES) {
                cliques = 0;
                congelar();
            }
        });

        function aleatorio(min, max) {
            return min + Math.random() * (max - min);
        }

        // Gera o gelo: cada cristal nasce numa borda e cresce para dentro como uma "pena",
        // com galhos alternados dos dois lados em ângulo de cristal (perto de 60 graus).
        function gerarCristais(largura, altura) {
            var trechos = [];
            var escala = Math.min(largura, altura);

            function galho(x, y, angulo, comprimento, espessura, inicio, geracao) {
                var velocidade = geracao === 0 ? aleatorio(110, 170) : aleatorio(80, 130);
                var passo = geracao === 0 ? 6 : 4;
                var percorrido = 0;
                var tempo = inicio;
                var lado = Math.random() < 0.5 ? -1 : 1;
                var contador = 0;

                while (percorrido < comprimento) {
                    angulo += aleatorio(-0.06, 0.06);

                    var nx = x + Math.cos(angulo) * passo;
                    var ny = y + Math.sin(angulo) * passo;
                    var restante = 1 - percorrido / comprimento;

                    tempo += passo / velocidade;

                    trechos.push({
                        x1: x, y1: y, x2: nx, y2: ny,
                        t: tempo,
                        largura: Math.max(0.5, espessura * (0.4 + 0.6 * restante)),
                        alfa: 0.4 + 0.5 * restante,
                        geracao: geracao
                    });

                    x = nx;
                    y = ny;
                    percorrido += passo;
                    contador++;

                    if (geracao < 2 && contador % (geracao === 0 ? 2 : 3) === 0) {
                        var tamanho = comprimento * (geracao === 0 ? 0.22 : 0.4) * (0.35 + 0.65 * restante) * aleatorio(0.7, 1.1);

                        galho(x, y, angulo + lado * aleatorio(0.95, 1.15), tamanho, espessura * 0.5, tempo, geracao + 1);
                        lado = -lado;
                    }
                }
            }

            // Bordas: perto dos cantos o gelo nasce antes e vai mais fundo
            var bordas = [
                { tamanho: largura, ponto: function (p) { return [p, 0]; }, angulo: Math.PI / 2 },
                { tamanho: largura, ponto: function (p) { return [p, altura]; }, angulo: -Math.PI / 2 },
                { tamanho: altura, ponto: function (p) { return [0, p]; }, angulo: 0 },
                { tamanho: altura, ponto: function (p) { return [largura, p]; }, angulo: Math.PI }
            ];

            bordas.forEach(function (borda) {
                for (var p = aleatorio(0, 40); p < borda.tamanho; p += aleatorio(35, 95)) {
                    var canto = Math.abs(p / borda.tamanho - 0.5) * 2; // 0 no meio da borda, 1 no canto
                    var xy = borda.ponto(p);

                    galho(xy[0], xy[1],
                        borda.angulo + aleatorio(-0.85, 0.85),
                        escala * aleatorio(0.05, 0.2) * (1 + 1.2 * canto * canto),
                        aleatorio(1.4, 2.2),
                        aleatorio(0, 0.4) + (1 - canto) * 0.9,
                        0);
                }
            });

            // Cantos: as rachaduras maiores, as primeiras a aparecer
            var cantos = [
                [0, 0, 0], [largura, 0, Math.PI / 2],
                [largura, altura, Math.PI], [0, altura, -Math.PI / 2]
            ];

            cantos.forEach(function (canto) {
                for (var i = 0; i < 4; i++) {
                    var direcao = canto[2] + (i + 0.5) * (Math.PI / 2) / 4 + aleatorio(-0.15, 0.15);
                    var recuo = aleatorio(0, 40);

                    galho(canto[0] + Math.cos(canto[2]) * recuo, canto[1] + Math.sin(canto[2]) * recuo,
                        direcao,
                        escala * aleatorio(0.32, 0.5),
                        aleatorio(2, 2.6),
                        aleatorio(0, 0.2),
                        0);
                }
            });

            trechos.sort(function (a, b) { return a.t - b.t; });
            return trechos;
        }

        // Mancha clara e suave que vai "esbranquiçando" a região em volta dos cristais
        var mancha = document.createElement('canvas');
        mancha.width = mancha.height = 64;
        (function () {
            var c = mancha.getContext('2d');
            var g = c.createRadialGradient(32, 32, 0, 32, 32, 32);
            g.addColorStop(0, 'rgba(225, 242, 255, 0.10)');
            g.addColorStop(1, 'rgba(225, 242, 255, 0)');
            c.fillStyle = g;
            c.fillRect(0, 0, 64, 64);
        })();

        function desenhar(trechos, desde, ate) {
            var i, s;

            // 1) Neblina de gelo em volta dos troncos principais
            for (i = desde; i < ate; i++) {
                s = trechos[i];
                if (s.geracao === 0) {
                    ctx.drawImage(mancha, s.x2 - 28, s.y2 - 28, 56, 56);
                }
            }

            // 2) Brilho azulado largo
            ctx.strokeStyle = 'rgba(150, 205, 255, 0.16)';
            for (i = desde; i < ate; i++) {
                s = trechos[i];
                ctx.lineWidth = s.largura * 3;
                ctx.beginPath();
                ctx.moveTo(s.x1, s.y1);
                ctx.lineTo(s.x2, s.y2);
                ctx.stroke();
            }

            // 3) O cristal branco por cima
            for (i = desde; i < ate; i++) {
                s = trechos[i];
                ctx.strokeStyle = 'rgba(242, 250, 255, ' + s.alfa + ')';
                ctx.lineWidth = s.largura;
                ctx.beginPath();
                ctx.moveTo(s.x1, s.y1);
                ctx.lineTo(s.x2, s.y2);
                ctx.stroke();
            }
        }

        // Embaçado e cor fria: fortes nas bordas, mais leves no centro
        function aplicarEmbacado(p) {
            var desfoque = (10 * p).toFixed(1);
            var centro = (0.65 * p).toFixed(2);
            var borda = Math.round(85 - 45 * p);

            embacado.style.backdropFilter = 'blur(' + desfoque + 'px) saturate(' + (1 - 0.45 * p).toFixed(2) + ') brightness(' + (1 + 0.12 * p).toFixed(2) + ')';
            embacado.style.webkitBackdropFilter = embacado.style.backdropFilter;

            embacado.style.background =
                'radial-gradient(ellipse at center, rgba(160, 210, 255, ' + (0.14 * p).toFixed(3) + ') 30%, rgba(200, 230, 255, ' + (0.3 * p).toFixed(3) + ') 65%, rgba(235, 247, 255, ' + (0.7 * p).toFixed(3) + ') 100%)';

            var mascara = 'radial-gradient(ellipse at center, rgba(0, 0, 0, ' + centro + ') 25%, #000 ' + borda + '%)';
            embacado.style.maskImage = mascara;
            embacado.style.webkitMaskImage = mascara;
        }

        function congelar() {
            rodando = true;

            var proporcao = Math.min(window.devicePixelRatio || 1, 2);
            var largura = window.innerWidth;
            var altura = window.innerHeight;

            canvas.width = largura * proporcao;
            canvas.height = altura * proporcao;
            ctx.setTransform(proporcao, 0, 0, proporcao, 0, 0);
            ctx.clearRect(0, 0, largura, altura);
            ctx.lineCap = 'round';

            var trechos = gerarCristais(largura, altura);
            var desenhados = 0;
            var comeco = null;

            aplicarEmbacado(0);
            tela.classList.remove('derretendo', 'brilhando');
            tela.classList.add('ativo');

            function quadro(agora) {
                if (comeco === null) comeco = agora;

                var segundos = (agora - comeco) / 1000;
                var p = Math.min(segundos / DURACAO_CONGELAR, 1);

                aplicarEmbacado(1 - Math.pow(1 - p, 2));

                var ate = desenhados;
                while (ate < trechos.length && trechos[ate].t <= segundos) ate++;

                desenhar(trechos, desenhados, ate);
                desenhados = ate;

                if (p < 1 || desenhados < trechos.length) {
                    requestAnimationFrame(quadro);
                } else {
                    congelado();
                }
            }

            requestAnimationFrame(quadro);
        }

        function congelado() {
            tela.classList.add('brilhando');

            setTimeout(function () {
                tela.classList.add('derretendo');

                setTimeout(function () {
                    tela.classList.remove('ativo', 'derretendo', 'brilhando');
                    ctx.clearRect(0, 0, canvas.width, canvas.height);
                    aplicarEmbacado(0);
                    rodando = false;
                }, TEMPO_DERRETER * 1000 + 100);
            }, TEMPO_CONGELADO * 1000);
        }
    })();
</script>
